<!--BlockML Definition — generic type parameter meta-model type

  FQN: org.blockml.bml.definition.GenericTypeDefinition
  See docs/16_framework_base_types.md — genericTypes · 12_bom_object_model.md — GenericType.-->
<def:GenericTypeDefinition xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Definition
  </baseType>
  <is>
    A generic type parameter
  </is>
  <documentation>
    Declares one generic type parameter on a root Block definition. Rendered inside
    the genericTypes container as an element whose local name is the parameter identifier (root
    block only). Maps to BOM GenericType { name, baseType, defaultType? } — name is derived from
    the XML element name, not from a child or attribute. The name is substituted in type references
    within this Block (e.g. type="T" → GenericParameterReference). baseType is the FQN constraint —
    each concrete type argument at reference sites (type applications and instance bml:generics)
    must inherit from that branch (BML_GENERIC_CONSTRAINT_VIOLATION on mismatch). Optional
    defaultType supplies the binding when a generic application or bml:generics omits the
    corresponding type argument: a concrete TypeExpression, or the name of an earlier sibling
    generic parameter (declaration-order only; cycles and forward references forbidden). Must
    satisfy baseType after resolution. See 17_type_system_bml.md — defaultType. Optional
    documentation on the entry describes the parameter itself (not the enclosing Block). Parameter
    name must differ from the Block name and every Sub-Block name.
  </documentation>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      Generics — inheritance binding, instance bml:generics, defaultType, attribute syntax.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Generic application as a type expression.
    </see>
    <see type="def:StructuralDefinition.Documentation" relation="Defines">
      Shared documentation prose shape — reused as an optional child of each genericTypes entry.
    </see>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      Markdown default, language=, facets — same content model as on StructuralDefinition.
    </see>
  </references>
  <properties>
    <name type="type:Text">
      <documentation>
        Parameter identifier — derived from the XML element name at parse time (e.g.
        &lt;T baseType="…"/> → name = "T"). Must not collide with the Block name or any
        Sub-Block name in the same document. Not authored as an attribute or child element.
      </documentation>
    </name>
    <baseType bml:xml="attribute" type="type:TypeReference(core:Block)">
      <documentation>
        FQN constraint for concrete type arguments. Each supplied type argument at
        reference sites (e.g. Box(Integer) or bml:generics="(type:Integer)") must inherit from this
        baseType branch.
      </documentation>
    </baseType>
    <defaultType bml:xml="attribute" type="type:TypeReference(core:Block)">
      <documentation>
        Optional default when a generic application or instance bml:generics omits
        this parameter's type argument. Either a concrete TypeExpression (FQN / configured type)
        that satisfies baseType,
        or the bare name of an earlier sibling generic parameter (e.g. defaultType="N"). Sibling
        references are declaration-order only — forward refs and cycles are errors
        (BML_GENERIC_DEFAULT_FORWARD_REF / BML_GENERIC_DEFAULT_CYCLE). After resolution the
        effective binding must satisfy baseType. Authored as the defaultType attribute on the
        genericTypes entry element (e.g. &lt;Q baseType="core:ValueType" defaultType="N"/>).
        See 17_type_system_bml.md — defaultType. Omitted when every reference site must supply an
        explicit type argument.
      </documentation>
    </defaultType>
    <documentation bml:xml="element" type="def:StructuralDefinition.Documentation">
      <documentation>
        Technical documentation prose for this generic type parameter — what the
        parameter means, which branch it constrains, and when a defaultType or a forwarded
        binding applies. Explain the parameter's role at reference sites (type application,
        baseType forwarding, instance bml:generics), not the enclosing Block's overall story.
        
        Optional. Omitted when name, baseType, and defaultType already make the role obvious —
        BML_MISSING_DOCUMENTATION does not apply to genericTypes entries. Does not replace the
        enclosing Block's required documentation, which may still mention the parameter when
        describing the type as a whole.
        
        Authored as a documentation child of the genericTypes entry element
        (&lt;T baseType="core:Block">&lt;documentation>…&lt;/documentation>&lt;/T>). Same
        org.blockml.bml.definition.StructuralDefinition.Documentation shape as on blocks and
        members: Markdown(English) by default; language= only for another natural language or
        Markdown(L); optional Annotation facets (e.g. scad:document). May repeat for i18n
        (language=) and facets. Duplicate (namespace, languageFqn) →
        BML_DUPLICATE_DOCUMENTATION. See doc:DocumentationModel.
        
        Addressable as com.foo.Bar.genericTypes.T.documentation (default NS + effective
        language). Lives on this GenericType entry — not in the enclosing Block's
        documentations[].
      </documentation>
    </documentation>
  </properties>
  <bml:xml>${ #this.name }</bml:xml>
</def:GenericTypeDefinition>
