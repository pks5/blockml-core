<!--BlockML Core — BML_VISIBILITY_ON_ROOT_BLOCK diagnostic

  FQN: org.blockml.bml.diagnostic.BML_VISIBILITY_ON_ROOT_BLOCK-->
<diag:BML_VISIBILITY_ON_ROOT_BLOCK xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A root-block visibility diagnostic
  </is>
  <summary>
    Emitted when a document-root Block declares root-level visibility — only Sub-Blocks may do so.
  </summary>
  <documentation>
    Root Blocks must not declare &lt;visibility>. Sub-Blocks inside &lt;subBlocks> may declare optional visibility matching their name prefix.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_VISIBILITY_ON_ROOT_BLOCK" />
  </keywords>
  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      Visibility is Sub-Block-only at root-level element.
    </see>
    <see type="doc:MemberVisibility" relation="SeeAlso">
      Member vs Sub-Block visibility.
    </see>
    <see type="howto:FixVisibilityAccess" relation="Resolves">
      Remove root visibility or move to Sub-Block.
    </see>
  </references>
</diag:BML_VISIBILITY_ON_ROOT_BLOCK>
