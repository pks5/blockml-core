<!--BlockML Core — BML_CONTRACT_NOT_ON_ROOT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONTRACT_NOT_ON_ROOT-->
<diag:BML_CONTRACT_NOT_ON_ROOT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A contract-not-on-root diagnostic
  </is>
  <summary>
    Emitted when &lt;contracts> is declared on a Sub-Block or non-root definition.
  </summary>
  <documentation>
    Emitted when &lt;contracts> is declared on a Sub-Block or non-root definition. Remedy:
    Contracts are root-block only.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_CONTRACT_NOT_ON_ROOT" />
  </keywords>
  <references>
    <see type="doc:ContractsModel" relation="AuthoringGuide">
      Root-only contracts.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Sub-Block limitations.
    </see>
  </references>
</diag:BML_CONTRACT_NOT_ON_ROOT>
