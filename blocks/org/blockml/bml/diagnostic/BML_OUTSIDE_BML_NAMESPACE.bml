<!--BlockML Core — BML_OUTSIDE_BML_NAMESPACE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_OUTSIDE_BML_NAMESPACE-->
<diag:BML_OUTSIDE_BML_NAMESPACE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An outside-bml-namespace diagnostic
  </is>
  <summary>
    Emitted when a BML definition FQN does not reside under the domain's bml package (domain.bml.*).
  </summary>
  <documentation>
    Emitted when a BML definition FQN does not reside under the domain's bml package (domain.bml.*).
    Remedy: Every BlockML definition must live under &lt;domain>.bml.* — e.g. org.blockml.bml.*,
    com.machineblocks.bml.*.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_OUTSIDE_BML_NAMESPACE" />
  </keywords>
  <references>
    <see type="doc:BmlNamespace" relation="AuthoringGuide">
      Mandatory domain.bml namespace.
    </see>
  </references>
</diag:BML_OUTSIDE_BML_NAMESPACE>
