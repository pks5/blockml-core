<!--BlockML Core — BML_CARDINALITY_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CARDINALITY_VIOLATION-->
<diag:BML_CARDINALITY_VIOLATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A cardinality-violation diagnostic
  </is>
  <summary>
    Emitted when an aggregation child count or association InstanceReference token count violates the type multiplicity.
  </summary>
  <documentation>
    Emitted when an aggregation child count or association InstanceReference token count violates
    the type multiplicity. Remedy: Adjust the number of aggregation children or association pointer
    tokens, or the member multiplicity. Association cardinality is limited to 0..1 and 0..n —
    required-single notations (1..1, 1..n) are invalid on associations.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_CARDINALITY_VIOLATION" />
  </keywords>
  <references>
    <see type="doc:TypeExpressions" relation="AuthoringGuide">
      Multiplicity.
    </see>
    <see type="doc:CompositionModel" relation="SeeAlso">
      Aggregation fill.
    </see>
    <see type="type:InstanceReference" relation="SeeAlso">
      Association payload — pointer tokens, not composition children.
    </see>
  </references>
</diag:BML_CARDINALITY_VIOLATION>
