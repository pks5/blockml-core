<!--BlockML Core — BML_UNEXPORTED_INSTANCE_REF diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNEXPORTED_INSTANCE_REF-->
<diag:BML_UNEXPORTED_INSTANCE_REF xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unexported-instance-ref diagnostic
  </is>
  <summary>
    Emitted when an instance id is referenced outside the aggregation visibility export rules.
  </summary>
  <documentation>
    Emitted when an instance id is referenced outside the aggregation visibility export rules.
    Remedy: Use a public aggregation for cross-document ids, or reference from an allowed scope.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_UNEXPORTED_INSTANCE_REF" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Instance ID reachability.
    </see>
    <see type="doc:CompositionModel" relation="SeeAlso">
      bml:id.
    </see>
  </references>
</diag:BML_UNEXPORTED_INSTANCE_REF>
