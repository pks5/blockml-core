<!--BlockML Core — BML_EXPR_PAYLOAD_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_PAYLOAD_MISMATCH-->
<diag:BML_EXPR_PAYLOAD_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An expression payload-mismatch diagnostic
  </is>
  <summary>
    Emitted when call syntax does not match declared inputType after FunctionMapping.
  </summary>
  <documentation>
    Emitted when call syntax does not match declared inputType after FunctionMapping. Remedy:
    Adjust positional/named/object-literal arguments to the Capability inputType shape.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_EXPR_PAYLOAD_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Call forms and mapping.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix call payload.
    </see>
  </references>
</diag:BML_EXPR_PAYLOAD_MISMATCH>
