<!--BlockML Core — BML_REFERENCE_UNKNOWN_MEMBER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REFERENCE_UNKNOWN_MEMBER-->
<diag:BML_REFERENCE_UNKNOWN_MEMBER xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-reference-member diagnostic
  </is>
  <summary>
    Emitted when a see member path (property/aggregation/…) cannot be resolved.
  </summary>
  <documentation>
    Emitted when a see member path (property/aggregation/…) cannot be resolved. Remedy: Fix the
    canonical member path or owning type.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_REFERENCE_UNKNOWN_MEMBER" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      member path targets.
    </see>
    <see type="howto:DebugUnknownType" relation="SeeAlso">
      Related unresolved refs.
    </see>
  </references>
</diag:BML_REFERENCE_UNKNOWN_MEMBER>
