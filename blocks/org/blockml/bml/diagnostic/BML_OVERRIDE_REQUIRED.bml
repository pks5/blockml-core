<!--BlockML Core — BML_OVERRIDE_REQUIRED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_OVERRIDE_REQUIRED-->
<diag:BML_OVERRIDE_REQUIRED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An override-required diagnostic
  </is>
  <summary>
    Emitted when a local member redeclaration merges with a baseType or contracts member without override="true".
  </summary>
  <documentation>
    Every redeclaration layer that merges with an inherited or contract member must set override="true" again — including contract completion. Override is not inherited.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_OVERRIDE_REQUIRED" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      override="true" required on merge.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      Contract member completion.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Add override="true" or rename as a new member.
    </see>
  </references>
</diag:BML_OVERRIDE_REQUIRED>
