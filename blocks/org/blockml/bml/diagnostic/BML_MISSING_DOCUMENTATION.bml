<!--BlockML Core — BML_MISSING_DOCUMENTATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_DOCUMENTATION-->
<diag:BML_MISSING_DOCUMENTATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-documentation diagnostic
  </is>
  <summary>
    Emitted when a Block definition omits required default-namespace documentation.
  </summary>
  <documentation>
    Emitted when a Block definition omits required default-namespace documentation. Remedy: Every
    Block definition (root and Sub-Blocks) requires ≥1 default-namespace documentation entry.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_MISSING_DOCUMENTATION" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      Required documentation model.
    </see>
  </references>
</diag:BML_MISSING_DOCUMENTATION>
