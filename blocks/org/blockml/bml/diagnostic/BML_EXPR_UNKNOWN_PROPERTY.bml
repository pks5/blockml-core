<!--BlockML Core — BML_EXPR_UNKNOWN_PROPERTY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_UNKNOWN_PROPERTY-->
<diag:BML_EXPR_UNKNOWN_PROPERTY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-property-in-expression diagnostic
  </is>
  <summary>
    Emitted when an identifier is not found in scope, or index access is used on a StructType field.
  </summary>
  <documentation>
    Emitted when an identifier is not found in scope, or index access is used on a StructType
    field. Remedy: Property access is the outer Block instance (#this). this without # is a
    member (#this.this), not the instance. StructType members are addressed by name (size.x),
    not size[0]. See doc:Expressions.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_EXPR_UNKNOWN_PROPERTY" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Property access and scope rules.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Correct property path or scope.
    </see>
  </references>
</diag:BML_EXPR_UNKNOWN_PROPERTY>
