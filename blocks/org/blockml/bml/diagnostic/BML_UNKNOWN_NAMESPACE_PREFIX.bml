<!--BlockML Core — BML_UNKNOWN_NAMESPACE_PREFIX diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_NAMESPACE_PREFIX-->
<diag:BML_UNKNOWN_NAMESPACE_PREFIX xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-namespace-prefix diagnostic
  </is>
  <summary>
    Emitted when a QName uses an xmlns prefix that is not declared on the document.
  </summary>
  <documentation>
    Declare xmlns:prefix for Packages (type addressing) or Annotations (directives/facets). Prefixes are authoring aliases — BOM stores canonical FQNs/namespaces.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_UNKNOWN_NAMESPACE_PREFIX" />
  </keywords>
  <references>
    <see type="doc:BmlNamespace" relation="AuthoringGuide">
      xmlns Package vs Annotation.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      QName type reference form.
    </see>
    <see type="howto:DebugUnknownType" relation="Resolves">
      Related unknown-type debugging steps.
    </see>
  </references>
</diag:BML_UNKNOWN_NAMESPACE_PREFIX>
