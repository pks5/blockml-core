<!--BlockML Core — BML_PREFER_TYPE_CONFIGURATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PREFER_TYPE_CONFIGURATION-->
<diag:BML_PREFER_TYPE_CONFIGURATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A prefer-type-configuration diagnostic
  </is>
  <summary>
    Warning: prefer ValueType {...} configuration over equivalent Constraints for type-intrinsic thresholds.
  </summary>
  <documentation>
    Warning: prefer ValueType {...} configuration over equivalent Constraints for type-intrinsic
    thresholds. E.g. Text{maxLength: 100} instead of MaxLength constraint when intrinsic.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PREFER_TYPE_CONFIGURATION" />
  </keywords>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      What belongs where.
    </see>
    <see type="doc:ConstraintsModel" relation="SeeAlso">
      Constraints vs configuration.
    </see>
  </references>
</diag:BML_PREFER_TYPE_CONFIGURATION>
