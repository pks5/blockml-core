<!--BlockML Core — BML_GENERIC_CONSTRAINT_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERIC_CONSTRAINT_VIOLATION-->
<diag:BML_GENERIC_CONSTRAINT_VIOLATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A generic constraint-violation diagnostic
  </is>
  <summary>
    Emitted when a type argument or defaultType fails the parameter's baseType via satisfiesTypeBound.
  </summary>
  <documentation>
    Emitted when a type argument or defaultType fails the parameter's baseType via
    satisfiesTypeBound — including arguments authored in a type application and in instance
    bml:generics. Remedy: Union arguments must satisfy the bound per alternative.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_GENERIC_CONSTRAINT_VIOLATION" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      satisfiesTypeBound on generic arguments.
    </see>
    <see type="doc:ContractsModel" relation="SeeAlso">
      satisfiesTypeBound definition.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Union arguments in generics.
    </see>
  </references>
</diag:BML_GENERIC_CONSTRAINT_VIOLATION>
