<!--BlockML Core — BML_SUBBLOCK_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_SUBBLOCK_TYPE_MISMATCH-->
<diag:BML_SUBBLOCK_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A Sub-Block type-mismatch diagnostic
  </is>
  <summary>
    Emitted when an explicit Sub-Block type does not equal resolve(parent.type) + "." + name.
  </summary>
  <documentation>
    Emitted when an explicit Sub-Block type does not equal resolve(parent.type) + "."
    + name. Remedy: The validator checks the full expected type from the immediate enclosing
    block — not the last segment alone.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_SUBBLOCK_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Sub-Block expectedType derivation.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Omit type or match parent-qualified expected type.
    </see>
  </references>
</diag:BML_SUBBLOCK_TYPE_MISMATCH>
