<!--
  BlockML Core — BML_UNRESOLVABLE_INSTANCE_REF diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNRESOLVABLE_INSTANCE_REF
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_UNRESOLVABLE_INSTANCE_REF</name>
  <type>diag:BML_UNRESOLVABLE_INSTANCE_REF</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unresolvable-instance-ref diagnostic</is>

  <summary>Emitted when an InstanceReference cannot be resolved to an instance id in scope.</summary>

  <keywords>BML_UNRESOLVABLE_INSTANCE_REF</keywords>

  <documentation>
    The validator keys off the declared ValueType of the field, not the field name. Emitted when
    a value whose type is InstanceReference cannot be resolved to an instance id in scope.
    InstanceIdentifier (and not InstanceReference) is syntax-only — an unknown but well-formed
    id is valid. Unresolved is an error, not proof the document is ill-formed — the instance
    may live in a document or library that is not currently loaded. Remedy: Fix bml:id,
    aggregation visibility, the reference path, or the load set.
  </documentation>

  <references>
    <see type="type:InstanceReference" relation="Defines">
      Existence-checked instance pointer — this diagnostic applies here.
    </see>
    <see type="type:InstanceIdentifier" relation="ContrastsWith">
      Syntax-only instance name — unknown id is valid.
    </see>
    <see type="doc:CompositionModel" relation="AuthoringGuide">
      Instance references.
    </see>
    <see type="doc:MemberVisibility" relation="SeeAlso">
      ID reachability.
    </see>
  </references>

</block>
