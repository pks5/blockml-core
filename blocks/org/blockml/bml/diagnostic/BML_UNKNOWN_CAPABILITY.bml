<!--BlockML Core — BML_UNKNOWN_CAPABILITY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_CAPABILITY-->
<diag:BML_UNKNOWN_CAPABILITY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-capability diagnostic
  </is>
  <summary>
    Emitted when a Capability reference cannot be resolved on the target Block.
  </summary>
  <documentation>
    Emitted when a Capability reference cannot be resolved on the target Block. Remedy: Check
    Capability name and inheritance/contract merge.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_UNKNOWN_CAPABILITY" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      Capabilities.
    </see>
    <see type="howto:DebugUnknownType" relation="SeeAlso">
      Registry resolution.
    </see>
  </references>
</diag:BML_UNKNOWN_CAPABILITY>
