<!--BlockML Core — BML_STANDALONE_COMPOSITION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_STANDALONE_COMPOSITION-->
<diag:BML_STANDALONE_COMPOSITION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A standalone-composition diagnostic
  </is>
  <summary>
    Emitted when &lt;composition> appears outside an aggregation member element.
  </summary>
  <documentation>
    &lt;composition> must always be nested inside an aggregation member on Block definitions. On instances, open aggregations directly without a composition wrapper. Do not use &lt;value> as a parallel wrapper on instance Properties — both are definition fields (doc:MemberAuthoring).
  </documentation>
  <keywords>
    <meta:Keyword value="BML_STANDALONE_COMPOSITION" />
  </keywords>
  <references>
    <see type="doc:MemberAuthoring" relation="AuthoringGuide">
      Definition vs instance member syntax — composition and value are declaration fields only.
    </see>
    <see type="doc:CompositionModel" relation="AuthoringGuide">
      Placement rules for composition.
    </see>
    <see type="howto:FixCompositionPlacement" relation="Resolves">
      Nest composition under an aggregation member.
    </see>
  </references>
</diag:BML_STANDALONE_COMPOSITION>
