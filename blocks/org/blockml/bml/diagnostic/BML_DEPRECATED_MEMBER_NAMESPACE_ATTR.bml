<!--BlockML Core — BML_DEPRECATED_MEMBER_NAMESPACE_ATTR diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DEPRECATED_MEMBER_NAMESPACE_ATTR-->
<diag:BML_DEPRECATED_MEMBER_NAMESPACE_ATTR xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A deprecated namespace-attribute diagnostic
  </is>
  <summary>
    Emitted when a legacy namespace= attribute appears on a member element.
  </summary>
  <documentation>
    Emitted when a legacy namespace= attribute appears on a member element. Remedy: Use XML element
    QName / xmlns prefixes for member namespaces — no namespace attribute.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DEPRECATED_MEMBER_NAMESPACE_ATTR" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="SeeAlso">
      Member identity.
    </see>
    <see type="doc:BmlNamespace" relation="AuthoringGuide">
      xmlns conventions.
    </see>
  </references>
</diag:BML_DEPRECATED_MEMBER_NAMESPACE_ATTR>
