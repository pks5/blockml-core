<!--BlockML Core — BML_VISIBILITY_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_VISIBILITY_MISMATCH-->
<diag:BML_VISIBILITY_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A visibility mismatch diagnostic
  </is>
  <summary>
    Emitted when an explicit visibility property does not match the naming-convention prefix on the name.
  </summary>
  <documentation>
    Optional visibility on members and Sub-Blocks must agree with public / _protected / __private naming. When omitted, visibility is derived from the name.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_VISIBILITY_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Optional visibility must match name.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Sub-Block root-level visibility.
    </see>
    <see type="howto:FixVisibilityAccess" relation="Resolves">
      Align visibility attribute with name prefix.
    </see>
  </references>
</diag:BML_VISIBILITY_MISMATCH>
