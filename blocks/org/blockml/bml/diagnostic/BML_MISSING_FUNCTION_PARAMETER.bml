<!--BlockML Core — BML_MISSING_FUNCTION_PARAMETER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_FUNCTION_PARAMETER-->
<diag:BML_MISSING_FUNCTION_PARAMETER xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing function-parameter diagnostic
  </is>
  <summary>
    Emitted when a required inputType field is absent after FunctionMapping.
  </summary>
  <documentation>
    Emitted when a required inputType field is absent after FunctionMapping. Remedy: Supply the
    missing positional or named argument, or an object literal with all required fields.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_FUNCTION_PARAMETER" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Default mapping arity rules.
    </see>
  </references>
</diag:BML_MISSING_FUNCTION_PARAMETER>
