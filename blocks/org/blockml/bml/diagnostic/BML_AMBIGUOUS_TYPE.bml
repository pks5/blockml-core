<!--BlockML Core — BML_AMBIGUOUS_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_AMBIGUOUS_TYPE-->
<diag:BML_AMBIGUOUS_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An ambiguous-type diagnostic
  </is>
  <summary>
    Emitted when an unqualified type name matches more than one candidate in nested or context-bound resolution.
  </summary>
  <documentation>
    Emitted when an unqualified type name matches more than one candidate in nested or context-bound
    resolution. Remedy: Qualify with xmlns QName, FQN, or Sub-Block-relative path. Grandchildren
    are never unqualified.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_AMBIGUOUS_TYPE" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Unqualified nested resolution.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      Context-bound sites.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Disambiguate the type reference.
    </see>
  </references>
</diag:BML_AMBIGUOUS_TYPE>
