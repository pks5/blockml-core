<!--BlockML Core — BML_DEFINITION_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DEFINITION_TYPE_MISMATCH-->
<diag:BML_DEFINITION_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A definition-role mismatch diagnostic
  </is>
  <summary>
    Emitted when the definition meta-model type is incompatible with the block role (root / Sub-Block / embedded).
  </summary>
  <documentation>
    Defaults: RootBlockDefinition, SubBlockDefinition, EmbeddedBlockDefinition. Unqualified names resolve via org.blockml.bml.definition.*.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_DEFINITION_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      definition property by role.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Root vs Sub vs Embedded distinction.
    </see>
    <see type="doc:DefinitionModel" relation="SeeAlso">
      Definition branch overview.
    </see>
  </references>
</diag:BML_DEFINITION_TYPE_MISMATCH>
