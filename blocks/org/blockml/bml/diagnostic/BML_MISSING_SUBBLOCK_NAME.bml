<!--BlockML Core — BML_MISSING_SUBBLOCK_NAME diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_SUBBLOCK_NAME-->
<diag:BML_MISSING_SUBBLOCK_NAME xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing Sub-Block-name diagnostic
  </is>
  <summary>
    Emitted when a Sub-Block supplies neither a name element tag nor a name child.
  </summary>
  <documentation>
    Name is required as local identity. Preferred authoring: the element local name under
    &lt;subBlocks> is the Sub-Block name. Legacy: child &lt;name> under a &lt;block>
    wrapper (doc:DocumentFormat). Type is normally derived.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_MISSING_SUBBLOCK_NAME" />
  </keywords>
  <references>
    <see type="doc:DocumentFormat" relation="AuthoringGuide">
      Unqualified name tag under &lt;subBlocks>.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Sub-Block identity.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Sub-Block format.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Add Sub-Block name.
    </see>
  </references>
</diag:BML_MISSING_SUBBLOCK_NAME>
