<!--BlockML Core — BML_EXPR_LINK_INVALID_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_LINK_INVALID_TARGET-->
<diag:BML_EXPR_LINK_INVALID_TARGET xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid capability-link target diagnostic
  </is>
  <summary>
    Emitted when capability linking targets a Capability that is not Inbound.
  </summary>
  <documentation>
    Emitted when capability linking targets a Capability that is not Inbound. Remedy: Link targets
    must be Inbound (or compatible Transformation pairing rules).
  </documentation>
  <keywords>
    <meta:Keyword value="BML_EXPR_LINK_INVALID_TARGET" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      Inbound capabilities.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Link to an Inbound target.
    </see>
  </references>
</diag:BML_EXPR_LINK_INVALID_TARGET>
