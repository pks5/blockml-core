<!--BlockML Core — BML_CONSTRAINT_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_VIOLATION-->
<diag:BML_CONSTRAINT_VIOLATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-violation diagnostic
  </is>
  <summary>
    Emitted when a constraint fails with validation=Error.
  </summary>
  <documentation>
    Emitted when a constraint fails with validation=Error. Remedy: Change the authored value
    or relax/remove the constraint.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_CONSTRAINT_VIOLATION" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Error severity.
    </see>
    <see type="howto:AddConstraint" relation="Resolves">
      Resolve the failing constraint.
    </see>
  </references>
</diag:BML_CONSTRAINT_VIOLATION>
