<!--BlockML Core — BML_EXPR_MODEL_NO_CONTEXT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_MODEL_NO_CONTEXT-->
<diag:BML_EXPR_MODEL_NO_CONTEXT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A model-binding-without-context diagnostic
  </is>
  <summary>
    Emitted when a relative @model: path is used without a binding context.
  </summary>
  <documentation>
    Emitted when a relative @model: path is used without a binding context. Remedy: Absolute
    paths start with /. Relative paths require a nearest parent Model-bound Aggregation. V1 defers
    model runtime.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_EXPR_MODEL_NO_CONTEXT" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Model binding scope.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Provide binding context or use an absolute path.
    </see>
  </references>
</diag:BML_EXPR_MODEL_NO_CONTEXT>
