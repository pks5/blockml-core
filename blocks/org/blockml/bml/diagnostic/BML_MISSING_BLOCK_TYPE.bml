<!--BlockML Core — BML_MISSING_BLOCK_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_BLOCK_TYPE-->
<diag:BML_MISSING_BLOCK_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing root-type diagnostic
  </is>
  <summary>
    Emitted when the document-root Block supplies neither a type root tag nor a
    type element.
  </summary>
  <documentation>
    On root blocks, type is the canonical identity. Preferred authoring: the document root tag
    is the type. Legacy: child &lt;type> under a &lt;block> root (doc:DocumentFormat).
    name is optional and must match lastSegment(resolve(type)) when present.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_BLOCK_TYPE" />
  </keywords>
  <references>
    <see type="doc:DocumentFormat" relation="AuthoringGuide">
      Root tag or child &lt;type> supplies identity.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Root Block identity.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Add or correct root type.
    </see>
  </references>
</diag:BML_MISSING_BLOCK_TYPE>
