<!--BlockML Core — BML_UNKNOWN_FUNCTION_PARAMETER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_FUNCTION_PARAMETER-->
<diag:BML_UNKNOWN_FUNCTION_PARAMETER xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown function-parameter diagnostic
  </is>
  <summary>
    Emitted when a named call argument is not a field of the Capability inputType.
  </summary>
  <documentation>
    Emitted when a named call argument is not a field of the Capability inputType. Remedy: Named
    keys must match StructType / anonymous struct field names.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_UNKNOWN_FUNCTION_PARAMETER" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Named call form.
    </see>
  </references>
</diag:BML_UNKNOWN_FUNCTION_PARAMETER>
