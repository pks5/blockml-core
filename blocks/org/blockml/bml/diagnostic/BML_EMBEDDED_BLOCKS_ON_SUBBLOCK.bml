<!--BlockML Core — BML_EMBEDDED_BLOCKS_ON_SUBBLOCK diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EMBEDDED_BLOCKS_ON_SUBBLOCK-->
<diag:BML_EMBEDDED_BLOCKS_ON_SUBBLOCK xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An embeddedBlocks-on-Sub-Block diagnostic
  </is>
  <summary>
    Emitted when a Sub-Block declares embeddedBlocks — only the document root may own that aggregation.
  </summary>
  <documentation>
    Emitted when a Sub-Block declares embeddedBlocks — only the document root may own that aggregation.
    Remedy: Sub-Blocks may nest subBlocks but must not declare embeddedBlocks. Flat root embeddedBlocks
    compose fat artifacts.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_EMBEDDED_BLOCKS_ON_SUBBLOCK" />
  </keywords>
  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      Embedded Blocks root-only.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Move embeds to the document root.
    </see>
  </references>
</diag:BML_EMBEDDED_BLOCKS_ON_SUBBLOCK>
