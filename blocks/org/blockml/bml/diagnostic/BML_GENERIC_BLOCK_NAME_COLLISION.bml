<!--BlockML Core — BML_GENERIC_BLOCK_NAME_COLLISION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERIC_BLOCK_NAME_COLLISION-->
<diag:BML_GENERIC_BLOCK_NAME_COLLISION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A generic/block-name collision diagnostic
  </is>
  <summary>
    Emitted when a genericTypes parameter name equals the declaring Block's name.
  </summary>
  <documentation>
    Emitted when a genericTypes parameter name equals the declaring Block's name. Remedy: On
    the same declaring Block, generic parameter names must not collide with the Block name or
    a direct Sub-Block name.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_GENERIC_BLOCK_NAME_COLLISION" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Nested resolution and collision errors.
    </see>
    <see type="doc:TypeSystemOverview" relation="SeeAlso">
      Generics overview.
    </see>
  </references>
</diag:BML_GENERIC_BLOCK_NAME_COLLISION>
