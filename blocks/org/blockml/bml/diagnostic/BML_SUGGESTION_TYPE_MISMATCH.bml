<!--BlockML Core — BML_SUGGESTION_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_SUGGESTION_TYPE_MISMATCH-->
<diag:BML_SUGGESTION_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A suggestion-type-mismatch diagnostic
  </is>
  <summary>
    Emitted when a suggestion instance is incompatible with the property type.
  </summary>
  <documentation>
    Emitted when a suggestion instance is incompatible with the property type. Remedy: Use compatible
    ValueType/Entity instances; primitives need matching *Entity wrappers.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_SUGGESTION_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Suggestion compatibility.
    </see>
    <see type="def:PropertyDefinition" relation="Defines">
      suggestions.
    </see>
  </references>
</diag:BML_SUGGESTION_TYPE_MISMATCH>
