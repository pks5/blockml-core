<!--BlockML Core — BML_INVALID_PROPERTY_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_PROPERTY_TYPE-->
<diag:BML_INVALID_PROPERTY_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid property-type diagnostic
  </is>
  <summary>
    Emitted when a Property or Capability payload type does not resolve to a ValueType branch.
  </summary>
  <documentation>
    Bare type sites (Property type, Capability inputType/outputType) require ValueTypes. Aggregation type may be any Block FQN. Association type must be InstanceReference(T) or InstanceReference(T)[].
  </documentation>
  <keywords>
    <meta:Keyword value="BML_INVALID_PROPERTY_TYPE" />
  </keywords>
  <references>
    <see type="doc:TypeExpressions" relation="AuthoringGuide">
      Where ValueTypes are required.
    </see>
    <see type="doc:TypeSystemOverview" relation="SeeAlso">
      Four ValueType kinds.
    </see>
    <see type="type:InstanceReference" relation="SeeAlso">
      Association member types — InstanceReference(T) or InstanceReference(T)[].
    </see>
  </references>
</diag:BML_INVALID_PROPERTY_TYPE>
