<!--BlockML Core — BML_MISSING_ID diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_ID-->
<diag:BML_MISSING_ID xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-instance-id diagnostic
  </is>
  <summary>
    Emitted when bml:id is required (referenced instance or bml:each) but absent.
  </summary>
  <documentation>
    Emitted when bml:id is required (referenced instance or bml:each) but absent. Remedy: Add
    bml:id (literal or expression).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_ID" />
  </keywords>
  <references>
    <see type="doc:CompositionModel" relation="AuthoringGuide">
      Instance identity.
    </see>
    <see type="doc:BmlDirectives" relation="SeeAlso">
      bml:id / each.
    </see>
  </references>
</diag:BML_MISSING_ID>
