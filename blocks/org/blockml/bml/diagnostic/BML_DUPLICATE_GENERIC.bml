<!--BlockML Core — BML_DUPLICATE_GENERIC diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_GENERIC-->
<diag:BML_DUPLICATE_GENERIC xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-generic-parameter diagnostic
  </is>
  <summary>
    Emitted when two genericTypes entries share the same parameter name.
  </summary>
  <documentation>
    Emitted when two genericTypes entries share the same parameter name. Remedy: Rename one parameter.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DUPLICATE_GENERIC" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      genericTypes declarations.
    </see>
  </references>
</diag:BML_DUPLICATE_GENERIC>
