<!--BlockML Core — BML_IMPLEMENTATION_UNKNOWN_LANGUAGE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_IMPLEMENTATION_UNKNOWN_LANGUAGE-->
<diag:BML_IMPLEMENTATION_UNKNOWN_LANGUAGE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-implementation-language diagnostic
  </is>
  <summary>
    Emitted when implementation language= does not resolve to org.blockml.bml.language.*.
  </summary>
  <documentation>
    Emitted when implementation language= does not resolve to org.blockml.bml.language.*. Remedy:
    Use a Language FQN or unqualified name at the language attribute site.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_IMPLEMENTATION_UNKNOWN_LANGUAGE" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      implementation language.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      language implicit NS.
    </see>
  </references>
</diag:BML_IMPLEMENTATION_UNKNOWN_LANGUAGE>
