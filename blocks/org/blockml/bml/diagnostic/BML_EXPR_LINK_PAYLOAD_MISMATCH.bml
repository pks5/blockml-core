<!--BlockML Core — BML_EXPR_LINK_PAYLOAD_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_LINK_PAYLOAD_MISMATCH-->
<diag:BML_EXPR_LINK_PAYLOAD_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A capability-link payload-mismatch diagnostic
  </is>
  <summary>
    Emitted when linked Capabilities have incompatible inputType/outputType.
  </summary>
  <documentation>
    Emitted when linked Capabilities have incompatible inputType/outputType. Remedy: Ensure linked
    Outbound/Inbound (or Transformation) payloads are compatible.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_EXPR_LINK_PAYLOAD_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      Capability surface.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Align linked payload types.
    </see>
  </references>
</diag:BML_EXPR_LINK_PAYLOAD_MISMATCH>
