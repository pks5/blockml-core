<!--BlockML Core — BML_EXPR_LINK_INVALID_SOURCE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_LINK_INVALID_SOURCE-->
<diag:BML_EXPR_LINK_INVALID_SOURCE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid capability-link source diagnostic
  </is>
  <summary>
    Emitted when @bean.capa (no parentheses) is used on a non-Outbound Capability.
  </summary>
  <documentation>
    Emitted when @bean.capa (no parentheses) is used on a non-Outbound Capability. Remedy: Capability
    linking without call parentheses requires an Outbound source.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_EXPR_LINK_INVALID_SOURCE" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Call vs link.
    </see>
    <see type="doc:CapabilitySemantics" relation="SeeAlso">
      Outbound capabilities.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Use Outbound source or a call form.
    </see>
  </references>
</diag:BML_EXPR_LINK_INVALID_SOURCE>
