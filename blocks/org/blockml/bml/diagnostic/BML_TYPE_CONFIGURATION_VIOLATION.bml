<!--BlockML Core — BML_TYPE_CONFIGURATION_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TYPE_CONFIGURATION_VIOLATION-->
<diag:BML_TYPE_CONFIGURATION_VIOLATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A type-configuration value diagnostic
  </is>
  <summary>
    Emitted when a {...} configuration value does not satisfy the configuration Property's type.
  </summary>
  <documentation>
    Emitted when a {...} configuration value does not satisfy the configuration Property's type.
    Remedy: Configured instances are checked against the configured type — not bare ValueType
    defaults.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_TYPE_CONFIGURATION_VIOLATION" />
  </keywords>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      Semantic model for configured ValueType instances.
    </see>
  </references>
</diag:BML_TYPE_CONFIGURATION_VIOLATION>
