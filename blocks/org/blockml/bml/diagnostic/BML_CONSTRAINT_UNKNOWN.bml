<!--BlockML Core — BML_CONSTRAINT_UNKNOWN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_UNKNOWN-->
<diag:BML_CONSTRAINT_UNKNOWN xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-constraint diagnostic
  </is>
  <summary>
    Emitted when a constraint type is not in TypeRegistry or not a Constraint subtype.
  </summary>
  <documentation>
    Emitted when a constraint type is not in TypeRegistry or not a Constraint subtype. Remedy:
    Export the constraint via Library.blocks and use a valid Constraint FQN.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_CONSTRAINT_UNKNOWN" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Constraint catalogue.
    </see>
    <see type="howto:DebugUnknownType" relation="Resolves">
      Related type-registry debugging.
    </see>
  </references>
</diag:BML_CONSTRAINT_UNKNOWN>
