<!--BlockML Core — BML_INVALID_DEFINITION_BRANCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_DEFINITION_BRANCH-->
<diag:BML_INVALID_DEFINITION_BRANCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-definition-branch diagnostic
  </is>
  <summary>
    Emitted when a definition meta-model type is used outside the Definition branch expectations.
  </summary>
  <documentation>
    Emitted when a definition meta-model type is used outside the Definition branch expectations.
    Remedy: Use Root/Sub/Embedded/Member definition types appropriately.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_INVALID_DEFINITION_BRANCH" />
  </keywords>
  <references>
    <see type="doc:DefinitionModel" relation="AuthoringGuide">
      Definition branch.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      definition property.
    </see>
  </references>
</diag:BML_INVALID_DEFINITION_BRANCH>
