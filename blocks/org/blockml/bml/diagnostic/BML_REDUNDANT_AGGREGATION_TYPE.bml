<!--BlockML Core — BML_REDUNDANT_AGGREGATION_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REDUNDANT_AGGREGATION_TYPE-->
<diag:BML_REDUNDANT_AGGREGATION_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A redundant aggregation-type diagnostic
  </is>
  <summary>
    Warning (V1): restating an identical type on an inherited aggregation override that only fills composition/metadata.
  </summary>
  <documentation>
    Omit unchanged type on aggregation overrides. Declare type only when refining or replacing the inherited type. Authored redundant type is ignored.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_REDUNDANT_AGGREGATION_TYPE" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      Omit unchanged type on overrides.
    </see>
    <see type="doc:CompositionModel" relation="SeeAlso">
      Inherited aggregation fill.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Drop redundant type attribute.
    </see>
  </references>
</diag:BML_REDUNDANT_AGGREGATION_TYPE>
