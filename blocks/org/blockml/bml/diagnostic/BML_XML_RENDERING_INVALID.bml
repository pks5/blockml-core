<!--BlockML Core — BML_XML_RENDERING_INVALID diagnostic

  FQN: org.blockml.bml.diagnostic.BML_XML_RENDERING_INVALID-->
<diag:BML_XML_RENDERING_INVALID xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid bml:xml-recipe diagnostic
  </is>
  <summary>
    Emitted when a &lt;bml:xml> body is not a literal local name, ${ bml:Self }, or ${ #this.name }.
  </summary>
  <documentation>
    In this context ${ … } forms are fixed tag recipes, not open Expression Language. Other roots, calls, or operators are invalid.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_XML_RENDERING_INVALID" />
  </keywords>
  <references>
    <see type="doc:BmlDirectives" relation="AuthoringGuide">
      Allowed bml:xml recipes.
    </see>
  </references>
</diag:BML_XML_RENDERING_INVALID>
