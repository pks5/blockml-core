<!--BlockML Core — BML_BLOCK_NAME_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_BLOCK_NAME_TYPE_MISMATCH-->
<diag:BML_BLOCK_NAME_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A name/type mismatch diagnostic
  </is>
  <summary>
    Emitted when an explicit root name does not equal lastSegment(resolve(type)).
  </summary>
  <documentation>
    Emitted when an explicit root name does not equal lastSegment(resolve(type)). Remedy: Root
    design principle: type is canonical; name is a redundant short form of the last type segment.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_BLOCK_NAME_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Root name vs type rule.
    </see>
    <see type="doc:BlockNameConvention" relation="SeeAlso">
      PascalCase name format.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Align name with type last segment.
    </see>
  </references>
</diag:BML_BLOCK_NAME_TYPE_MISMATCH>
