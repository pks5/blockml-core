<!--BlockML Core — BML_NON_STATIC_INSTANCE_REF diagnostic

  FQN: org.blockml.bml.diagnostic.BML_NON_STATIC_INSTANCE_REF-->
<diag:BML_NON_STATIC_INSTANCE_REF xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A non-static-instance-ref diagnostic
  </is>
  <summary>
    Emitted when a qualified instance reference requires a static literal bml:id but got a dynamic id.
  </summary>
  <documentation>
    Emitted when a qualified instance reference requires a static literal bml:id but got a dynamic
    id. Remedy: Use a literal static bml:id for cross-document {FQN}::{id} references.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_NON_STATIC_INSTANCE_REF" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Composition instance ID reachability.
    </see>
    <see type="doc:CompositionModel" relation="SeeAlso">
      bml:id rules.
    </see>
  </references>
</diag:BML_NON_STATIC_INSTANCE_REF>
