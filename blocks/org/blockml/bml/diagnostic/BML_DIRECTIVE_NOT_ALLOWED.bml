<!--BlockML Core — BML_DIRECTIVE_NOT_ALLOWED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DIRECTIVE_NOT_ALLOWED-->
<diag:BML_DIRECTIVE_NOT_ALLOWED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A directive-not-allowed diagnostic
  </is>
  <summary>
    Emitted when a bml: directive appears on an element where it is not permitted.
  </summary>
  <documentation>
    Emitted when a bml: directive appears on an element where it is not permitted. Remedy: See
    placement rules for each directive.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_DIRECTIVE_NOT_ALLOWED" />
  </keywords>
  <references>
    <see type="doc:BmlDirectives" relation="AuthoringGuide">
      Directive placement.
    </see>
  </references>
</diag:BML_DIRECTIVE_NOT_ALLOWED>
