<!--BlockML Core — BML_EXPR_DIVISION_BY_ZERO diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_DIVISION_BY_ZERO-->
<diag:BML_EXPR_DIVISION_BY_ZERO xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A division-by-zero diagnostic
  </is>
  <summary>
    Emitted for compile-time division by zero when both operands are literals.
  </summary>
  <documentation>
    Emitted for compile-time division by zero when both operands are literals. Only literal operand
    cases are checked at validate time; runtime division remains renderer concern.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_EXPR_DIVISION_BY_ZERO" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Operators and validation.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix the literal divisor.
    </see>
  </references>
</diag:BML_EXPR_DIVISION_BY_ZERO>
