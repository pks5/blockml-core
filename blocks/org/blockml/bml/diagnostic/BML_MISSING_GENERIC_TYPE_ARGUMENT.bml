<!--BlockML Core — BML_MISSING_GENERIC_TYPE_ARGUMENT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_GENERIC_TYPE_ARGUMENT-->
<diag:BML_MISSING_GENERIC_TYPE_ARGUMENT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-generic-type-argument diagnostic
  </is>
  <summary>
    Emitted when a generic application or bml:generics omits a required type argument with no resolvable defaultType.
  </summary>
  <documentation>
    Emitted when a generic application or instance bml:generics omits a required type argument with
    no resolvable defaultType. Remedy: Supply the argument or declare defaultType. An entire missing
    bml:generics on an open-generic instance is BML_OPEN_GENERIC_INSTANCE, not this code.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_MISSING_GENERIC_TYPE_ARGUMENT" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      defaultType, type applications, and instance bml:generics.
    </see>
    <see type="diag:BML_OPEN_GENERIC_INSTANCE" relation="SeeAlso">
      Open generic aggregated without bml:generics.
    </see>
  </references>
</diag:BML_MISSING_GENERIC_TYPE_ARGUMENT>
