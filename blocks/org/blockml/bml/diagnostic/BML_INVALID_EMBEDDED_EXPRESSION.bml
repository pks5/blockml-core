<!--BlockML Core — BML_INVALID_EMBEDDED_EXPRESSION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_EMBEDDED_EXPRESSION-->
<diag:BML_INVALID_EMBEDDED_EXPRESSION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-embedded-expression diagnostic
  </is>
  <summary>
    Emitted when an &lt;$ $> region contains invalid BlockML Expression content.
  </summary>
  <documentation>
    Emitted when an &lt;$ $> region contains invalid BlockML Expression content. Remedy: Use
    #this.capa(...), #built-ins, @bean calls, and the shared expression grammar inside embeds.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_INVALID_EMBEDDED_EXPRESSION" />
  </keywords>
  <references>
    <see type="doc:EmbeddedExpressions" relation="AuthoringGuide">
      Supported embed references.
    </see>
    <see type="doc:Expressions" relation="SeeAlso">
      Shared expression grammar.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Fix embed expression content.
    </see>
  </references>
</diag:BML_INVALID_EMBEDDED_EXPRESSION>
