<!--BlockML Core — BML_TYPE_REFERENCE_MULTIPLICITY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TYPE_REFERENCE_MULTIPLICITY-->
<diag:BML_TYPE_REFERENCE_MULTIPLICITY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A TypeReference-multiplicity diagnostic
  </is>
  <summary>
    Emitted when multiplicity is applied illegally to a TypeReference site that forbids it.
  </summary>
  <documentation>
    Emitted when multiplicity is applied illegally to a TypeReference site that forbids it. Remedy:
    Check the site's type attribute rules — some TypeReference usages are singular only.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_TYPE_REFERENCE_MULTIPLICITY" />
  </keywords>
  <references>
    <see type="type:TypeReference" relation="Defines">
      TypeReference rules.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Multiplicity.
    </see>
  </references>
</diag:BML_TYPE_REFERENCE_MULTIPLICITY>
