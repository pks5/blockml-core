<!--BlockML Core — BML_UNCLOSED_EMBEDDED_EXPRESSION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNCLOSED_EMBEDDED_EXPRESSION-->
<diag:BML_UNCLOSED_EMBEDDED_EXPRESSION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unclosed-embedded-expression diagnostic
  </is>
  <summary>
    Emitted when an implementation body has &lt;$ without a matching $>.
  </summary>
  <documentation>
    Emitted when an implementation body has &lt;$ without a matching $>. Remedy: Every opening
    &lt;$ must close with $>. Nested embeds are forbidden.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_UNCLOSED_EMBEDDED_EXPRESSION" />
  </keywords>
  <references>
    <see type="doc:EmbeddedExpressions" relation="AuthoringGuide">
      Delimiter rules.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Close or remove the embed region.
    </see>
  </references>
</diag:BML_UNCLOSED_EMBEDDED_EXPRESSION>
