<!--BlockML Core — BML_UNKNOWN_SERVICE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_SERVICE-->
<diag:BML_UNKNOWN_SERVICE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-service diagnostic
  </is>
  <summary>
    Emitted when a #service builtin namespace is unknown.
  </summary>
  <documentation>
    Emitted when a #service builtin namespace is unknown. Remedy: Use registered services (#math,
    #strings, #lists, #numbers, #bools).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_UNKNOWN_SERVICE" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Built-ins.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Fix builtin service name.
    </see>
  </references>
</diag:BML_UNKNOWN_SERVICE>
