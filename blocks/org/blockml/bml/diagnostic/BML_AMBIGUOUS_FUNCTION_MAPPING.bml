<!--BlockML Core — BML_AMBIGUOUS_FUNCTION_MAPPING diagnostic

  FQN: org.blockml.bml.diagnostic.BML_AMBIGUOUS_FUNCTION_MAPPING-->
<diag:BML_AMBIGUOUS_FUNCTION_MAPPING xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An ambiguous FunctionMapping diagnostic
  </is>
  <summary>
    Reserved: emitted when a call maps ambiguously under a custom FunctionMapping.
  </summary>
  <documentation>
    Reserved: emitted when a call maps ambiguously under a custom FunctionMapping. Until custom
    mappings ship, treat as reserved.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_AMBIGUOUS_FUNCTION_MAPPING" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Custom FunctionMapping (optional).
    </see>
  </references>
</diag:BML_AMBIGUOUS_FUNCTION_MAPPING>
