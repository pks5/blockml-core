<!--BlockML Core — BML_DUPLICATE_FUNCTION_PARAMETER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_FUNCTION_PARAMETER-->
<diag:BML_DUPLICATE_FUNCTION_PARAMETER xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate function-parameter diagnostic
  </is>
  <summary>
    Emitted when a named call argument is supplied more than once.
  </summary>
  <documentation>
    Emitted when a named call argument is supplied more than once. Remedy: Each inputType field
    may appear at most once in named form.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DUPLICATE_FUNCTION_PARAMETER" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Named call form.
    </see>
  </references>
</diag:BML_DUPLICATE_FUNCTION_PARAMETER>
