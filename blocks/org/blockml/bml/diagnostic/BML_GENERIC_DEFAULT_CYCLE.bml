<!--BlockML Core — BML_GENERIC_DEFAULT_CYCLE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERIC_DEFAULT_CYCLE-->
<diag:BML_GENERIC_DEFAULT_CYCLE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A generic defaultType cycle diagnostic
  </is>
  <summary>
    Emitted when defaultType bindings form a cycle.
  </summary>
  <documentation>
    Emitted when defaultType bindings form a cycle. Remedy: Declaration-order sibling defaults
    already prevent most cycles; this is defense in depth.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_GENERIC_DEFAULT_CYCLE" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      defaultType DAG rules.
    </see>
  </references>
</diag:BML_GENERIC_DEFAULT_CYCLE>
