<!--BlockML Core — BML_LIBRARY_NESTING_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_LIBRARY_NESTING_VIOLATION-->
<diag:BML_LIBRARY_NESTING_VIOLATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A library-nesting diagnostic
  </is>
  <summary>
    Emitted when outer library blocks reference a Block exported only by an inner nested library incorrectly.
  </summary>
  <documentation>
    Typical pattern: inner lists outer in dependencies; outer lists inner in subLibraries. Membership is defined by Library.blocks.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_LIBRARY_NESTING_VIOLATION" />
  </keywords>
  <references>
    <see type="doc:LibrarySystem" relation="AuthoringGuide">
      Nested libraries and membership.
    </see>
  </references>
</diag:BML_LIBRARY_NESTING_VIOLATION>
