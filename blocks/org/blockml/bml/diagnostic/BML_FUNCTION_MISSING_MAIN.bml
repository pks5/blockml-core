<!--BlockML Core — BML_FUNCTION_MISSING_MAIN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_FUNCTION_MISSING_MAIN-->
<diag:BML_FUNCTION_MISSING_MAIN xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-main-function diagnostic
  </is>
  <summary>
    Emitted when an OpenSCAD utility implementation lacks a main function matching the Capability name.
  </summary>
  <documentation>
    Emitted when an OpenSCAD utility implementation lacks a main function matching the Capability
    name. Remedy: Add function &lt;capabilityName>(...) as the main entry.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_FUNCTION_MISSING_MAIN" />
  </keywords>
  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      utility Sub-Blocks.
    </see>
  </references>
</diag:BML_FUNCTION_MISSING_MAIN>
