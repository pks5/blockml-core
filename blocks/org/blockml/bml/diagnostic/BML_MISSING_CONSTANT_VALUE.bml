<!--BlockML Core — BML_MISSING_CONSTANT_VALUE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_CONSTANT_VALUE-->
<diag:BML_MISSING_CONSTANT_VALUE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-constant-value diagnostic
  </is>
  <summary>
    Emitted when Constant(T) omits required {value: …} configuration.
  </summary>
  <documentation>
    Emitted when Constant(T) omits required {value: …} configuration. Remedy: Write Constant(T){value:
    …}.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_CONSTANT_VALUE" />
  </keywords>
  <references>
    <see type="doc:ConstantValueType" relation="AuthoringGuide">
      Constant surface syntax.
    </see>
  </references>
</diag:BML_MISSING_CONSTANT_VALUE>
