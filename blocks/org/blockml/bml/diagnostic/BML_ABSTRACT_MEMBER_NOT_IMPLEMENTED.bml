<!--BlockML Core — BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED-->
<diag:BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unimplemented abstract-member diagnostic
  </is>
  <summary>
    Emitted when a concrete Block still has an abstract member obligation from the inheritance/contract merge.
  </summary>
  <documentation>
    Implement with override="true" and a locally complete declaration (abstract defaults to false). To keep abstract, redeclare with abstract="true".
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      Abstract → implementation.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Complete or re-abstract the inherited member.
    </see>
  </references>
</diag:BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED>
