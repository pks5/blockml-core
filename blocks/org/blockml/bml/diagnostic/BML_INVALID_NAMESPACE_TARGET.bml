<!--BlockML Core — BML_INVALID_NAMESPACE_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_NAMESPACE_TARGET-->
<diag:BML_INVALID_NAMESPACE_TARGET xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-namespace-target diagnostic
  </is>
  <summary>
    Emitted when xmlns targets neither a Package nor an Annotation.
  </summary>
  <documentation>
    Emitted when xmlns targets neither a Package nor an Annotation. Remedy: Bind prefixes to
    package FQNs or Annotation FQNs only.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_INVALID_NAMESPACE_TARGET" />
  </keywords>
  <references>
    <see type="doc:BmlNamespace" relation="AuthoringGuide">
      Package vs Annotation xmlns.
    </see>
  </references>
</diag:BML_INVALID_NAMESPACE_TARGET>
