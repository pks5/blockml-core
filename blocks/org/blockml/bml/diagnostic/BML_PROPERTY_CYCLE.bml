<!--BlockML Core — BML_PROPERTY_CYCLE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PROPERTY_CYCLE-->
<diag:BML_PROPERTY_CYCLE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A property-expression-cycle diagnostic
  </is>
  <summary>
    Emitted when &lt;value> expressions form a cyclic dependency among Properties.
  </summary>
  <documentation>
    Emitted when &lt;value> expressions form a cyclic dependency among Properties. Remedy:
    value expressions may reference own Block Properties and #built-ins only; resolve via topological
    sort.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PROPERTY_CYCLE" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      value expression scope rules.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Break the property dependency cycle.
    </see>
  </references>
</diag:BML_PROPERTY_CYCLE>
