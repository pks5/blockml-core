<!--BlockML Core — BML_MISSING_SUMMARY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_SUMMARY-->
<diag:BML_MISSING_SUMMARY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-summary diagnostic
  </is>
  <summary>
    Warning when documentation is too long for a quick scan and default-namespace summary is omitted.
  </summary>
  <documentation>
    Warning when documentation is too long for a quick scan and default-namespace summary is
    omitted. summary sits between is and documentation for LLM/human orientation.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_MISSING_SUMMARY" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      summary requirements.
    </see>
  </references>
</diag:BML_MISSING_SUMMARY>
