<!--BlockML Core — BML_SUGGESTIONS_ON_ENUM diagnostic

  FQN: org.blockml.bml.diagnostic.BML_SUGGESTIONS_ON_ENUM-->
<diag:BML_SUGGESTIONS_ON_ENUM xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A suggestions-on-enum diagnostic
  </is>
  <summary>
    Emitted when &lt;suggestions> appears on an EnumType-typed property.
  </summary>
  <documentation>
    Emitted when &lt;suggestions> appears on an EnumType-typed property. Remedy: Enum values
    come from the EnumType values aggregation — remove suggestions.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_SUGGESTIONS_ON_ENUM" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Suggestions rules.
    </see>
    <see type="def:PropertyDefinition" relation="Defines">
      suggestions aggregation.
    </see>
  </references>
</diag:BML_SUGGESTIONS_ON_ENUM>
