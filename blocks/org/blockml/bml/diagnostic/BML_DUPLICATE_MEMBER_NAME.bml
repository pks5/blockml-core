<!--BlockML Core — BML_DUPLICATE_MEMBER_NAME diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_MEMBER_NAME-->
<diag:BML_DUPLICATE_MEMBER_NAME xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-member-name diagnostic
  </is>
  <summary>
    Emitted when two members share the same (namespace, normalizedLogicalName) identity.
  </summary>
  <documentation>
    Emitted when two members share the same (namespace, normalizedLogicalName) identity. Remedy:
    Rename one member or fix visibility-prefix duplicates.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DUPLICATE_MEMBER_NAME" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Member identity.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Override vs new.
    </see>
  </references>
</diag:BML_DUPLICATE_MEMBER_NAME>
