<!--BlockML Core — BML_TYPE_BOUND_NOT_SATISFIED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TYPE_BOUND_NOT_SATISFIED-->
<diag:BML_TYPE_BOUND_NOT_SATISFIED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A type-bound-not-satisfied diagnostic
  </is>
  <summary>
    Emitted when satisfiesTypeBound(T, G) fails for a generic/contract bound.
  </summary>
  <documentation>
    Emitted when satisfiesTypeBound(T, G) fails for a generic/contract bound. Remedy: Ensure
    T extends G via baseType chain or lists G in contracts[].
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_TYPE_BOUND_NOT_SATISFIED" />
  </keywords>
  <references>
    <see type="doc:ContractsModel" relation="AuthoringGuide">
      satisfiesTypeBound.
    </see>
    <see type="doc:GenericsModel" relation="SeeAlso">
      Generic bounds.
    </see>
  </references>
</diag:BML_TYPE_BOUND_NOT_SATISFIED>
