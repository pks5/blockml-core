<!--BlockML Core — BML_INVALID_VALUE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_VALUE-->
<diag:BML_INVALID_VALUE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:exception="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-value diagnostic
  </is>
  <summary>
    Emitted when a host evaluates PrimitiveType.parseValue and the body throws InvalidValueException.
  </summary>
  <documentation>
    Emitted when authored property text fails the lexical parse for the declared PrimitiveType.
    The Capability throws exception:InvalidValueException; the validator reports this Diagnostic.
    Remedy: fix the literal to match the type's parseValue contract (doc:ValueTypeParsing).
    
    Not used for TypeReference existence (BML_UNKNOWN_TYPE), instance existence
    (BML_UNRESOLVABLE_INSTANCE_REF), type-instance configuration, or Property constraints.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_INVALID_VALUE" />
  </keywords>
  <references>
    <see type="type:PrimitiveType" relation="Defines">
      parseValue — lexical acceptance of authored Text.
    </see>
    <see type="doc:ValueTypeParsing" relation="AuthoringGuide">
      Parse vs configuration vs constraints vs existence.
    </see>
    <see type="exception:InvalidValueException" relation="ContrastsWith">
      Capability-thrown exception the host maps to this code.
    </see>
    <see type="core:Exception" relation="ContrastsWith">
      Capability throws types — not validator codes.
    </see>
  </references>
</diag:BML_INVALID_VALUE>
