<!--BlockML Core — BML_INVALID_PROPERTY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_PROPERTY-->
<diag:BML_INVALID_PROPERTY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-property diagnostic
  </is>
  <summary>
    Emitted when a property declaration or instance value is structurally invalid.
  </summary>
  <documentation>
    Emitted when a property declaration or instance value is structurally invalid. Remedy: Check
    property type, value placement, and facets.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_INVALID_PROPERTY" />
  </keywords>
  <references>
    <see type="def:PropertyDefinition" relation="Defines">
      Property rules.
    </see>
    <see type="doc:ValueTypeConfiguration" relation="SeeAlso">
      Configured types.
    </see>
  </references>
</diag:BML_INVALID_PROPERTY>
