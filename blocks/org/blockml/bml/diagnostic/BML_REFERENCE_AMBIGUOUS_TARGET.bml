<!--BlockML Core — BML_REFERENCE_AMBIGUOUS_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REFERENCE_AMBIGUOUS_TARGET-->
<diag:BML_REFERENCE_AMBIGUOUS_TARGET xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An ambiguous-reference diagnostic
  </is>
  <summary>
    Emitted when a documentation &lt;see> target is ambiguous.
  </summary>
  <documentation>
    Emitted when a documentation &lt;see> target is ambiguous. Remedy: Use exactly one target
    kind or a disambiguating split form.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_REFERENCE_AMBIGUOUS_TARGET" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      see target attributes.
    </see>
  </references>
</diag:BML_REFERENCE_AMBIGUOUS_TARGET>
