<!--BlockML Core — BML_EXPRESSION_TYPE_ERROR diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPRESSION_TYPE_ERROR-->
<diag:BML_EXPRESSION_TYPE_ERROR xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An expression-type-error diagnostic
  </is>
  <summary>
    Legacy/alias style expression type error — prefer BML_EXPR_TYPE_MISMATCH where applicable.
  </summary>
  <documentation>
    Legacy/alias style expression type error — prefer BML_EXPR_TYPE_MISMATCH where applicable.
    Align expression result type with the target member type.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_EXPRESSION_TYPE_ERROR" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Expression typing.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix expression types.
    </see>
  </references>
</diag:BML_EXPRESSION_TYPE_ERROR>
