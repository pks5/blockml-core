<!--BlockML Core — BML_CONSTRAINT_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_TYPE_MISMATCH-->
<diag:BML_CONSTRAINT_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-type mismatch diagnostic
  </is>
  <summary>
    Emitted when constraint generic T is incompatible with the bound target type.
  </summary>
  <documentation>
    Emitted when constraint generic T is incompatible with the bound target type. Remedy: Choose
    a constraint whose T binds from the embedding context type.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_CONSTRAINT_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Constraint generics.
    </see>
    <see type="howto:AddConstraint" relation="Resolves">
      Pick a compatible constraint.
    </see>
  </references>
</diag:BML_CONSTRAINT_TYPE_MISMATCH>
