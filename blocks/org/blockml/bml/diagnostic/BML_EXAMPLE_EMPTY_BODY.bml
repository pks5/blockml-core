<!--BlockML Core — BML_EXAMPLE_EMPTY_BODY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXAMPLE_EMPTY_BODY-->
<diag:BML_EXAMPLE_EMPTY_BODY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An empty-example diagnostic
  </is>
  <summary>
    Emitted when an example entry has an empty body.
  </summary>
  <documentation>
    Emitted when an example entry has an empty body. Remedy: Provide CDATA/text content for the
    example.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_EXAMPLE_EMPTY_BODY" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      examples.
    </see>
  </references>
</diag:BML_EXAMPLE_EMPTY_BODY>
