<!--BlockML Core — BML_CHANGELOG_VERSION_ORDER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CHANGELOG_VERSION_ORDER-->
<diag:BML_CHANGELOG_VERSION_ORDER xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A changelog version-order diagnostic
  </is>
  <summary>
    Emitted when changelog entries are not in oldest-first version order.
  </summary>
  <documentation>
    Emitted when changelog entries are not in oldest-first version order. Remedy: Order &lt;change>
    entries ascending by version.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_CHANGELOG_VERSION_ORDER" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      changelog rules.
    </see>
  </references>
</diag:BML_CHANGELOG_VERSION_ORDER>
