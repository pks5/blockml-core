<!--BlockML Core — BML_OVERRIDE_WITHOUT_PARENT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_OVERRIDE_WITHOUT_PARENT-->
<diag:BML_OVERRIDE_WITHOUT_PARENT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An override-without-parent diagnostic
  </is>
  <summary>
    Emitted when override="true" is set but no matching parent member exists in the baseType chain or contracts[].
  </summary>
  <documentation>
    A genuinely new member must not set override="true". Check namespace + normalizedLogicalName identity and contract merge order.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_OVERRIDE_WITHOUT_PARENT" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      new vs override modes.
    </see>
    <see type="task:FixMemberOverride" relation="Resolves">
      Remove override or fix inherited member identity.
    </see>
  </references>
</diag:BML_OVERRIDE_WITHOUT_PARENT>
