<!--BlockML Core — BML_FINAL_BASE_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_FINAL_BASE_TYPE-->
<diag:BML_FINAL_BASE_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A final-baseType diagnostic
  </is>
  <summary>
    Emitted when a Block uses a final type as baseType.
  </summary>
  <documentation>
    final="true" on a block definition prevents other definitions from extending it. Choose a non-final base or unseal the parent if you control it.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_FINAL_BASE_TYPE" />
  </keywords>
  <references>
    <see type="doc:ModelingGuidelines" relation="AuthoringGuide">
      final on Block definitions.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Local declaration properties.
    </see>
  </references>
</diag:BML_FINAL_BASE_TYPE>
