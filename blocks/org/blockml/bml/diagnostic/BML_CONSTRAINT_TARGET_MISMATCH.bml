<!--BlockML Core — BML_CONSTRAINT_TARGET_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_TARGET_MISMATCH-->
<diag:BML_CONSTRAINT_TARGET_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-target mismatch diagnostic
  </is>
  <summary>
    Emitted when a Constraint branch is placed in an incompatible embedding context.
  </summary>
  <documentation>
    Emitted when a Constraint branch is placed in an incompatible embedding context. Remedy:
    Constraint generics are compiler-bound from context (Property → ValueType, Aggregation →
    AggregationDefinition, …).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_CONSTRAINT_TARGET_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      Constraint generic binding from context.
    </see>
    <see type="doc:ModelingGuidelines" relation="SeeAlso">
      Constraint placement patterns.
    </see>
  </references>
</diag:BML_CONSTRAINT_TARGET_MISMATCH>
