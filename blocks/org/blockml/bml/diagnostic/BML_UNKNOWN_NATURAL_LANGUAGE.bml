<!--BlockML Core — BML_UNKNOWN_NATURAL_LANGUAGE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_NATURAL_LANGUAGE-->
<diag:BML_UNKNOWN_NATURAL_LANGUAGE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-natural-language diagnostic
  </is>
  <summary>
    Emitted when a NaturalLanguage reference does not resolve.
  </summary>
  <documentation>
    Emitted when a NaturalLanguage reference does not resolve. Remedy: Use org.blockml.bml.language.*
    NaturalLanguage blocks (English, German, …).
  </documentation>
  <keywords>
    <meta:Keyword value="BML_UNKNOWN_NATURAL_LANGUAGE" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      language inheritance.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      NaturalLanguage sites.
    </see>
  </references>
</diag:BML_UNKNOWN_NATURAL_LANGUAGE>
