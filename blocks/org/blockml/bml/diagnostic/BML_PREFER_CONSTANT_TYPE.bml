<!--BlockML Core — BML_PREFER_CONSTANT_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PREFER_CONSTANT_TYPE-->
<diag:BML_PREFER_CONSTANT_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A prefer-Constant diagnostic
  </is>
  <summary>
    Warning: prefer Constant(T){value: …} over obsolete wrapper/literal union forms.
  </summary>
  <documentation>
    Warning: prefer Constant(T){value: …} over obsolete wrapper/literal union forms. Migrate
    AutoOr/FalseOr/NoneOr and bare literal unions to Constant form.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_PREFER_CONSTANT_TYPE" />
  </keywords>
  <references>
    <see type="doc:ConstantValueType" relation="AuthoringGuide">
      Constant form.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Obsolete wrappers.
    </see>
  </references>
</diag:BML_PREFER_CONSTANT_TYPE>
