<!--BlockML Core — BML_INVALID_BLOCK_NAME diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_BLOCK_NAME-->
<diag:BML_INVALID_BLOCK_NAME xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid Block-name diagnostic
  </is>
  <summary>
    Emitted when &lt;name> is not PascalCase letters-and-digits ([A-Z][a-zA-Z0-9]*).
  </summary>
  <documentation>
    Emitted when &lt;name> is not PascalCase letters-and-digits ([A-Z][a-zA-Z0-9]*). Remedy:
    PascalCase keeps composition tags with xmlns prefixes unambiguous — member names use camelCase.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_INVALID_BLOCK_NAME" />
  </keywords>
  <references>
    <see type="doc:BlockNameConvention" relation="AuthoringGuide">
      Block name format.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      name vs type identity.
    </see>
  </references>
</diag:BML_INVALID_BLOCK_NAME>
