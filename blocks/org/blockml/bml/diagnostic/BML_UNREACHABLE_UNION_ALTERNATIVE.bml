<!--BlockML Core — BML_UNREACHABLE_UNION_ALTERNATIVE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNREACHABLE_UNION_ALTERNATIVE-->
<diag:BML_UNREACHABLE_UNION_ALTERNATIVE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unreachable-union-alternative diagnostic
  </is>
  <summary>
    Warning: a later union alternative cannot win under left-to-right first-hit matching.
  </summary>
  <documentation>
    Warning: a later union alternative cannot win under left-to-right first-hit matching. Prefer
    narrower/sentinel alternatives on the left. Advisory like unreachable code — compile succeeds.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_UNREACHABLE_UNION_ALTERNATIVE" />
  </keywords>
  <references>
    <see type="doc:TypeExpressions" relation="AuthoringGuide">
      Union match order and unreachable alternatives.
    </see>
  </references>
</diag:BML_UNREACHABLE_UNION_ALTERNATIVE>
