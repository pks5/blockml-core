<!--BlockML Core — BML_INVALID_SINCE_VERSION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_INVALID_SINCE_VERSION-->
<diag:BML_INVALID_SINCE_VERSION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An invalid-since-version diagnostic
  </is>
  <summary>
    Emitted when since is not a valid Version value.
  </summary>
  <documentation>
    Emitted when since is not a valid Version value. Remedy: Use org.blockml.bml.type.Version
    format.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_INVALID_SINCE_VERSION" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      since.
    </see>
  </references>
</diag:BML_INVALID_SINCE_VERSION>
