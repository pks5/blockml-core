<!--BlockML Core — BML_READONLY_MEMBER_WRITE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_READONLY_MEMBER_WRITE-->
<diag:BML_READONLY_MEMBER_WRITE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A readOnly instance-write diagnostic
  </is>
  <summary>
    Emitted when a Block instance sets a member whose effective definition has readOnly=true.
  </summary>
  <documentation>
    Definition authoring and child definition overrides may set readOnly member values/composition; instances must not. Expressions may still read subject to visibility.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_READONLY_MEMBER_WRITE" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      readOnly vs instance authoring.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Remove instance write or adjust readOnly on definition.
    </see>
  </references>
</diag:BML_READONLY_MEMBER_WRITE>
