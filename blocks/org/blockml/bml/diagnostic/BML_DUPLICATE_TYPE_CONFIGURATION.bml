<!--BlockML Core — BML_DUPLICATE_TYPE_CONFIGURATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_TYPE_CONFIGURATION-->
<diag:BML_DUPLICATE_TYPE_CONFIGURATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate type-configuration diagnostic
  </is>
  <summary>
    Emitted when the same configuration property is supplied twice in {...}.
  </summary>
  <documentation>
    Emitted when the same configuration property is supplied twice in {...}. Remedy: Provide
    each configuration key once.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DUPLICATE_TYPE_CONFIGURATION" />
  </keywords>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      Instance configuration.
    </see>
  </references>
</diag:BML_DUPLICATE_TYPE_CONFIGURATION>
