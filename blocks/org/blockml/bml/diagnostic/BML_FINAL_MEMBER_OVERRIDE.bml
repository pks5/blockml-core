<!--BlockML Core — BML_FINAL_MEMBER_OVERRIDE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_FINAL_MEMBER_OVERRIDE-->
<diag:BML_FINAL_MEMBER_OVERRIDE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A final-member override diagnostic
  </is>
  <summary>
    Emitted when a child attempts to override a final member, or to override a private member.
  </summary>
  <documentation>
    final="true" seals a declaration. Private members are also non-overridable. Remove the override or change the parent declaration.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_FINAL_MEMBER_OVERRIDE" />
  </keywords>
  <references>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      final and private cannot be overridden.
    </see>
    <see type="doc:MemberVisibility" relation="SeeAlso">
      Private override prohibition.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Stop overriding sealed or private members.
    </see>
  </references>
</diag:BML_FINAL_MEMBER_OVERRIDE>
