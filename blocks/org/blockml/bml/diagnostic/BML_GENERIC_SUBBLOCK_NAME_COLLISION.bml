<!--BlockML Core — BML_GENERIC_SUBBLOCK_NAME_COLLISION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERIC_SUBBLOCK_NAME_COLLISION-->
<diag:BML_GENERIC_SUBBLOCK_NAME_COLLISION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A generic/Sub-Block-name collision diagnostic
  </is>
  <summary>
    Emitted when a genericTypes parameter name equals a direct Sub-Block local name on the same Block.
  </summary>
  <documentation>
    Emitted when a genericTypes parameter name equals a direct Sub-Block local name on the same
    Block. Remedy: Rename the generic parameter or the Sub-Block so nested unqualified resolution
    remains unambiguous.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_GENERIC_SUBBLOCK_NAME_COLLISION" />
  </keywords>
  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Generic vs Sub-Block name collisions.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      Sub-Block naming.
    </see>
  </references>
</diag:BML_GENERIC_SUBBLOCK_NAME_COLLISION>
