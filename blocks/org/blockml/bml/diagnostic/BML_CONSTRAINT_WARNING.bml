<!--BlockML Core — BML_CONSTRAINT_WARNING diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_WARNING-->
<diag:BML_CONSTRAINT_WARNING xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-warning diagnostic
  </is>
  <summary>
    Emitted when a constraint fails with validation=Warning.
  </summary>
  <documentation>
    Emitted when a constraint fails with validation=Warning. Remedy: Warning only — compilation
    continues unless elevated by policy.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_CONSTRAINT_WARNING" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Warning severity.
    </see>
    <see type="howto:AddConstraint" relation="Resolves">
      Address the warning.
    </see>
  </references>
</diag:BML_CONSTRAINT_WARNING>
