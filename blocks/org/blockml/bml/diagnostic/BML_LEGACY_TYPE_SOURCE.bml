<!--BlockML Core — BML_LEGACY_TYPE_SOURCE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_LEGACY_TYPE_SOURCE-->
<diag:BML_LEGACY_TYPE_SOURCE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A legacy-type-source diagnostic
  </is>
  <summary>
    Emitted when a type still comes from a legacy XSD/YAML source during migration.
  </summary>
  <documentation>
    Emitted when a type still comes from a legacy XSD/YAML source during migration. Remedy: Migrate
    to BML TypeRegistry definitions.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_LEGACY_TYPE_SOURCE" />
  </keywords>
  <references>
    <see type="doc:TypeSystemOverview" relation="AuthoringGuide">
      BML type SSOT.
    </see>
    <see type="doc:BootstrapModel" relation="SeeAlso">
      TypeRegistry bootstrap.
    </see>
  </references>
</diag:BML_LEGACY_TYPE_SOURCE>
