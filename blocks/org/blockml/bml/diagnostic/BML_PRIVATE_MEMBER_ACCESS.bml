<!--BlockML Core — BML_PRIVATE_MEMBER_ACCESS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PRIVATE_MEMBER_ACCESS-->
<diag:BML_PRIVATE_MEMBER_ACCESS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A private-member access diagnostic
  </is>
  <summary>
    Emitted when a private member is read or set outside the Block definition that declares it.
  </summary>
  <documentation>
    Private members (__name) are usable only within the declaring Block's definition — including instances of the declaring type in that same definition. Composition ownership does not lift private encapsulation of contained Sub-Block instances.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PRIVATE_MEMBER_ACCESS" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Private access rules and formal D/C/I/O table.
    </see>
    <see type="howto:FixVisibilityAccess" relation="Resolves">
      Fix private/protected member or Sub-Block access.
    </see>
  </references>
</diag:BML_PRIVATE_MEMBER_ACCESS>
