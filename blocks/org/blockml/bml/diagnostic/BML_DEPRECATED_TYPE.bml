<!--BlockML Core — BML_DEPRECATED_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DEPRECATED_TYPE-->
<diag:BML_DEPRECATED_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A deprecated-type diagnostic
  </is>
  <summary>
    Emitted when a referenced type is marked deprecated/status Deprecated.
  </summary>
  <documentation>
    Emitted when a referenced type is marked deprecated/status Deprecated. Remedy: Prefer the
    replacement type; status may be warning-level depending on policy.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DEPRECATED_TYPE" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="SeeAlso">
      status markers.
    </see>
  </references>
</diag:BML_DEPRECATED_TYPE>
