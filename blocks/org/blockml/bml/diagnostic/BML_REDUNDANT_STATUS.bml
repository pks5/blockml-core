<!--BlockML Core — BML_REDUNDANT_STATUS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REDUNDANT_STATUS-->
<diag:BML_REDUNDANT_STATUS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A redundant-status diagnostic
  </is>
  <summary>
    Warning: explicit status duplicates the effective/default status unnecessarily.
  </summary>
  <documentation>
    Warning: explicit status duplicates the effective/default status unnecessarily. Omit redundant
    status unless documenting intent.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_REDUNDANT_STATUS" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      status.
    </see>
  </references>
</diag:BML_REDUNDANT_STATUS>
