<!--BlockML Core — BML_MISSING_IMPLEMENTATION_LANGUAGE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_IMPLEMENTATION_LANGUAGE-->
<diag:BML_MISSING_IMPLEMENTATION_LANGUAGE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-implementation-language diagnostic
  </is>
  <summary>
    Emitted when &lt;implementation> omits required language.
  </summary>
  <documentation>
    Emitted when &lt;implementation> omits required language. Remedy: Set language to an org.blockml.bml.language.*
    FQN.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_IMPLEMENTATION_LANGUAGE" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      implementation.
    </see>
    <see type="def:CapabilityDefinition" relation="Defines">
      implementation child.
    </see>
  </references>
</diag:BML_MISSING_IMPLEMENTATION_LANGUAGE>
