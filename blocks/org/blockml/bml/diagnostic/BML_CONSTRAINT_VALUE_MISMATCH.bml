<!--BlockML Core — BML_CONSTRAINT_VALUE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_VALUE_MISMATCH-->
<diag:BML_CONSTRAINT_VALUE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-value mismatch diagnostic
  </is>
  <summary>
    Emitted when a constraint instance property value is incompatible with bound T.
  </summary>
  <documentation>
    Emitted when a constraint instance property value is incompatible with bound T. Remedy: Fix
    the constraint parameter value types (e.g. Min.value).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_CONSTRAINT_VALUE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Constraint instance values.
    </see>
    <see type="howto:AddConstraint" relation="Resolves">
      Fix constraint parameters.
    </see>
  </references>
</diag:BML_CONSTRAINT_VALUE_MISMATCH>
