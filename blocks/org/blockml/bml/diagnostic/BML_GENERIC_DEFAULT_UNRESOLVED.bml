<!--BlockML Core — BML_GENERIC_DEFAULT_UNRESOLVED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERIC_DEFAULT_UNRESOLVED-->
<diag:BML_GENERIC_DEFAULT_UNRESOLVED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unresolved generic default diagnostic
  </is>
  <summary>
    Emitted when a defaultType chain does not ground to a concrete TypeExpression.
  </summary>
  <documentation>
    Emitted when a defaultType chain does not ground to a concrete TypeExpression. Remedy: Every
    unbound parameter at a reference site must resolve via authored args or defaults.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_GENERIC_DEFAULT_UNRESOLVED" />
  </keywords>
  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      defaultType grounding.
    </see>
  </references>
</diag:BML_GENERIC_DEFAULT_UNRESOLVED>
