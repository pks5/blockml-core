<!--BlockML Core — BML_PROTECTED_MEMBER_ACCESS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PROTECTED_MEMBER_ACCESS-->
<diag:BML_PROTECTED_MEMBER_ACCESS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A protected-member access diagnostic
  </is>
  <summary>
    Emitted when a protected member is used outside declaring Block, inheritance, or immediate composition-owner context.
  </summary>
  <documentation>
    Protected members (_name) allow access when C=D, C inherits from D, C is the immediate composition owner O, or C inherits from instance type I. Outer composition ancestors do not receive protected configuration access.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PROTECTED_MEMBER_ACCESS" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Protected access and composition-owner rule.
    </see>
    <see type="howto:FixVisibilityAccess" relation="Resolves">
      Fix private/protected member or Sub-Block access.
    </see>
  </references>
</diag:BML_PROTECTED_MEMBER_ACCESS>
