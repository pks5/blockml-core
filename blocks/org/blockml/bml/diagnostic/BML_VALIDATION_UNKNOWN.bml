<!--BlockML Core — BML_VALIDATION_UNKNOWN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_VALIDATION_UNKNOWN-->
<diag:BML_VALIDATION_UNKNOWN xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-validation diagnostic
  </is>
  <summary>
    Emitted when constraint validation= does not resolve to a Validation block.
  </summary>
  <documentation>
    Emitted when constraint validation= does not resolve to a Validation block. Remedy: Use Error,
    Warning, or Information.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_VALIDATION_UNKNOWN" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Validation property.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      validation implicit NS.
    </see>
  </references>
</diag:BML_VALIDATION_UNKNOWN>
