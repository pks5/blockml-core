<!--BlockML Core — BML_UNKNOWN_DIRECTIVE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_DIRECTIVE-->
<diag:BML_UNKNOWN_DIRECTIVE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-directive diagnostic
  </is>
  <summary>
    Emitted when an unknown bml: directive name is used.
  </summary>
  <documentation>
    Emitted when an unknown bml: directive name is used. Remedy: Use directives declared on org.blockml.bml.annotation.BmlAnnotation.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_UNKNOWN_DIRECTIVE" />
  </keywords>
  <references>
    <see type="doc:BmlDirectives" relation="AuthoringGuide">
      Directive catalogue.
    </see>
  </references>
</diag:BML_UNKNOWN_DIRECTIVE>
