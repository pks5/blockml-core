<!--BlockML Core — BML_DUPLICATE_SUMMARY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_SUMMARY-->
<diag:BML_DUPLICATE_SUMMARY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-summary diagnostic
  </is>
  <summary>
    Emitted when summary entries collide on (namespace, languageFqn).
  </summary>
  <documentation>
    Emitted when summary entries collide on (namespace, languageFqn). Remedy: Keep one summary
    per namespace/language pair.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_DUPLICATE_SUMMARY" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      summary rules.
    </see>
  </references>
</diag:BML_DUPLICATE_SUMMARY>
