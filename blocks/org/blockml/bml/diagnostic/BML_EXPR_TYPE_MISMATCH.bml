<!--BlockML Core — BML_EXPR_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_TYPE_MISMATCH-->
<diag:BML_EXPR_TYPE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An expression type-mismatch diagnostic
  </is>
  <summary>
    Emitted when the expression result type is incompatible with the target member type.
  </summary>
  <documentation>
    Emitted when the expression result type is incompatible with the target member type, or when
    interpolated Text holes are authored on a member that is not type:Text. Remedy: Align
    operators/calls with the Property or Capability payload type after inference. Keep
    interpolation on type:Text (or type:Text[] string leaves) — doc:Expressions.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_EXPR_TYPE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Validation vs evaluation.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Allowed ValueType expressions.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix expression result type.
    </see>
  </references>
</diag:BML_EXPR_TYPE_MISMATCH>
