<!--
  BlockML Core — BML_GENERICS_ARGUMENT_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_GENERICS_ARGUMENT_MISMATCH
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:ann="org.blockml.bml.annotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <name>BML_GENERICS_ARGUMENT_MISMATCH</name>
  <type>diag:BML_GENERICS_ARGUMENT_MISMATCH</type>
  <baseType>core:Diagnostic</baseType>
  <is>A bml:generics argument-mismatch diagnostic</is>

  <summary>Emitted when bml:generics does not match the instance's open genericTypes.</summary>

  <keywords>BML_GENERICS_ARGUMENT_MISMATCH</keywords>

  <documentation>
    Emitted when bml:generics is present on a Block instance but the argument list is not compatible
    with that instance's open genericTypes: the type has no open parameters, the argument count
    does not match (including extra arguments), or the value is not a parenthesized list in the
    same form as a baseType generic application. Remedy: Supply a parenthesized TypeExpression list
    in declaration order that binds the open parameters, or omit the directive when none are open.
    Argument values that fail the parameter baseType → BML_GENERIC_CONSTRAINT_VIOLATION. A
    required argument omitted with no defaultType → BML_MISSING_GENERIC_TYPE_ARGUMENT.
    Ill-formed TypeExpression syntax → BML_INVALID_TYPE_REFERENCE.
  </documentation>

  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      Instance bml:generics syntax and resolution.
    </see>
    <see type="doc:BmlDirectives" relation="SeeAlso">
      bml:generics placement and parenthesized argument list.
    </see>
    <see type="ann:BmlAnnotation.Generics" relation="Defines">
      Directive catalogue entry.
    </see>
    <see type="diag:BML_GENERIC_CONSTRAINT_VIOLATION" relation="SeeAlso">
      Type argument fails parameter baseType.
    </see>
    <see type="diag:BML_MISSING_GENERIC_TYPE_ARGUMENT" relation="SeeAlso">
      Required argument omitted with no defaultType.
    </see>
    <see type="diag:BML_INVALID_TYPE_REFERENCE" relation="SeeAlso">
      Ill-formed TypeExpression in the directive value.
    </see>
  </references>

</block>
