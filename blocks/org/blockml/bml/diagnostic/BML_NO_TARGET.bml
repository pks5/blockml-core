<!--BlockML Core — BML_NO_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_NO_TARGET-->
<diag:BML_NO_TARGET xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A no-render-target diagnostic
  </is>
  <summary>
    Emitted when compilation is requested with no configured render target.
  </summary>
  <documentation>
    Emitted when compilation is requested with no configured render target. Remedy: Configure
    targets[] in bom.config / CLI.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_NO_TARGET" />
  </keywords>
  <references>
    <see type="doc:CompilerArchitecture" relation="AuthoringGuide">
      Pipeline overview.
    </see>
  </references>
</diag:BML_NO_TARGET>
