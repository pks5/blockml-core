<!--BlockML Core — BML_FUNCTION_NO_RUNTIME_IMPL diagnostic

  FQN: org.blockml.bml.diagnostic.BML_FUNCTION_NO_RUNTIME_IMPL-->
<diag:BML_FUNCTION_NO_RUNTIME_IMPL xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-runtime-implementation diagnostic
  </is>
  <summary>
    Emitted when a Capability requires a runtime implementation that is not provided for the target.
  </summary>
  <documentation>
    Emitted when a Capability requires a runtime implementation that is not provided for the
    target. Remedy: Supply an implementation language/body supported by the renderer, or mark
    appropriately.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_FUNCTION_NO_RUNTIME_IMPL" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      Implementations.
    </see>
    <see type="doc:SubBlockModel" relation="SeeAlso">
      utility implementations.
    </see>
  </references>
</diag:BML_FUNCTION_NO_RUNTIME_IMPL>
