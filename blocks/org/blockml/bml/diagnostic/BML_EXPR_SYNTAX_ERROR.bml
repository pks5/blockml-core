<!--BlockML Core — BML_EXPR_SYNTAX_ERROR diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_SYNTAX_ERROR-->
<diag:BML_EXPR_SYNTAX_ERROR xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An expression syntax-error diagnostic
  </is>
  <summary>
    Emitted when expression raw text fails to parse (parseExpression utility).
  </summary>
  <documentation>
    Emitted when expression raw text fails to parse (parseExpression utility). Remedy: Check
    ${ } / &lt;$ $> delimiters, quotes, operators, and balanced brackets. An unclosed ${ in
    interpolated Text is this code. Nested embed delimiters are invalid.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_EXPR_SYNTAX_ERROR" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Expression language overview.
    </see>
    <see type="doc:EmbeddedExpressions" relation="SeeAlso">
      Embed delimiter rules.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix expression syntax and references.
    </see>
  </references>
</diag:BML_EXPR_SYNTAX_ERROR>
