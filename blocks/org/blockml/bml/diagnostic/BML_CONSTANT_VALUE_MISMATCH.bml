<!--BlockML Core — BML_CONSTANT_VALUE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTANT_VALUE_MISMATCH-->
<diag:BML_CONSTANT_VALUE_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constant-value mismatch diagnostic
  </is>
  <summary>
    Emitted when a value does not equal the configured Constant(T){value: …} literal after type checks.
  </summary>
  <documentation>
    Emitted when a value does not equal the configured Constant(T){value: …} literal after type
    checks. Remedy: Use the exact singleton literal allowed by the Constant configuration.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_CONSTANT_VALUE_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:ConstantValueType" relation="AuthoringGuide">
      Constant validation.
    </see>
  </references>
</diag:BML_CONSTANT_VALUE_MISMATCH>
