<!--BlockML Core — BML_MISSING_IS_NOT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_IS_NOT-->
<diag:BML_MISSING_IS_NOT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-isNot diagnostic
  </is>
  <summary>
    Warning/required when confusion risk exists and isNot is omitted on a Block.
  </summary>
  <documentation>
    Warning/required when confusion risk exists and isNot is omitted on a Block. isNot is block-level
    negative space for disambiguation. Missing when required → this code.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_IS_NOT" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      isNot rules.
    </see>
  </references>
</diag:BML_MISSING_IS_NOT>
