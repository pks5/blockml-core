<!--BlockML Core — BML_TYPE_REFERENCE_CHILD_VALUE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TYPE_REFERENCE_CHILD_VALUE-->
<diag:BML_TYPE_REFERENCE_CHILD_VALUE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A TypeReferenceEntity child-value diagnostic
  </is>
  <summary>
    Emitted when TypeReferenceEntity sugar/children violate value authoring rules.
  </summary>
  <documentation>
    Emitted when TypeReferenceEntity sugar/children violate value authoring rules. Remedy: Empty
    QName children expand to value=; do not mix illegal child shapes.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_TYPE_REFERENCE_CHILD_VALUE" />
  </keywords>
  <references>
    <see type="type:TypeReferenceEntity" relation="Defines">
      Empty child sugar.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Type references.
    </see>
  </references>
</diag:BML_TYPE_REFERENCE_CHILD_VALUE>
