<!--BlockML Core — BML_MISSING_BASE_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_BASE_TYPE-->
<diag:BML_MISSING_BASE_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-baseType diagnostic
  </is>
  <summary>
    Emitted when a Block other than org.blockml.bml.core.Block omits baseType.
  </summary>
  <documentation>
    Emitted when a Block other than org.blockml.bml.core.Block omits baseType. Remedy: Single
    inheritance is mandatory except on the sole root org.blockml.bml.core.Block.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_MISSING_BASE_TYPE" />
  </keywords>
  <references>
    <see type="doc:ModelingGuidelines" relation="AuthoringGuide">
      baseType inheritance.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Identity fields.
    </see>
  </references>
</diag:BML_MISSING_BASE_TYPE>
