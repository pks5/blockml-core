<!--BlockML Core — BML_XML_DIRECTIVE_NOT_ALLOWED diagnostic

  FQN: org.blockml.bml.diagnostic.BML_XML_DIRECTIVE_NOT_ALLOWED-->
<diag:BML_XML_DIRECTIVE_NOT_ALLOWED xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A disallowed bml:xml diagnostic
  </is>
  <summary>
    Emitted when bml:xml is authored where the grammar/branch does not allow it (e.g. block-level on ordinary ValueType).
  </summary>
  <documentation>
    Block-level &lt;bml:xml> is for core:Block and Definition-branch types. Member bml:xml belongs on Definition-branch member declarations. Hybrid Stage 1/2 checks apply.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_XML_DIRECTIVE_NOT_ALLOWED" />
  </keywords>
  <references>
    <see type="doc:BmlDirectives" relation="AuthoringGuide">
      bml:xml placement rules.
    </see>
    <see type="doc:DefinitionModel" relation="SeeAlso">
      Definition branch serialization metadata.
    </see>
  </references>
</diag:BML_XML_DIRECTIVE_NOT_ALLOWED>
