<!--BlockML Core — BML_REFERENCE_MISSING_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REFERENCE_MISSING_TARGET-->
<diag:BML_REFERENCE_MISSING_TARGET xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-reference-target diagnostic
  </is>
  <summary>
    Emitted when a &lt;see> entry has no target attribute.
  </summary>
  <documentation>
    Emitted when a &lt;see> entry has no target attribute. Remedy: Provide type, instance,
    file, url, or member path target.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_REFERENCE_MISSING_TARGET" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      see targets.
    </see>
  </references>
</diag:BML_REFERENCE_MISSING_TARGET>
