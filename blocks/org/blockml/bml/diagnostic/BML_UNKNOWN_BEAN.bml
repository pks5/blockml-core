<!--BlockML Core — BML_UNKNOWN_BEAN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_BEAN-->
<diag:BML_UNKNOWN_BEAN xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-bean-name diagnostic
  </is>
  <summary>
    Emitted when a bean name cannot be resolved (alias of expression bean errors in some pipelines).
  </summary>
  <documentation>
    Emitted when a bean name cannot be resolved (alias of expression bean errors in some pipelines).
    Remedy: Declare bml:bean on the instance; prefer BML_EXPR_UNKNOWN_BEAN for expression sites.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_UNKNOWN_BEAN" />
  </keywords>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Bean scope.
    </see>
    <see type="doc:BmlDirectives" relation="SeeAlso">
      bml:bean.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix bean declaration.
    </see>
  </references>
</diag:BML_UNKNOWN_BEAN>
