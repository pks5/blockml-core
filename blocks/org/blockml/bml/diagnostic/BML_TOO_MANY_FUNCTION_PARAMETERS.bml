<!--BlockML Core — BML_TOO_MANY_FUNCTION_PARAMETERS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TOO_MANY_FUNCTION_PARAMETERS-->
<diag:BML_TOO_MANY_FUNCTION_PARAMETERS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A too-many function-parameters diagnostic
  </is>
  <summary>
    Emitted when a call supplies more positional arguments than the inputType arity allows.
  </summary>
  <documentation>
    Emitted when a call supplies more positional arguments than the inputType arity allows. Remedy:
    Trim excess arguments or adjust inputType / FunctionMapping.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_TOO_MANY_FUNCTION_PARAMETERS" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Positional arity rules.
    </see>
  </references>
</diag:BML_TOO_MANY_FUNCTION_PARAMETERS>
