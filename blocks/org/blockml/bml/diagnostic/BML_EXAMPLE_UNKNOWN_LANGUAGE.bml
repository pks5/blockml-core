<!--BlockML Core — BML_EXAMPLE_UNKNOWN_LANGUAGE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXAMPLE_UNKNOWN_LANGUAGE-->
<diag:BML_EXAMPLE_UNKNOWN_LANGUAGE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-example-language diagnostic
  </is>
  <summary>
    Emitted when example language= does not resolve to a Language block.
  </summary>
  <documentation>
    Emitted when example language= does not resolve to a Language block. Remedy: Use org.blockml.bml.language.*
    (implementation dialect for CDATA).
  </documentation>
  <keywords>
    <meta:Keyword value="BML_EXAMPLE_UNKNOWN_LANGUAGE" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      example language.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      language implicit NS.
    </see>
  </references>
</diag:BML_EXAMPLE_UNKNOWN_LANGUAGE>
