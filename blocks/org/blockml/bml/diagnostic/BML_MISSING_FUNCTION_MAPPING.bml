<!--BlockML Core — BML_MISSING_FUNCTION_MAPPING diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_FUNCTION_MAPPING-->
<diag:BML_MISSING_FUNCTION_MAPPING xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing FunctionMapping diagnostic
  </is>
  <summary>
    Reserved: emitted when an implementation requires a non-default FunctionMapping but none is declared.
  </summary>
  <documentation>
    Reserved: emitted when an implementation requires a non-default FunctionMapping but none
    is declared. Until custom mappings ship, treat as reserved. Default FunctionMapping covers
    V1 built-ins.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_MISSING_FUNCTION_MAPPING" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Custom FunctionMapping (optional).
    </see>
  </references>
</diag:BML_MISSING_FUNCTION_MAPPING>
