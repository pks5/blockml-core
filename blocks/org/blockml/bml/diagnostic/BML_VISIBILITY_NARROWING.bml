<!--BlockML Core — BML_VISIBILITY_NARROWING diagnostic

  FQN: org.blockml.bml.diagnostic.BML_VISIBILITY_NARROWING-->
<diag:BML_VISIBILITY_NARROWING xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A visibility-narrowing diagnostic
  </is>
  <summary>
    Emitted when an override reduces visibility (e.g. public → protected, or protected → private).
  </summary>
  <documentation>
    Override matching uses normalizedLogicalName. Widening (protected → public) is allowed; narrowing is forbidden. Private members cannot be overridden at all.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_VISIBILITY_NARROWING" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="AuthoringGuide">
      Visibility on override — widen only.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Override merge and visibility.
    </see>
    <see type="howto:FixVisibilityAccess" relation="Resolves">
      Widen or keep visibility on override.
    </see>
  </references>
</diag:BML_VISIBILITY_NARROWING>
