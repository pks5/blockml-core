<!--BlockML Core — BML_UNKNOWN_RELATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_RELATION-->
<diag:BML_UNKNOWN_RELATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-relation diagnostic
  </is>
  <summary>
    Emitted when see relation= does not resolve to org.blockml.bml.relation.*.
  </summary>
  <documentation>
    Emitted when see relation= does not resolve to org.blockml.bml.relation.*. Remedy: Use standard
    Relation blocks (SeeAlso, ReadFirst, …).
  </documentation>
  <keywords>
    <meta:Keyword value="BML_UNKNOWN_RELATION" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      relation attribute.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      relation implicit NS.
    </see>
  </references>
</diag:BML_UNKNOWN_RELATION>
