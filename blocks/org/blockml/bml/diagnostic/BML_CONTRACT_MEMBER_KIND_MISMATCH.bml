<!--BlockML Core — BML_CONTRACT_MEMBER_KIND_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONTRACT_MEMBER_KIND_MISMATCH-->
<diag:BML_CONTRACT_MEMBER_KIND_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A contract member-kind mismatch diagnostic
  </is>
  <summary>
    Emitted when a contract member kind does not match the merging member kind.
  </summary>
  <documentation>
    Emitted when a contract member kind does not match the merging member kind. Remedy: Property
    overrides property, aggregation overrides aggregation, etc.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_CONTRACT_MEMBER_KIND_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:ContractsModel" relation="AuthoringGuide">
      Contract merge.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Same kind required.
    </see>
    <see type="howto:FixMemberOverride" relation="Resolves">
      Align member kinds.
    </see>
  </references>
</diag:BML_CONTRACT_MEMBER_KIND_MISMATCH>
