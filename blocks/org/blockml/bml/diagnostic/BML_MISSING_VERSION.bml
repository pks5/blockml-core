<!--BlockML Core — BML_MISSING_VERSION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_VERSION-->
<diag:BML_MISSING_VERSION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-version diagnostic
  </is>
  <summary>
    Emitted when a Block has no effective version (own version and library.version both absent for an exported block).
  </summary>
  <documentation>
    Emitted when a Block has no effective version (own version and library.version both absent
    for an exported block). Remedy: Framework convention: version often only on Library.bml for
    org.blockml.bml.* exports.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_MISSING_VERSION" />
  </keywords>
  <references>
    <see type="doc:LibrarySystem" relation="AuthoringGuide">
      effectiveBlockVersion resolution.
    </see>
  </references>
</diag:BML_MISSING_VERSION>
