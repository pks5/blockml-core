<!--BlockML Core — BML_DUPLICATE_DOCUMENTATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_DOCUMENTATION-->
<diag:BML_DUPLICATE_DOCUMENTATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-documentation diagnostic
  </is>
  <summary>
    Emitted when documentation entries collide on (namespace, languageFqn).
  </summary>
  <documentation>
    Emitted when documentation entries collide on (namespace, languageFqn). Remedy: Keep one
    documentation entry per namespace/language pair.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_DUPLICATE_DOCUMENTATION" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      documentation i18n/facets.
    </see>
  </references>
</diag:BML_DUPLICATE_DOCUMENTATION>
