<!--BlockML Core — BML_CAPABILITY_LINK_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CAPABILITY_LINK_MISMATCH-->
<diag:BML_CAPABILITY_LINK_MISMATCH xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A capability-link mismatch diagnostic
  </is>
  <summary>
    Emitted when capability linking pairs incompatible Capability kinds or payloads.
  </summary>
  <documentation>
    Emitted when capability linking pairs incompatible Capability kinds or payloads. Remedy:
    Use Outbound→Inbound (or valid Transformation pairing) with compatible inputType/outputType.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_CAPABILITY_LINK_MISMATCH" />
  </keywords>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      Capability kinds.
    </see>
    <see type="doc:Expressions" relation="SeeAlso">
      Call vs link.
    </see>
    <see type="howto:FixExpressionErrors" relation="Resolves">
      Fix linking.
    </see>
  </references>
</diag:BML_CAPABILITY_LINK_MISMATCH>
