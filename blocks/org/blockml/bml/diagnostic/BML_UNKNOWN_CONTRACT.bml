<!--BlockML Core — BML_UNKNOWN_CONTRACT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_CONTRACT-->
<diag:BML_UNKNOWN_CONTRACT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown-contract diagnostic
  </is>
  <summary>
    Emitted when a &lt;contracts> entry does not resolve to a BlockDefinition.
  </summary>
  <documentation>
    Emitted when a &lt;contracts> entry does not resolve to a BlockDefinition. Remedy: Export
    the contract Block and fix the FQN/QName.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_UNKNOWN_CONTRACT" />
  </keywords>
  <references>
    <see type="doc:ContractsModel" relation="AuthoringGuide">
      contracts.
    </see>
    <see type="howto:DebugUnknownType" relation="Resolves">
      Unresolved type debugging.
    </see>
  </references>
</diag:BML_UNKNOWN_CONTRACT>
