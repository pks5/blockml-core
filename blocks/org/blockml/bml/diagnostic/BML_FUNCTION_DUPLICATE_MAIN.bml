<!--BlockML Core — BML_FUNCTION_DUPLICATE_MAIN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_FUNCTION_DUPLICATE_MAIN-->
<diag:BML_FUNCTION_DUPLICATE_MAIN xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-main-function diagnostic
  </is>
  <summary>
    Emitted when an OpenSCAD utility implementation declares more than one main function matching the Capability name.
  </summary>
  <documentation>
    Emitted when an OpenSCAD utility implementation declares more than one main function matching
    the Capability name. Remedy: Keep exactly one main function named like the Capability.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_FUNCTION_DUPLICATE_MAIN" />
  </keywords>
  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      utility Sub-Blocks.
    </see>
  </references>
</diag:BML_FUNCTION_DUPLICATE_MAIN>
