<!--BlockML Core — BML_UNKNOWN_TYPE_CONFIGURATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_TYPE_CONFIGURATION-->
<diag:BML_UNKNOWN_TYPE_CONFIGURATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    An unknown type-configuration diagnostic
  </is>
  <summary>
    Emitted when {...} instance configuration names a property that is not on the ValueType.
  </summary>
  <documentation>
    Emitted when {...} instance configuration names a property that is not on the ValueType.
    Remedy: Configuration keys must match effective Properties of the referenced ValueType.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_UNKNOWN_TYPE_CONFIGURATION" />
  </keywords>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      Instance configuration property names.
    </see>
  </references>
</diag:BML_UNKNOWN_TYPE_CONFIGURATION>
