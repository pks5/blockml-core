<!--BlockML Core — BML_DUPLICATE_CONTRACT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_CONTRACT-->
<diag:BML_DUPLICATE_CONTRACT xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A duplicate-contract diagnostic
  </is>
  <summary>
    Emitted when the same contract FQN appears more than once in &lt;contracts>.
  </summary>
  <documentation>
    Emitted when the same contract FQN appears more than once in &lt;contracts>. Remedy: List
    each contract at most once.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_DUPLICATE_CONTRACT" />
  </keywords>
  <references>
    <see type="doc:ContractsModel" relation="AuthoringGuide">
      contracts aggregation.
    </see>
  </references>
</diag:BML_DUPLICATE_CONTRACT>
