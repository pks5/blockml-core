<!--BlockML Core — BML_MIXED_TYPE_CONFIGURATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MIXED_TYPE_CONFIGURATION-->
<diag:BML_MIXED_TYPE_CONFIGURATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A mixed type-configuration diagnostic
  </is>
  <summary>
    Emitted when named and positional ValueType instance configuration are mixed in one {...} block.
  </summary>
  <documentation>
    Emitted when named and positional ValueType instance configuration are mixed in one {...}
    block. Remedy: Use either named key: value pairs or positional values by property declaration
    order — not both.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_MIXED_TYPE_CONFIGURATION" />
  </keywords>
  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      Named vs positional configuration.
    </see>
    <see type="doc:FunctionMappingModel" relation="SeeAlso">
      Shared declaration-order principle.
    </see>
  </references>
</diag:BML_MIXED_TYPE_CONFIGURATION>
