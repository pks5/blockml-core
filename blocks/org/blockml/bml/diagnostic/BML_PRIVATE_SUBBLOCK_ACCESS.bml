<!--BlockML Core — BML_PRIVATE_SUBBLOCK_ACCESS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PRIVATE_SUBBLOCK_ACCESS-->
<diag:BML_PRIVATE_SUBBLOCK_ACCESS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A private Sub-Block access diagnostic
  </is>
  <summary>
    Emitted when a private Sub-Block is referenced outside the immediately declaring Block definition.
  </summary>
  <documentation>
    Emitted when a private Sub-Block is referenced outside the immediately declaring Block definition.
    Remedy: Private Sub-Blocks (__Name) follow the same access model as private members — declaring
    Block only.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PRIVATE_SUBBLOCK_ACCESS" />
  </keywords>
  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      Sub-Block visibility and access diagnostics.
    </see>
    <see type="task:FixVisibilityAccess" relation="Resolves">
      Qualify access or widen Sub-Block visibility.
    </see>
  </references>
</diag:BML_PRIVATE_SUBBLOCK_ACCESS>
