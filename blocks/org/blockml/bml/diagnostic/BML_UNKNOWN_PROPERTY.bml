<!--
  BlockML Core — BML_UNKNOWN_PROPERTY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_PROPERTY
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_UNKNOWN_PROPERTY</name>
  <type>diag:BML_UNKNOWN_PROPERTY</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unknown-property diagnostic</is>

  <summary>Emitted when a property name cannot be resolved on the Block (non-expression site).</summary>

  <keywords>BML_UNKNOWN_PROPERTY</keywords>

  <documentation>
    The validator keys off the declared ValueType of the field, not the field name. Emitted when
    a value whose type is PropertyReference (or AggregationReference / AssociationReference /
    CapabilityReference) cannot be resolved
    on the Block (non-expression). PropertyIdentifier and MemberIdentifier (and not a Reference
    subtype) are syntax-only — an unknown but well-formed path is valid. Unresolved is an error,
    not proof the document is ill-formed — the member may be missing from a not-yet-loaded
    library. Remedy: Check member name, namespace, effective members after merge, and whether
    the owning type's library is on the current classpath.
  </documentation>

  <references>
    <see type="type:PropertyReference" relation="Defines">
      Existence-checked property path — this diagnostic applies here.
    </see>
    <see type="type:PropertyIdentifier" relation="ContrastsWith">
      Syntax-only property path — unknown name is valid.
    </see>
    <see type="doc:PartialMemberOverrides" relation="AuthoringGuide">
      Effective members.
    </see>
    <see type="task:FixMemberOverride" relation="SeeAlso">
      Merge issues.
    </see>
  </references>

</block>
