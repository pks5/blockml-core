<!--BlockML Core — BML_CONSTRAINT_INFORMATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_INFORMATION-->
<diag:BML_CONSTRAINT_INFORMATION xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A constraint-information diagnostic
  </is>
  <summary>
    Emitted when a constraint fails with validation=Information.
  </summary>
  <documentation>
    Emitted when a constraint fails with validation=Information. Remedy: Informational only —
    compilation continues.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_CONSTRAINT_INFORMATION" />
  </keywords>
  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Validation severity.
    </see>
    <see type="howto:AddConstraint" relation="Resolves">
      Adjust constraint or value.
    </see>
  </references>
</diag:BML_CONSTRAINT_INFORMATION>
