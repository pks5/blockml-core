<!--BlockML Core — BML_MISSING_EMBEDDED_BLOCK_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_EMBEDDED_BLOCK_TYPE-->
<diag:BML_MISSING_EMBEDDED_BLOCK_TYPE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing embedded-type diagnostic
  </is>
  <summary>
    Emitted when an embedded Block supplies neither a type tag nor a type child.
  </summary>
  <documentation>
    Type is required and fully qualified. Preferred authoring: the element tag is the type,
    same as the document root. Legacy: child &lt;type> under a &lt;block> wrapper
    (doc:DocumentFormat). FQN = resolve(type), not nested under the root.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="BML_MISSING_EMBEDDED_BLOCK_TYPE" />
  </keywords>
  <references>
    <see type="doc:DocumentFormat" relation="AuthoringGuide">
      Same tag-as-type authoring as the document root.
    </see>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      Embedded Block identity.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Type reference forms.
    </see>
    <see type="howto:FixTypeIdentity" relation="Resolves">
      Add fully qualified embedded type.
    </see>
  </references>
</diag:BML_MISSING_EMBEDDED_BLOCK_TYPE>
