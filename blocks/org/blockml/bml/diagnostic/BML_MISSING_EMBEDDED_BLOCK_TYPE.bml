<!--
  BlockML Core — BML_MISSING_EMBEDDED_BLOCK_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_EMBEDDED_BLOCK_TYPE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_MISSING_EMBEDDED_BLOCK_TYPE</name>
  <type>diag:BML_MISSING_EMBEDDED_BLOCK_TYPE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A missing embedded-type diagnostic</is>

  <summary>Emitted when an embedded Block supplies neither a type tag nor a type child.</summary>

  <keywords>BML_MISSING_EMBEDDED_BLOCK_TYPE</keywords>

  <documentation>
    Type is required and fully qualified. Preferred authoring: the element tag is the type,
    same as the document root. Legacy: child &lt;type&gt; under a &lt;block&gt; wrapper
    (doc:DocumentFormat). FQN = resolve(type), not nested under the root.
  </documentation>

  <references>
    <see type="doc:DocumentFormat" relation="AuthoringGuide">
      Same tag-as-type authoring as the document root.
    </see>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      Embedded Block identity.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="SeeAlso">
      Type reference forms.
    </see>
    <see type="task:FixTypeIdentity" relation="Resolves">
      Add fully qualified embedded type.
    </see>
  </references>

</block>
