<!--BlockML Core — BML_EXAMPLE_MISSING_TITLE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXAMPLE_MISSING_TITLE-->
<diag:BML_EXAMPLE_MISSING_TITLE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A missing-example-title diagnostic
  </is>
  <summary>
    Emitted when an example omits the required title.
  </summary>
  <documentation>
    Emitted when an example omits the required title. Remedy: Add title= on the example entry.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_EXAMPLE_MISSING_TITLE" />
  </keywords>
  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      examples.
    </see>
  </references>
</diag:BML_EXAMPLE_MISSING_TITLE>
