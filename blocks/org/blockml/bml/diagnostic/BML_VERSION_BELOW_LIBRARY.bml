<!--BlockML Core — BML_VERSION_BELOW_LIBRARY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_VERSION_BELOW_LIBRARY-->
<diag:BML_VERSION_BELOW_LIBRARY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A version-below-library diagnostic
  </is>
  <summary>
    Emitted when a Block version is below its exporting library.version policy.
  </summary>
  <documentation>
    Emitted when a Block version is below its exporting library.version policy. Remedy: Raise
    the Block version or align with library versioning conventions.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="BML_VERSION_BELOW_LIBRARY" />
  </keywords>
  <references>
    <see type="doc:LibrarySystem" relation="AuthoringGuide">
      Version resolution.
    </see>
  </references>
</diag:BML_VERSION_BELOW_LIBRARY>
