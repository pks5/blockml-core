<!--BlockML Core — BML_PRESET_CYCLE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PRESET_CYCLE-->
<diag:BML_PRESET_CYCLE xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A preset-cycle diagnostic
  </is>
  <summary>
    Domain: preset references form a cycle.
  </summary>
  <documentation>
    Domain: preset references form a cycle. Break the preset dependency cycle in domain presets.
    This diagnostic is emitted by domain validators; Core only catalogues the code.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_PRESET_CYCLE" />
  </keywords>
</diag:BML_PRESET_CYCLE>
