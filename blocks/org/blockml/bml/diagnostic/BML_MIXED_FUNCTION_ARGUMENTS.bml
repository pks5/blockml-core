<!--BlockML Core — BML_MIXED_FUNCTION_ARGUMENTS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MIXED_FUNCTION_ARGUMENTS-->
<diag:BML_MIXED_FUNCTION_ARGUMENTS xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    core:Diagnostic
  </baseType>
  <is>
    A mixed function-arguments diagnostic
  </is>
  <summary>
    Emitted when a Capability/function call mixes positional and named arguments under default FunctionMapping.
  </summary>
  <documentation>
    Emitted when a Capability/function call mixes positional and named arguments under default
    FunctionMapping. Remedy: Use positional-only, named-only, or a single object literal — not
    mixed forms.
  </documentation>
  <keywords>
    <meta:Keyword value="BML_MIXED_FUNCTION_ARGUMENTS" />
  </keywords>
  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Default FunctionMapping rules.
    </see>
    <see type="doc:Expressions" relation="SeeAlso">
      Expression call sites.
    </see>
  </references>
</diag:BML_MIXED_FUNCTION_ARGUMENTS>
