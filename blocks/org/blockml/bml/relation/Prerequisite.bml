<!--BlockML Core — prerequisite relation

  FQN: org.blockml.bml.relation.Prerequisite-->
<relation:Prerequisite xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <baseType>
    core:Relation
  </baseType>
  <is>
    A do-this-first Relation
  </is>
  <documentation>
    Use on &lt;see> entries at the start of a HowTo &lt;references> container
    — before HowToStep entries. Distinct from Requires (dependency of the current definition) and
    ReadFirst (library-wide learning path). Prerequisite scopes to one how-to procedure.
  </documentation>
</relation:Prerequisite>
