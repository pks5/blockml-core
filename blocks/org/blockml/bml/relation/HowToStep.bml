<!--BlockML Core — how-to step relation

  FQN: org.blockml.bml.relation.HowToStep-->
<relation:HowToStep xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <baseType>
    core:Relation
  </baseType>
  <is>
    A next-step Relation
  </is>
  <documentation>
    Use on &lt;see> entries inside org.blockml.bml.documentation.howto.* HowTo blocks.
    Document order in &lt;references> is step order — same convention as ReadFirst on README.
    Target may be a Block, repository markdown file, or external URL. Distinct from Prerequisite
    (before starting the how-to) and Requires (hard dependency on the current definition).
  </documentation>
</relation:HowToStep>
