<!--BlockML Core — resolves relation

  FQN: org.blockml.bml.relation.Resolves-->
<relation:Resolves xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <baseType>
    core:Relation
  </baseType>
  <is>
    A fixes-this-diagnostic Relation
  </is>
  <documentation>
    Use on &lt;see> entries in org.blockml.bml.diagnostic.* blocks to link a
    validator code to a procedural fix guide. Target should reference an org.blockml.bml.documentation.howto.*
    HowTo block. Enables error-driven navigation: reported BML_* code → Diagnostic block →
    Resolves → HowTo with HowToStep entries.
  </documentation>
</relation:Resolves>
