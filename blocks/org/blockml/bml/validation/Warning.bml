<!--BlockML Core — warning validation

  FQN: org.blockml.bml.validation.Warning-->
<validation:Warning xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation">

  <baseType>
    core:Validation
  </baseType>
  <is>
    A warning Validation severity
  </is>
  <documentation>
    When a constraint with validation="Warning" is violated, the BlockML
    validator emits BML_CONSTRAINT_WARNING. Compilation continues.
  </documentation>
</validation:Warning>
