<!--BlockML Core — information validation

  FQN: org.blockml.bml.validation.Information-->
<validation:Information xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation">

  <baseType>
    core:Validation
  </baseType>
  <is>
    An informational Validation severity
  </is>
  <documentation>
    When a constraint with validation="Information" is violated, the BlockML
    validator emits BML_CONSTRAINT_INFORMATION. Compilation continues.
  </documentation>
</validation:Information>
