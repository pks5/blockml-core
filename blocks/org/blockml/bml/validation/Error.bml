<!--BlockML Core — error validation

  FQN: org.blockml.bml.validation.Error-->
<validation:Error xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation">

  <baseType>
    core:Validation
  </baseType>
  <is>
    A failing Validation severity
  </is>
  <documentation>
    When a constraint with validation="Error" is violated, the BlockML
    validator emits BML_CONSTRAINT_VIOLATION and compilation fails.
  </documentation>
</validation:Error>
