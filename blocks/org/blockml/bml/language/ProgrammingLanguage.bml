<!--
  BlockML Core — ProgrammingLanguage branch (formal code languages)

  FQN: org.blockml.bml.language.ProgrammingLanguage
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lang="org.blockml.bml.language">

  <name>ProgrammingLanguage</name>
  <type>lang:ProgrammingLanguage</type>
  <baseType>core:Language</baseType>
  <is>A formal programming language</is>

  <documentation>Abstract branch for programming languages — TypeScript, OpenSCAD, PseudoCode, and
    other languages with defined or interpretable syntax. Generic parameter L (NaturalLanguage,
    default English) names the content/text language of the formal code — for example pseudocode
    prose, identifiers, or LLM-oriented wording.

    Concrete sub-types forward L via baseType ProgrammingLanguage(L) and redeclare it locally, so the
    parameter stays open on the sub-type — PseudoCode(German) is authorable and
    PseudoCode(NaturalLanguage) is usable as a type bound. Because L defaults to English, a bare
    sub-type name needs no argument: TypeScript ≡ TypeScript(English). Binding L in baseType instead
    (ProgrammingLanguage(lang:German)) fixes the content language for that sub-type and closes the
    parameter.</documentation>

  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="lang:English"/>
  </genericTypes>

  <abstract>true</abstract>

  <references>
    <see type="lang:NaturalLanguage" relation="Defines">
      L bound — content/text language of formal code (default English).
    </see>
    <see type="lang:English" relation="Defines">
      DefaultType for L when the content language is omitted.
    </see>
    <see type="lang:MarkupLanguage" relation="SeeAlso">
      Parallel formal-language branch with the same L parameter.
    </see>
    <see type="lang:PseudoCode" relation="SeeAlso">
      Typical consumer — free-form code whose prose language may be declared via L.
    </see>
    <see type="doc:TypeSystemOverview" relation="AuthoringGuide">
      Language branch and generics.
    </see>
  </references>

</block>
