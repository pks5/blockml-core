<!--BlockML Core — C implementation language

  FQN: org.blockml.bml.language.C-->
<lang:C xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The C programming language
  </is>
  <documentation>
    ProgrammingLanguage for C function implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare C is C(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English" />
  </genericTypes>
</lang:C>
