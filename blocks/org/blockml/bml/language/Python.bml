<!--BlockML Core — Python implementation language

  FQN: org.blockml.bml.language.Python-->
<lang:Python xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The Python programming language
  </is>
  <documentation>
    ProgrammingLanguage for Python function implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare Python is Python(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English" />
  </genericTypes>
</lang:Python>
