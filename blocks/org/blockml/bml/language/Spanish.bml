<!--BlockML Core — Spanish implementation language

  FQN: org.blockml.bml.language.Spanish-->
<lang:Spanish xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:NaturalLanguage
  </baseType>
  <is>
    The Spanish natural language
  </is>
  <documentation>
    Natural language for documentation prose, example titles, and Spanish
    natural-language capability implementations.
  </documentation>
</lang:Spanish>
