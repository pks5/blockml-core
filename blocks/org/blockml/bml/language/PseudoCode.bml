<!--BlockML Core — PseudoCode implementation language

  FQN: org.blockml.bml.language.PseudoCode-->
<lang:PseudoCode xmlns="http://blockml.org/bml"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The PseudoCode programming language
  </is>
  <documentation>
    ProgrammingLanguage for free-form pseudocode implementations. The code must be
    internally consistent but is otherwise unconstrained — an LLM may interpret it. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) — declare a content language only when
    the pseudocode prose is not English, directly on this language (PseudoCode(German)); bare
    PseudoCode is PseudoCode(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content language of the pseudocode prose. Forwarded from
        org.blockml.bml.language.ProgrammingLanguage — bare PseudoCode is
        PseudoCode(English).
      </documentation>
    </L>
  </genericTypes>
</lang:PseudoCode>
