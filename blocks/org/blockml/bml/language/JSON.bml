<!--
  BlockML Core — JSON implementation language

  FQN: org.blockml.bml.language.JSON
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <name>JSON</name>
  <type>lang:JSON</type>
  <baseType>lang:MarkupLanguage(L)</baseType>
  <is>The JSON markup language</is>

  <documentation>MarkupLanguage for JSON document implementations on Capabilities — configuration,
    structured data, or templates. Forwards MarkupLanguage.L (NaturalLanguage, default English) for
    the content/text language inside the document — bare JSON is JSON(English).</documentation>

  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="lang:English"/>
  </genericTypes>
</block>
