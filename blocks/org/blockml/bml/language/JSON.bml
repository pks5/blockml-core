<!--BlockML Core — JSON implementation language

  FQN: org.blockml.bml.language.JSON-->
<lang:JSON xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:MarkupLanguage(L)
  </baseType>
  <is>
    The JSON markup language
  </is>
  <documentation>
    MarkupLanguage for JSON document implementations on Capabilities — configuration,
    structured data, or templates. Forwards MarkupLanguage.L (NaturalLanguage, default English) for
    the content/text language inside the document — bare JSON is JSON(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content/text language inside the JSON body. Forwarded from
        org.blockml.bml.language.MarkupLanguage — bare JSON is JSON(English).
      </documentation>
    </L>
  </genericTypes>
</lang:JSON>
