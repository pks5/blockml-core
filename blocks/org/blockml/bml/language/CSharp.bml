<!--BlockML Core — C# implementation language

  FQN: org.blockml.bml.language.CSharp-->
<lang:CSharp xmlns="http://blockml.org/bml"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The C# programming language
  </is>
  <documentation>
    ProgrammingLanguage for C# method implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare CSharp is CSharp(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content language of identifiers and comments. Forwarded from
        org.blockml.bml.language.ProgrammingLanguage — bare CSharp is CSharp(English).
      </documentation>
    </L>
  </genericTypes>
</lang:CSharp>
