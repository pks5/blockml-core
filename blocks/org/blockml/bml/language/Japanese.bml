<!--BlockML Core — Japanese implementation language

  FQN: org.blockml.bml.language.Japanese-->
<lang:Japanese xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:NaturalLanguage
  </baseType>
