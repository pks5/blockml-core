<!--
  BlockML Core — XML implementation language

  FQN: org.blockml.bml.language.XML
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <name>XML</name>
  <type>lang:XML</type>
  <baseType>lang:MarkupLanguage(L)</baseType>
  <is>The XML markup language</is>

  <documentation>MarkupLanguage for XML document implementations on Capabilities — templates,
    configuration, or structured markup. Forwards MarkupLanguage.L (NaturalLanguage, default English)
    for the content/text language inside the markup — bare XML is XML(English).</documentation>

  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="lang:English"/>
  </genericTypes>
</block>
