<!--BlockML Core — XML implementation language

  FQN: org.blockml.bml.language.XML-->
<lang:XML xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:MarkupLanguage(L)
  </baseType>
  <is>
    The XML markup language
  </is>
  <documentation>
    MarkupLanguage for XML document implementations on Capabilities — templates,
    configuration, or structured markup. Forwards MarkupLanguage.L (NaturalLanguage, default English)
    for the content/text language inside the markup — bare XML is XML(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content/text language inside the markup. Forwarded from
        org.blockml.bml.language.MarkupLanguage — bare XML is XML(English).
      </documentation>
    </L>
  </genericTypes>
</lang:XML>
