<!--BlockML Core — BML implementation language

  FQN: org.blockml.bml.language.BML-->
<lang:BML xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:MarkupLanguage(L)
  </baseType>
  <is>
    The BlockML markup language
  </is>
  <documentation>
    MarkupLanguage for BlockML (BML) document implementations on Capabilities — block
    definitions, library catalogs, and other structured BML markup. Forwards MarkupLanguage.L
    (NaturalLanguage, default English) for the content/text language inside the BML body — bare BML
    is BML(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English" />
  </genericTypes>
</lang:BML>
