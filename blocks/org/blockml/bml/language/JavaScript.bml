<!--
  BlockML Core — JavaScript implementation language

  FQN: org.blockml.bml.language.JavaScript
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <name>JavaScript</name>
  <type>lang:JavaScript</type>
  <baseType>lang:ProgrammingLanguage(L)</baseType>
  <is>The JavaScript programming language</is>

  <documentation>ProgrammingLanguage for JavaScript function implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare JavaScript is JavaScript(English).</documentation>

  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="lang:English"/>
  </genericTypes>
</block>
