<!--BlockML Core — JavaScript implementation language

  FQN: org.blockml.bml.language.JavaScript-->
<lang:JavaScript xmlns="http://blockml.org/bml"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The JavaScript programming language
  </is>
  <documentation>
    ProgrammingLanguage for JavaScript function implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare JavaScript is JavaScript(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content language of identifiers and comments. Forwarded from
        org.blockml.bml.language.ProgrammingLanguage — bare JavaScript is
        JavaScript(English).
      </documentation>
    </L>
  </genericTypes>
</lang:JavaScript>
