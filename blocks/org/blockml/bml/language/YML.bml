<!--BlockML Core — YML implementation language

  FQN: org.blockml.bml.language.YML-->
<lang:YML xmlns="http://blockml.org/bml"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:MarkupLanguage(L)
  </baseType>
  <is>
    The YAML markup language
  </is>
  <documentation>
    MarkupLanguage for YAML document implementations on Capabilities — configuration,
    structured data, or templates. Forwards MarkupLanguage.L (NaturalLanguage, default English) for
    the content/text language inside the document — bare YML is YML(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content/text language inside the YAML body. Forwarded from
        org.blockml.bml.language.MarkupLanguage — bare YML is YML(English).
      </documentation>
    </L>
  </genericTypes>
</lang:YML>
