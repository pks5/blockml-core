<!--BlockML Core — OpenSCAD implementation language

  FQN: org.blockml.bml.language.OpenSCAD-->
<lang:OpenSCAD xmlns="http://blockml.org/bml"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The OpenSCAD programming language
  </is>
  <documentation>
    ProgrammingLanguage for OpenSCAD function implementations on Capabilities.
    Emitted by the MachineBlocks SCAD renderer with FQN-prefixed function names. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare OpenSCAD is OpenSCAD(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content language of identifiers and comments. Forwarded from
        org.blockml.bml.language.ProgrammingLanguage — bare OpenSCAD is
        OpenSCAD(English).
      </documentation>
    </L>
  </genericTypes>
</lang:OpenSCAD>
