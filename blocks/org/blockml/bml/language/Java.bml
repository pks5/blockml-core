<!--BlockML Core — Java implementation language

  FQN: org.blockml.bml.language.Java-->
<lang:Java xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The Java programming language
  </is>
  <documentation>
    ProgrammingLanguage for Java method implementations on Capabilities. Forwards
    ProgrammingLanguage.L (NaturalLanguage, default English) for the content language of identifiers
    and comments — bare Java is Java(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English" />
  </genericTypes>
</lang:Java>
