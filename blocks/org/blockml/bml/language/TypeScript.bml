<!--BlockML Core — TypeScript implementation language

  FQN: org.blockml.bml.language.TypeScript-->
<lang:TypeScript xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:ProgrammingLanguage(L)
  </baseType>
  <is>
    The TypeScript programming language
  </is>
  <documentation>
    ProgrammingLanguage for TypeScript arrow-function implementations on Capabilities.
    V1: compile-time execution when all arguments are literals. Forwards ProgrammingLanguage.L
    (NaturalLanguage, default English) for the content language of identifiers and comments — bare
    TypeScript is TypeScript(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English" />
  </genericTypes>
</lang:TypeScript>
