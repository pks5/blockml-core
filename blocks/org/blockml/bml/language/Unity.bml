<!--BlockML Core — Unity implementation language

  FQN: org.blockml.bml.language.Unity-->
<lang:Unity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <baseType>
    lang:CSharp(L)
  </baseType>
  <is>
    The Unity C# programming language
  </is>
  <documentation>
    C# dialect for Unity script implementations on Capabilities — MonoBehaviour methods,
    UnityEngine APIs, and game-logic code. Forwards L on through CSharp (NaturalLanguage, default
    English) for the content language of identifiers and comments — bare Unity is
    Unity(English).
  </documentation>
  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="org.blockml.bml.language.English">
      <documentation>
        Content language of identifiers and comments. Forwarded from
        org.blockml.bml.language.CSharp — bare Unity is Unity(English).
      </documentation>
    </L>
  </genericTypes>
</lang:Unity>
