<!--BlockML Core — draft status

  FQN: org.blockml.bml.status.Draft-->
<status:Draft xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:status="org.blockml.bml.status">

  <baseType>
    core:Status
