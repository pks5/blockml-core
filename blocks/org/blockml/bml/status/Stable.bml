<!--BlockML Core — stable status

  FQN: org.blockml.bml.status.Stable-->
<status:Stable xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:status="org.blockml.bml.status">

  <baseType>
    core:Status
  </baseType>
  <is>
    A complete-and-reliable Status
  </is>
  <documentation>
    Implemented, validated, and mapping complete. Behavior is reliable and may be
    depended on by downstream definitions and tooling. Implicit default when no status is declared
    on an element — omit &lt;status> and bml:status on Stable content.
  </documentation>
</status:Stable>
