<!--BlockML Core — debug unknown type how-to

  FQN: org.blockml.bml.documentation.howto.DebugUnknownType-->
<howto:DebugUnknownType xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    howto:HowTo
  </baseType>
  <is>
    A how-to for fixing unknown types
  </is>
  <summary>
    Verify FQN spelling, xmlns prefix resolution, Library blocks membership, and bootstrap
    load order so the referenced type is registered in TypeRegistry before validation.
  </summary>
  <documentation>
    Procedure when the validator reports BML_UNKNOWN_TYPE:
    1. Locate the field whose declared type is TypeReference or TypeReferenceEntity (or a
       subtype). The XML name of the field does not matter. Fields typed TypeIdentifier
       (and not TypeReference) do not emit this diagnostic.
    2. Confirm the expanded FQN matches a registered BlockDefinition — or treat the finding as
       a missing dependency (library not loaded), not as proof the document is ill-formed.
    3. Check xmlns prefix maps to the intended namespace on this document.
    4. Confirm the defining block is listed in Library blocks when loaded via a library.
    5. Verify dependency libraries and bootstrap order load the defining catalogue first.
  </documentation>
  <keywords>
    <blockml:meta.Keyword value="BML_UNKNOWN_TYPE" />
    <blockml:meta.Keyword value="unknown type" />
    <blockml:meta.Keyword value="unresolved FQN" />
    <blockml:meta.Keyword value="TypeRegistry" />
    <blockml:meta.Keyword value="bootstrap" />
  </keywords>
  <references>
    <see type="diag:BML_UNKNOWN_TYPE" relation="SeeAlso">
      Diagnostic block for this error code — entry point from validator output.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="HowToStep">
      Step 1 — verify xmlns prefix and implicit namespace resolution at the reference site.
    </see>
    <see type="doc:LibrarySystem" relation="HowToStep">
      Step 2 — confirm Library blocks exports the defining type.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="HowToStep">
      Step 3 — check type reference forms (FQN, QName, Sub-Block-relative, nested resolution).
    </see>
    <see type="doc:BootstrapModel" relation="HowToStep">
      Step 4 — confirm TypeRegistry bootstrap loaded dependencies before this document.
    </see>
    <see type="howto:FixTypeIdentity" relation="SeeAlso">
      Related — identity mismatches when the type exists but the form is wrong.
    </see>
  </references>
</howto:DebugUnknownType>
