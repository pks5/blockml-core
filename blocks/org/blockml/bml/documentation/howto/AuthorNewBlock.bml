<!--BlockML Core — author new block how-to

  FQN: org.blockml.bml.documentation.howto.AuthorNewBlock-->
<howto:AuthorNewBlock xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:relation="org.blockml.bml.relation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    howto:HowTo
  </baseType>
  <is>
    A how-to for authoring a new Block
  </is>
  <summary>
    Create a root .bml file whose root tag is the type, with is, documentation,
    baseType, version, and member containers as needed. Register the block FQN in Library
    blocks when publishing a library catalogue.
  </summary>
  <documentation>
    Procedure for a new domain Block type:
    1. Choose baseType from the framework or domain branch.
    2. Author the document root as the type tag (doc:DocumentFormat). Nested Sub-Blocks use
       the unqualified name as the element tag; embeds use the same tag-as-type form as the
       root. Legacy &lt;block> wrappers remain valid. Declare documentation metadata
       (is, documentation, optional summary).
    3. Add properties, aggregations, associations, or capabilities.
    4. Add constraints, capabilities, and examples as needed.
    5. Export via Library.bml blocks when the type belongs to a published catalogue.
  </documentation>
  <keywords>
    <meta:Keyword value="author" />
    <meta:Keyword value="new block" />
    <meta:Keyword value="create type" />
    <meta:Keyword value="scaffold" />
    <meta:Keyword value="root block" />
  </keywords>
  <references>
    <see type="doc:DocumentFormat" relation="Prerequisite">
      Type/name as element tag on root, Sub-Blocks, and embeds.
    </see>
    <see type="doc:DefinitionModel" relation="Prerequisite">
      Understand is, members, and documentation extensions before authoring.
    </see>
    <see type="def:RootBlockDefinition" relation="HowToStep">
      Step 1 — inspect the root block definition meta-model shape.
    </see>
    <see type="doc:DocumentationModel" relation="HowToStep">
      Step 2 — identity order, is, documentation, type references.
    </see>
    <see type="core:Block" relation="HowToStep">
      Step 3 — pick baseType and declare member containers.
    </see>
    <see type="doc:ModelingGuidelines" relation="HowToStep">
      Step 4 — choose baseType vs contracts and model members consistently.
    </see>
    <see type="blockml:Library" relation="HowToStep">
      Step 5 — add the block FQN to Library blocks for export.
    </see>
  </references>
</howto:AuthorNewBlock>
