<!--BlockML Core — fix composition placement how-to

  FQN: org.blockml.bml.documentation.howto.FixCompositionPlacement-->
<howto:FixCompositionPlacement xmlns="http://blockml.org/bml"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    howto:HowTo
  </baseType>
  <is>
    A how-to for fixing composition placement
  </is>
  <summary>
    Resolve standalone composition errors and clarify definition vs instance aggregation
    fill, including bml:container and bml:with usage.
  </summary>
  <documentation>
    Procedure when composition placement fails validation:
    1. On Block definitions — nest &lt;composition> inside an aggregation member element; never
       leave it standalone (BML_STANDALONE_COMPOSITION).
    2. On Block instances — always open aggregations by member name; no composition wrapper
       and no default aggregation. Bare child Block instances directly under the parent
       instance are invalid. Same rule as Properties: do not wrap instance values in
       &lt;value> (doc:MemberAuthoring).
    3. Inherited aggregation fill — use override="true"; omit unchanged type.
    4. Shared sibling values — bml:with on composition or bml:container (see doc:BmlDirectives).
    5. Instance ID reachability — follows aggregation member visibility (doc:MemberVisibility).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.Keyword value="composition" />
    <org.blockml.bml.meta.Keyword value="aggregation" />
    <org.blockml.bml.meta.Keyword value="BML_STANDALONE_COMPOSITION" />
    <org.blockml.bml.meta.Keyword value="bml:container" />
  </keywords>
  <references>
    <see type="doc:MemberAuthoring" relation="HowToStep">
      Step 0 — definition fields vs instance payloads for Properties and Aggregations.
    </see>
    <see type="doc:CompositionModel" relation="HowToStep">
      Step 1 — unified container concept and placement rules.
    </see>
    <see type="doc:BmlDirectives" relation="HowToStep">
      Step 2 — bml:container, bml:with, bml:each on composition.
    </see>
    <see type="doc:PartialMemberOverrides" relation="HowToStep">
      Step 3 — inherited aggregation overrides.
    </see>
    <see type="diag:BML_STANDALONE_COMPOSITION" relation="SeeAlso">
      Diagnostic for composition outside an aggregation member.
    </see>
  </references>
</howto:FixCompositionPlacement>
