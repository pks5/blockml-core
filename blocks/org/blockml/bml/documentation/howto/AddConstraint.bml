<!--BlockML Core — add constraint how-to

  FQN: org.blockml.bml.documentation.howto.AddConstraint-->
<howto:AddConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:relation="org.blockml.bml.relation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    howto:HowTo
  </baseType>
  <is>
    A how-to for attaching Constraints
  </is>
  <summary>
    Declare a constraints container on a ConstrainableDefinition element and add a Constraint
    reference as a direct child. The embedding context binds the constraint target automatically —
    no target property in BML.
  </summary>
  <documentation>
    Procedure for adding a constraint:
    1. Confirm the definition element extends ConstrainableDefinition (Block or member).
    2. Add a constraints container if absent.
    3. Insert a Constraint Block reference (element name = FQN via xmlns prefix).
    4. Optionally attach a validation reference on the constraint instance for rule enforcement.
    5. Run the validator — BML_CONSTRAINT_TARGET_MISMATCH when branch compatibility fails.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="constraint" />
    <org.blockml.bml.meta.FreeTextKeyword term="validation" />
    <org.blockml.bml.meta.FreeTextKeyword term="Min" />
    <org.blockml.bml.meta.FreeTextKeyword term="Max" />
    <org.blockml.bml.meta.FreeTextKeyword term="Pattern" />
    <org.blockml.bml.meta.FreeTextKeyword term="member constraint" />
  </keywords>
  <references>
    <see type="doc:DefinitionModel" relation="Prerequisite">
      Understand member containers and definition metadata first.
    </see>
    <see type="def:ConstrainableDefinition" relation="HowToStep">
      Step 1 — confirm the target element supports a constraints container.
    </see>
    <see type="doc:ConstraintsModel" relation="HowToStep">
      Step 2 — choose constraint branch and target binding rules.
    </see>
    <see type="constraint:Min" relation="HowToStep">
      Step 3 — pick a concrete constraint block (Min, Max, Pattern, RequiresMember, …).
    </see>
    <see type="core:Validation" relation="HowToStep">
      Step 4 — optionally wire validation for enforced rules.
    </see>
  </references>
</howto:AddConstraint>
