<!--BlockML Core — fix visibility access how-to

  FQN: org.blockml.bml.documentation.howto.FixVisibilityAccess-->
<howto:FixVisibilityAccess xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    howto:HowTo
  </baseType>
  <is>
    A how-to for fixing visibility errors
  </is>
  <summary>
    Resolve private/protected member or Sub-Block access errors, visibility mismatches,
    narrowing on override, and duplicate visibility-prefix variants.
  </summary>
  <documentation>
    Procedure when the validator reports a visibility-related BML_* code:
    1. Identify whether the site is a member or a Sub-Block (same naming convention).
    2. Confirm the intended visibility via name prefix: public / _protected / __private.
    3. For access errors — move the use into an allowed context (declaring Block, inheritance,
       immediate composition owner for protected) or widen the declaration if appropriate.
    4. For override narrowing — keep or widen visibility; never narrow; private cannot be overridden.
    5. For duplicate variants — keep exactly one normalizedLogicalName with one visibility.
    6. For root-level &lt;visibility> on a root Block — remove it (Sub-Blocks only).
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="visibility" />
    <org.blockml.bml.meta.FreeTextKeyword term="private" />
    <org.blockml.bml.meta.FreeTextKeyword term="protected" />
    <org.blockml.bml.meta.FreeTextKeyword term="BML_PRIVATE_MEMBER_ACCESS" />
    <org.blockml.bml.meta.FreeTextKeyword term="BML_VISIBILITY_NARROWING" />
  </keywords>
  <references>
    <see type="doc:MemberVisibility" relation="HowToStep">
      Step 1 — member access rules and formal D/C/I/O table.
    </see>
    <see type="doc:SubBlockModel" relation="HowToStep">
      Step 2 — Sub-Block visibility and reference scope.
    </see>
    <see type="doc:PartialMemberOverrides" relation="HowToStep">
      Step 3 — visibility widening on override.
    </see>
    <see type="diag:BML_PRIVATE_MEMBER_ACCESS" relation="SeeAlso">
      Example diagnostic resolved by this how-to.
    </see>
    <see type="diag:BML_VISIBILITY_NARROWING" relation="SeeAlso">
      Narrowing on override.
    </see>
  </references>
</howto:FixVisibilityAccess>
