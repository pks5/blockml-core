    <org.blockml.bml.meta.FreeTextKeyword term="value" />
    <org.blockml.bml.meta.FreeTextKeyword term="composition" />
    <org.blockml.bml.meta.FreeTextKeyword term="property" />
    <org.blockml.bml.meta.FreeTextKeyword term="aggregation" />
    <org.blockml.bml.meta.FreeTextKeyword term="instance" />
    <org.blockml.bml.meta.FreeTextKeyword term="definition" />
    <org.blockml.bml.meta.FreeTextKeyword term="member authoring" />
    <org.blockml.bml.meta.FreeTextKeyword term="default aggregation" />
  </keywords>
