    </see>
    <see type="diag:BML_INVALID_PROPERTY_TYPE" relation="SeeAlso">
      Non-ValueType used where a ValueType is required.
    </see>
    <see type="core:ValueType" relation="SeeAlso">
      Top of the assignability hierarchy — ValueType[] accepts any collection of values.
    </see>
    <see type="type:StructType" relation="SeeAlso">
      Named StructType branch — anonymous { field: Type } is its unnamed type-expression form.
    </see>
    <see type="type:EmptyStruct" relation="SeeAlso">
      Named instantiable empty StructType — counterpart of anonymous {}.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
