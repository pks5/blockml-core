<!--BlockML Core — fix type identity task

  FQN: org.blockml.bml.task.FixTypeIdentity-->
<task:FixTypeIdentity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <baseType>
    core:TaskGuide
  </baseType>
  <is>
    A how-to for fixing type identity errors
  </is>
  <summary>
    Resolve root/Sub-Block/embedded identity mismatches, ambiguous or unqualified references,
    and definition-role errors.
  </summary>
  <documentation>
    Procedure when type identity or reference resolution fails:
    1. Classify the Block role — root, Sub-Block, or embedded virtual file.
    2. Root — require type from the element tag (preferred) or child &lt;type> (legacy
       &lt;block>); optional name must equal lastSegment(resolve(type)).
    3. Sub-Block — require name from the element tag (preferred &lt;MyBlock>) or child
       &lt;name> (legacy &lt;block>); omit type or match parentType + "." + name from the
       immediate enclosing block; never declare embeddedBlocks.
    4. Embedded — same authoring as the root: type from the element tag or child &lt;type>;
       type must be fully qualified; FQN is not nested under the root; no nested embeds.
    5. Unqualified names — use nested resolution (innermost first) or context-bound implicit
       namespace; grandchildren need a relative path; otherwise qualify with xmlns/FQN.
    6. Ambiguous short Sub-Block names that match the root — rename or use qualified references.
  </documentation>
  <keywords>
    <org.blockml.bml.meta.FreeTextKeyword term="type identity" />
    <org.blockml.bml.meta.FreeTextKeyword term="Sub-Block" />
    <org.blockml.bml.meta.FreeTextKeyword term="embedded" />
    <org.blockml.bml.meta.FreeTextKeyword term="BML_SUBBLOCK_TYPE_MISMATCH" />
    <org.blockml.bml.meta.FreeTextKeyword term="BML_AMBIGUOUS_TYPE" />
  </keywords>
  <references>
    <see type="doc:DocumentFormat" relation="TaskStep">
      Step 1 — element tag vs legacy &lt;block> on root, Sub-Block, and embed.
    </see>
    <see type="doc:TypeIdentityDerivation" relation="TaskStep">
      Step 2 — four reference forms and canonical derivation summary.
    </see>
    <see type="doc:SubBlockModel" relation="TaskStep">
      Step 3 — Sub-Block vs Embedded vs Root rules.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="TaskStep">
      Step 4 — context-bound unqualified sites.
    </see>
    <see type="doc:BlockNameConvention" relation="TaskStep">
      Step 5 — PascalCase name format.
    </see>
    <see type="diag:BML_SUBBLOCK_TYPE_MISMATCH" relation="SeeAlso">
      Example Sub-Block identity diagnostic.
    </see>
    <see type="diag:BML_AMBIGUOUS_TYPE" relation="SeeAlso">
      Ambiguous unqualified type name.
    </see>
    <see type="task:DebugUnknownType" relation="SeeAlso">
      Related task when the type is simply not registered.
    </see>
  </references>
</task:FixTypeIdentity>
