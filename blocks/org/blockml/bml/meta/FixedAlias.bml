<!--BlockML Core — fixed catalogue alias

  FQN: org.blockml.bml.meta.FixedAlias-->
<meta:FixedAlias xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    meta:Alias
  </baseType>
  <is>
    A catalogue-fixed alternative name
  </is>
  <documentation>
    Abstract catalogue freeze of org.blockml.bml.meta.Alias. Domain libraries declare concrete
    alias blocks extending FixedAlias and set inherited members on the type definition
    (for example &lt;value>Sub-Block&lt;/value>). References in &lt;aliases> are empty fixed
    blocks (for example &lt;vocab:SubBlockAlias />) — type FQN is the catalogue identity; value,
    language, and legacy resolve from the alias definition and are readOnly at reference sites.
    
    Concrete children must set value on the definition (value is abstract here). They do not
    redeclare the member unless the declaration itself changes. Comma-separated shorthand on
    &lt;aliases> expands to Alias instances — not to FixedAlias or its catalogue descendants.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="meta:Alias" relation="Extends">
      Instantiable PrimitiveEntity(Text) — ad-hoc names and sugar target.
    </see>
  </references>
  <properties>
    <value override="true" abstract="true" readOnly="true" bml:xml="element">
      <documentation>
        Required alternative name text — set on each concrete alias block definition.
        readOnly forbids instance writes at &lt;aliases> reference sites.
      </documentation>
    </value>
    <language override="true" readOnly="true" bml:xml="element">
      <documentation>
        Optional NaturalLanguage — set on the alias block definition. readOnly at
        &lt;aliases> reference sites.
      </documentation>
    </language>
    <legacy override="true" readOnly="true" bml:xml="element">
      <documentation>
        Optional legacy flag — set on the alias block definition. readOnly at
        &lt;aliases> reference sites. Default false when omitted.
      </documentation>
    </legacy>
  </properties>
</meta:FixedAlias>
