<!--BlockML Core — fixed catalogue keyword

  FQN: org.blockml.bml.meta.FixedKeyword-->
<meta:FixedKeyword xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:meta="org.blockml.bml.meta">

  <baseType>
    meta:Keyword
  </baseType>
  <is>
    A catalogue-fixed search tag
  </is>
  <documentation>
    Abstract catalogue freeze of org.blockml.bml.meta.Keyword. Domain libraries declare concrete
    keyword blocks extending FixedKeyword and set inherited members on the type definition
    (for example &lt;value>inheritance&lt;/value>). References in &lt;keywords> are empty fixed
    blocks (for example &lt;vocab:Inheritance />) — type FQN is the catalogue identity; value,
    language, and weight resolve from the keyword definition and are readOnly at reference sites.
    
    Concrete children must set value on the definition (value is abstract here). They do not
    redeclare the member unless the declaration itself changes. Comma-separated shorthand on
    &lt;keywords> expands to Keyword instances — not to FixedKeyword or its catalogue descendants.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="meta:Keyword" relation="Extends">
      Instantiable PrimitiveEntity(Text) — ad-hoc tags and sugar target.
    </see>
  </references>
  <properties>
    <value override="true" abstract="true" readOnly="true" bml:xml="element">
      <documentation>
        Required search tag text — set on each concrete keyword block definition.
        readOnly forbids instance writes at &lt;keywords> reference sites.
      </documentation>
    </value>
    <language override="true" readOnly="true" bml:xml="element">
      <documentation>
        Optional NaturalLanguage — set on the keyword block definition. readOnly at
        &lt;keywords> reference sites.
      </documentation>
    </language>
    <weight override="true" readOnly="true" bml:xml="element">
      <documentation>
        Optional RAG ranking hint — set on the keyword block definition. readOnly at
        &lt;keywords> reference sites.
      </documentation>
    </weight>
  </properties>
</meta:FixedKeyword>
