<!--BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.bml.core.Capability-->
<cap:Inbound xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    An inbound behaviour endpoint
  </is>
  <documentation>
    Inbound capability.
  </documentation>
  <properties>
    <_hasInput override="true">
      <value>true</value>
    </_hasInput>
  </properties>
</cap:Inbound>
