<!--BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.bml.core.Capability-->
<cap:Transformation xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    A value-transforming Capability
  </is>
  <documentation>
    Transformation capability.
  </documentation>
  <properties>
    <_hasInput override="true">
      <value>true</value>
    </_hasInput>
    <_hasOutput override="true">
      <value>true</value>
    </_hasOutput>
  </properties>
</cap:Transformation>
