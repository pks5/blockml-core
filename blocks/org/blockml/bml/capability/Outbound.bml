<!--BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.bml.core.Capability-->
<cap:Outbound xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    An outbound behaviour endpoint
  </is>
  <documentation>
    Outbound capability.
  </documentation>
  <properties>
    <_hasOutput override="true">
      <value>true</value>
    </_hasOutput>
  </properties>
</cap:Outbound>
