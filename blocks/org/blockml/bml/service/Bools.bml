<!--BlockML Core Services

  Name: Bools Service
  Filename: Bools.bml
  FQN: org.blockml.bml.service.Bools
  Expression prefix: #bools.*-->
<service:Bools xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:service="org.blockml.bml.service"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Entity
  </baseType>
  <is>
    A boolean expression service
  </is>
  <documentation>
    Built-in booleans service. Expression prefix #bools.* — logical and boolean
    conversion utilities.
  </documentation>
  <capabilities>
    <!--#bools.isTrue(x)-->
    <isTrue type="cap:Transformation" inputType="type:Boolean" outputType="type:Boolean">
      <documentation>
        Returns true if x is strictly true.
        Examples:
        #bools.isTrue(true) → true
        #bools.isTrue(1) → false
      </documentation>
      <implementation language="lang:TypeScript">
        <![CDATA[(x: boolean): boolean => x === true]]>
      </implementation>
    </isTrue>
    <!--#bools.isFalse(x)-->
    <isFalse type="cap:Transformation" inputType="type:Boolean" outputType="type:Boolean">
      <documentation>
        Returns true if x is strictly false.
        Examples:
        #bools.isFalse(false) → true
        #bools.isFalse(0) → false
      </documentation>
      <implementation language="lang:TypeScript">
        <![CDATA[(x: boolean): boolean => x === false]]>
      </implementation>
    </isFalse>
  </capabilities>
</service:Bools>
