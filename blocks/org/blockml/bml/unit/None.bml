<!--BlockML Core — dimensionless / no unit

  FQN: org.blockml.bml.unit.None-->
<unit:None xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:unit="org.blockml.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    No unit of measure
  </is>
  <documentation>
    Dimensionless Unit — use when a value has no associated unit of measure.
  </documentation>
</unit:None>
