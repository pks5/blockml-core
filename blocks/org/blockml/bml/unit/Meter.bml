<!--BlockML Core — meter length unit

  FQN: org.blockml.bml.unit.Meter-->
<unit:Meter xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:unit="org.blockml.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    Meter (m)
  </is>
  <documentation>
    Length unit — meter (m).
  </documentation>
</unit:Meter>
