<!--BlockML Core — millimeter length unit

  FQN: org.blockml.bml.unit.Millimeter-->
<unit:Millimeter xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:unit="org.blockml.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    Millimeter (mm)
  </is>
  <documentation>
    Length unit — millimeter (mm).
  </documentation>
</unit:Millimeter>
