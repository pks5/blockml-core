<type:Integer xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit">

  <baseType>
    type:Number(N)
  </baseType>
  <is>
    A whole number
  </is>
  <documentation>
    BOM Core primitive ValueType for whole numbers. Unqualified name Integer resolves
    to org.blockml.bml.type.Integer. Extends org.blockml.bml.type.Number. Payload values are stored on
    Properties — not on the Integer type itself.
    
    Generic parameter N (Unit, default unit:None) is forwarded from Number — e.g.
    Integer(unit:Millimeter). Bare Integer is dimensionless.
    
    Optional configuration Properties (min, max) configure a Property's owned Integer instance via
    inline type syntax — Integer{min: 0, max: 100}. Positional order: min, max. See
    20_value_type_instance_configuration.md. min/max are applied after parseValue
    (doc:ValueTypeParsing).
  </documentation>
  <genericTypes>
    <N baseType="core:Unit" defaultType="org.blockml.bml.unit.None" />
  </genericTypes>
  <properties>
    <min type="type:Integer">
      <documentation>
        Minimum allowed value (inclusive). Configured via Integer{min: n}.
      </documentation>
    </min>
    <max type="type:Integer">
      <documentation>
        Maximum allowed value (inclusive). Configured via Integer{max: n}.
      </documentation>
    </max>
  </properties>
  <capabilities>
    <parseValue override="true" type="org.blockml.bml.capability.Transformation" inputType="type:Text" outputType="bml:Self">
      <throws>
        <ex:InvalidValueException />
      </throws>
      <documentation>
        Whole-number literal — optional sign, then digits with no fraction or exponent.
        min/max configuration is applied after parse.
      </documentation>
      <implementation language="org.blockml.bml.language.TypeScript">
        <![CDATA[
        (raw: string): number => {
          const t = raw.trim();
          if (!/^[+-]?\d+$/.test(t)) {
            throw new Error("not a whole number: " + raw);
          }
          const n = Number(t);
          if (!Number.isSafeInteger(n)) {
            throw new Error("integer out of safe range: " + raw);
          }
          return n;
        }
        ]]>
      </implementation>
    </parseValue>
  </capabilities>
</type:Integer>
