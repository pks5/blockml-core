<type:MimeTypeEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:MimeType)
  </baseType>
  <is>
    A MIME type as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a MimeType primitive. Binds T = MimeType on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:MimeTypeEntity>
