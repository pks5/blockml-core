<type:AggregationReferenceEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:AggregationReference(B))
  </baseType>
  <is>
    A path to an Aggregation member as a PrimitiveEntity
  </is>
  <documentation>
    Open generic Entity wrapping an AggregationReference primitive. Forwards B from
    org.blockml.bml.type.AggregationReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : AggregationReference(B). Use when a
    resolved aggregation path must appear as an identifiable Block instance. Syntax-only paths use
    AggregationIdentifierEntity.
  </documentation>
  <genericTypes>
    <B baseType="core:Block" defaultType="org.blockml.bml.core.Block">
      <documentation>
        Owning Block branch — mirrored from AggregationReference.B. Checked after
        resolution.
      </documentation>
    </B>
  </genericTypes>
</type:AggregationReferenceEntity>
