<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>CapabilityReferenceEntity</name>
  <type>type:CapabilityReferenceEntity</type>
  <baseType>core:PrimitiveEntity(type:CapabilityReference(B))</baseType>
  <is>A path to a Capability member as an Entity</is>

  <documentation>Open generic Entity wrapping a CapabilityReference primitive. Forwards B from
    org.blockml.bml.type.CapabilityReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : CapabilityReference(B). Use when a
    resolved capability path must appear as an identifiable Block instance. Syntax-only paths use
    CapabilityIdentifierEntity.</documentation>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — mirrored from CapabilityReference.B. Checked after
        resolution.</documentation>
    </B>
  </genericTypes>
</block>
