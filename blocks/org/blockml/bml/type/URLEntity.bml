<type:URLEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:URL)
  </baseType>
  <is>
    A web address as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a URL primitive. Binds T = URL on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:URLEntity>
