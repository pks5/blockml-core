<type:ColorEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Color)
  </baseType>
  <is>
    A color value as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a Color primitive. Binds T = Color on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Bare Color uses L = English for free-text color names.
  </documentation>
</type:ColorEntity>
