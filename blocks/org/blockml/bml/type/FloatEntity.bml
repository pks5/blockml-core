<type:FloatEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Float)
  </baseType>
  <is>
    A floating-point number as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a Float primitive. Binds T = Float on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:FloatEntity>
