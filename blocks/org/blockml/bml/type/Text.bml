<type:Text xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:PrimitiveType
  </baseType>
  <is>
    A text string
  </is>
  <documentation>
    BOM Core primitive ValueType for text. Unqualified name Text resolves to
    org.blockml.bml.type.Text. Replaces the former String type — BlockML describes semantic types, not
    implementation data structures. Renderers may map Text to Java String, TypeScript string,
    Python str, C# string, or any target representation.
    
    Semantic subtypes extend Text: TypeSelector / TypeIdentifier / TypeReference, PackageSelector /
    PackageIdentifier / PackageReference, InstanceIdentifier / InstanceReference, MemberIdentifier (PropertyIdentifier /
    PropertyReference / …), Version, URL, URI, UUID, FilePath, MimeType, …
    Concrete payload values are stored on Properties — not on the Text type itself.
    
    Member values of this type may contain restricted ${ } holes in running text
    (InterpolatedTextValue). A whole-value "${ expr }" remains an ExpressionValue. See
    doc:Expressions.
    
    Optional configuration Properties (minLength, maxLength) configure a Property's owned Text
    instance via inline type syntax — Text{maxLength: 100}. Positional order: minLength, maxLength.
    See 20_value_type_instance_configuration.md.
  </documentation>
  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Interpolated Text holes, #this lookup, and Restricted Profile.
    </see>
    <see type="doc:ValueTypeParsing" relation="SeeAlso">
      parseValue identity — every authored string is Text.
    </see>
  </references>
  <properties>
    <minLength type="type:Integer">
      <documentation>
        Minimum allowed text length (inclusive). Configured via Text{minLength: n}.
      </documentation>
    </minLength>
    <maxLength type="type:Integer">
      <documentation>
        Maximum allowed text length (inclusive). Configured via Text{maxLength: n}.
      </documentation>
    </maxLength>
  </properties>
  <capabilities>
    <parseValue override="true" type="org.blockml.bml.capability.Transformation" inputType="type:Text" outputType="bml:Self">
      <throws>
        <ex:InvalidValueException />
      </throws>
      <documentation>
        Identity — every authored string is a Text value. Length bounds are instance
        configuration (minLength / maxLength), applied after parse.
      </documentation>
      <implementation language="org.blockml.bml.language.TypeScript">
        <![CDATA[(raw: string): string => raw]]>
      </implementation>
    </parseValue>
  </capabilities>
</type:Text>
