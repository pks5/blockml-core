<type:AggregationIdentifierEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:AggregationIdentifier)
  </baseType>
  <is>
    An Aggregation member path as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping an AggregationIdentifier primitive. Binds T =
    AggregationIdentifier on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value
    property automatically. Use when a potential aggregation path must appear as an identifiable
    Block instance. Existence-checked counterparts use AggregationReferenceEntity.
  </documentation>
</type:AggregationIdentifierEntity>
