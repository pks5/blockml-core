<!--BlockML Core — AggregationDefinition path reference

  FQN: org.blockml.bml.type.AggregationReference-->
<type:AggregationReference xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:AggregationIdentifier
  </baseType>
  <is>
    A path to an Aggregation member
  </is>
  <documentation>
    Existence-checked AggregationIdentifier. Value is a canonical aggregation path
    (com.foo.Bar.aggregations.children) or a local aggregation name when paired with a type
    qualifier. The owning type and aggregation must resolve. Used as the type of see aggregation=.
    A potential aggregation that need not exist uses AggregationIdentifier.
  </documentation>
  <references>
    <see type="type:AggregationIdentifier" relation="SeeAlso">
      Parent ValueType — aggregation-path syntax without existence.
    </see>
    <see type="def:AggregationDefinition" relation="Defines">
      Target member meta-model type.
    </see>
    <see type="def:StructuralDefinition" relation="SeeAlso">
      see aggregation attribute.
    </see>
  </references>
  <genericTypes>
    <B baseType="core:Block" defaultType="org.blockml.bml.core.Block" />
  </genericTypes>
</type:AggregationReference>
