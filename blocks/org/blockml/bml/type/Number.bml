<type:Number xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit">

  <baseType>
    type:PrimitiveType
  </baseType>
  <is>
    A numeric value
  </is>
  <documentation>
    Abstract numeric primitive branch under org.blockml.bml.type.PrimitiveType.
    Concrete types: Integer (whole numbers), Decimal (default for non-integer numeric values),
    Float (binary floating-point — only when IEEE754 semantics are explicitly required).
    Abstract numeric branch — not resolvable via Property.type implicit namespace; use Integer, Decimal, or Float explicitly.
    Numeric types describe semantics only; values are stored in Properties.
    
    Generic parameter N constrains the measurement unit (extends org.blockml.bml.core.Unit).
    Default is org.blockml.bml.unit.None — bare Number / Integer / Decimal / Float are dimensionless.
    Supply N at reference sites when a unit is required, e.g. Integer(unit:Millimeter).
    
    parseValue accepts a numeric literal (optional sign, digits, optional fraction and exponent).
    Integer, Decimal, and Float refine the lexical form. min/max and unit are not applied here
    (doc:ValueTypeParsing).
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <N baseType="core:Unit" defaultType="org.blockml.bml.unit.None" />
  </genericTypes>
  <capabilities>
    <parseValue override="true" type="org.blockml.bml.capability.Transformation" inputType="type:Text" outputType="bml:Self">
      <throws>
        <ex:InvalidValueException />
      </throws>
      <documentation>
        Numeric literal — optional sign, integer digits, optional fraction, optional exponent.
        Integer / Decimal / Float override with tighter forms.
      </documentation>
      <implementation language="org.blockml.bml.language.TypeScript">
        <![CDATA[
        (raw: string): number => {
          const t = raw.trim();
          if (!/^[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?$/.test(t)) {
            throw new Error("not a numeric literal: " + raw);
          }
          const n = Number(t);
          if (!Number.isFinite(n)) {
            throw new Error("not a finite number: " + raw);
          }
          return n;
        }
        ]]>
      </implementation>
    </parseValue>
  </capabilities>
</type:Number>
