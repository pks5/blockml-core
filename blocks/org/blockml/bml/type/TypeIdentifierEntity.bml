<type:TypeIdentifierEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:TypeIdentifier)
  </baseType>
  <is>
    A type name as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a TypeIdentifier primitive. Binds T = TypeIdentifier
    on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a type name that need not exist must appear as an identifiable Block instance.
    Existence-checked counterparts use TypeReferenceEntity.
  </documentation>
</type:TypeIdentifierEntity>
