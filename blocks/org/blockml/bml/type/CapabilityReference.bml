<!--
  BlockML Core — CapabilityDefinition path reference

  FQN: org.blockml.bml.type.CapabilityReference
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>CapabilityReference</name>
  <type>type:CapabilityReference</type>
  <baseType>type:CapabilityIdentifier(B)</baseType>
  <is>A path to a Capability member</is>

  <documentation>Existence-checked CapabilityIdentifier. Value is a canonical capability path
    (com.foo.Bar.capabilities.render) or a local capability name when paired with a type qualifier.
    The owning type and capability must resolve. Used as the type of see capability=. A potential
    capability that need not exist uses CapabilityIdentifier.</documentation>

  <references>
    <see type="type:CapabilityIdentifier" relation="SeeAlso">
      Parent ValueType — capability-path syntax without existence.
    </see>
    <see type="def:CapabilityDefinition" relation="Defines">
      Target member meta-model type.
    </see>
    <see type="def:StructuralDefinition" relation="SeeAlso">
      see capability attribute.
    </see>
  </references>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch. Defaults to core:Block.</documentation>
    </B>
  </genericTypes>
</block>
