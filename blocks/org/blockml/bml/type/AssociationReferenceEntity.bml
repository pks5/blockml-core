<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>AssociationReferenceEntity</name>
  <type>type:AssociationReferenceEntity</type>
  <baseType>core:PrimitiveEntity(type:AssociationReference(B))</baseType>
  <is>A path to an Association member as an Entity</is>

  <documentation>Open generic Entity wrapping an AssociationReference primitive. Forwards B from
    org.blockml.bml.type.AssociationReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : AssociationReference(B). Use when a
    resolved association path must appear as an identifiable Block instance. Syntax-only paths use
    AssociationIdentifierEntity.</documentation>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — mirrored from AssociationReference.B. Checked after
        resolution.</documentation>
    </B>
  </genericTypes>
</block>
