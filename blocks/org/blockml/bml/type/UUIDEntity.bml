<type:UUIDEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:UUID)
  </baseType>
  <is>
    A UUID as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a UUID primitive. Binds T = UUID on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:UUIDEntity>
