<type:FilePathEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:FilePath)
  </baseType>
  <is>
    A filesystem path as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a FilePath primitive. Binds T = FilePath on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:FilePathEntity>
