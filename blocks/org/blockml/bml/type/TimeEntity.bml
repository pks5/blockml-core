<type:TimeEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Time)
  </baseType>
  <is>
    A time of day as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a Time primitive. Binds T = Time on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a time of day must appear as an identifiable Block instance.
  </documentation>
</type:TimeEntity>
