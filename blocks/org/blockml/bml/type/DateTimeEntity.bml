<type:DateTimeEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:DateTime)
  </baseType>
  <is>
    A date and time as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a DateTime primitive. Binds T = DateTime on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a date-time must appear as an identifiable Block instance.
  </documentation>
</type:DateTimeEntity>
