<type:BooleanEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Boolean)
  </baseType>
  <is>
    A true-or-false value as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a Boolean primitive. Binds T = Boolean on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:BooleanEntity>
