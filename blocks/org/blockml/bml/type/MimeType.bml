<type:MimeType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:Text
  </baseType>
  <is>
    A MIME media-type string
  </is>
  <documentation>
    Textual primitive subtype for MIME type values (for example text/plain,
    application/json). Unqualified name MimeType resolves to     org.blockml.bml.type.MimeType.
  </documentation>
  <references>
    <see type="doc:ValueTypeParsing" relation="SeeAlso">
      parseValue — type/subtype token.
    </see>
  </references>
  <capabilities>
    <parseValue override="true" type="org.blockml.bml.capability.Transformation" inputType="type:Text" outputType="bml:Self">
      <throws>
        <ex:InvalidValueException />
      </throws>
      <documentation>
        MIME type token type/subtype (for example text/plain, application/json). Optional
        +suffix on the subtype (application/vnd.api+json).
      </documentation>
      <implementation language="org.blockml.bml.language.TypeScript">
        <![CDATA[
        (raw: string): string => {
          const t = raw.trim();
          if (!/^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$/.test(t)) {
            throw new Error("not a MIME type: " + raw);
          }
          return t;
        }
        ]]>
      </implementation>
    </parseValue>
  </capabilities>
</type:MimeType>
