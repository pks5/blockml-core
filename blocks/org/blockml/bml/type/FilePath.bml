<type:FilePath xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:Text
  </baseType>
  <is>
    A filesystem path string
  </is>
  <documentation>
    Textual primitive subtype for file path values. Unqualified name FilePath resolves
    to org.blockml.bml.type.FilePath.
  </documentation>
</type:FilePath>
