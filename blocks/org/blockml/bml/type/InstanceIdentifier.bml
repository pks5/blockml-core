<!--
  BlockML Core — Block instance name identifier value type (syntax only)

  FQN: org.blockml.bml.type.InstanceIdentifier
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <name>InstanceIdentifier</name>
  <type>type:InstanceIdentifier</type>
  <baseType>type:Text</baseType>
  <is>A Block instance name</is>

  <documentation>
    ValueType for non-owning instance name strings identified by bml:id. Unqualified name
    InstanceIdentifier resolves to org.blockml.bml.type.InstanceIdentifier. Syntax only — the
    named instance need not exist. No generic parameters. InstanceReference(T) extends this type
    and adds existence plus the branch bound T.

    Lexical forms:
    • Local id — myId (visibility-scoped within the enclosing composition)
    • Qualified — {EnclosingBlockFQN}::{instanceId} (e.g. com.foo.Bar::myId)
    • Prefixed qualified — foo:Bar::myId (xmlns QName of the enclosing Block document, then :: and id)

    Not a Block type FQN (use TypeIdentifier / TypeReference), not a package string (use
    PackageIdentifier / PackageReference), not a member definition path (use MemberIdentifier /
    AssociationIdentifier), and not a resource URI (use URI).

    Primary use — planned or future instance pointers. AssociationDefinition type and see
    instance= use InstanceReference — not InstanceIdentifier.
  </documentation>

  <references>
    <see type="doc:TypeExpressions" relation="AuthoringGuide">
      TypeReference · InstanceReference · MemberReference.
    </see>
    <see type="type:InstanceReference" relation="SeeAlso">
      Existence-checked specialization — instance must resolve.
    </see>
    <see type="type:TypeIdentifier" relation="SeeAlso">
      Sibling ValueType for Block type FQNs — not instance names.
    </see>
    <see type="type:AssociationIdentifier" relation="ContrastsWith">
      Path to an AssociationDefinition — not an instance name.
    </see>
  </references>
</block>
