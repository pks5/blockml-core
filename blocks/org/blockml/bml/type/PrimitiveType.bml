<!--BlockML Core — primitive type branch

  FQN: org.blockml.bml.type.PrimitiveType-->
<type:PrimitiveType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:ValueType
  </baseType>
  <is>
    An atomic scalar ValueType
  </is>
  <documentation>
    Abstract branch for built-in scalar ValueTypes. PrimitiveTypes describe semantics
    only — they never store concrete values. All values are stored exclusively in Properties.
    
    Numeric branch: Number (Integer, Decimal, Float). Textual branch: Text (TypeIdentifier /
    TypeReference, PackageIdentifier / PackageReference, InstanceIdentifier / InstanceReference,
    MemberIdentifier / PropertyIdentifier / PropertyReference / …, Version, URL, URI, UUID, FilePath,
    MimeType, …). Temporal
    branch: Temporal (Date, Time, DateTime) — calendar or clock positions. Boolean is its own
    branch — neither textual nor numeric. Duration is its own branch — an elapsed-time magnitude,
    not a Temporal subtype.
    
    Lexical acceptance of authored text is parseValue (Text → bml:Self, throws
    InvalidValueException). Concrete primitives implement a deterministic host-evaluable body.
    Configuration, constraints, and Reference existence run after parse — doc:ValueTypeParsing.
    
    When a primitive value must exist as an Entity inside a composition or aggregation, use a
    concrete Entity specialization (for example IntegerEntity) — not by adding a value member to
    the PrimitiveType.
    
    Invalid: &lt;type:Integer value="5"/> — PrimitiveTypes cannot carry values.
    Valid: &lt;property name="count" type="Integer">&lt;value>5&lt;/value>&lt;/property>
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="doc:TypeSystemOverview" relation="AuthoringGuide">
      PrimitiveType branch.
    </see>
    <see type="type:Number" relation="SeeAlso">
      Numeric primitive branch.
    </see>
    <see type="type:Text" relation="SeeAlso">
      Textual primitive branch.
    </see>
    <see type="type:Temporal" relation="SeeAlso">
      Temporal position branch — Date, Time, DateTime.
    </see>
    <see type="type:Duration" relation="SeeAlso">
      Elapsed-time magnitude — sibling of Temporal under PrimitiveType.
    </see>
    <see type="type:IntegerEntity" relation="SeeAlso">
      Example concrete Entity wrapper for primitive values.
    </see>
    <see type="doc:ValueTypeParsing" relation="AuthoringGuide">
      parseValue — lexical Text to bml:Self.
    </see>
  </references>
  <capabilities>
    <parseValue abstract="true" type="org.blockml.bml.capability.Transformation" inputType="type:Text" outputType="bml:Self">
      <throws>
        <ex:InvalidValueException />
      </throws>
      <documentation>
        Lexical parse of authored XML text into a value of this PrimitiveType (bml:Self after
        inheritance). Throws ex:InvalidValueException when the text is not a value of this type.
        Does not apply Integer{min,max} or other instance configuration, Property constraints,
        or TypeRegistry existence. Host TypeScript return types are FunctionMapping — not
        outputType (doc:ValueTypeParsing).
      </documentation>
    </parseValue>
  </capabilities>
</type:PrimitiveType>
