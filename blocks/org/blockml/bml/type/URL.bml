<type:URL xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:Text
  </baseType>
  <is>
    A web address string
  </is>
  <documentation>
    Textual primitive subtype for URL values. Unqualified name URL resolves to
    org.blockml.bml.type.URL.
  </documentation>
</type:URL>
