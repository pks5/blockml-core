<type:DateEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Date)
  </baseType>
  <is>
    A calendar date as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a Date primitive. Binds T = Date on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a date must appear as an identifiable Block instance.
  </documentation>
</type:DateEntity>
