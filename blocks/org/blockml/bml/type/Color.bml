<!--
  BlockML Core — color primitive type

  FQN: org.blockml.bml.type.Color
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:ex="org.blockml.bml.exception"
  xmlns:lang="org.blockml.bml.language"
  xmlns:type="org.blockml.bml.type">

  <name>Color</name>
  <type>type:Color</type>
  <baseType>type:Text</baseType>
  <is>A color value string</is>

  <documentation>Textual primitive subtype for color values. Unqualified name Color resolves to
    org.blockml.bml.type.Color.

    Accepted forms (case-insensitive for function names and named colors):
    • Hex — CSS lengths #RGB, #RGBA, #RRGGBB, #RRGGBBAA (for example #afafaf, #a3d4e200)
    • rgb / RGB — rgb(255,12,230)
    • rgba / RGBA — rgba(34,54,21,0.5) with alpha in the CSS 0–1 range
    • Named color — free-text name in language L (for example red, Blue); the base Color type
      does not validate named colors against a catalogue. A subtype may later constrain L to a
      fixed set of names.

    Generic parameter L (NaturalLanguage, default English) names the language of free-text color
    names. Bare Color resolves to English; supply Color(lang:German) only when named colors are
    expected in another language.</documentation>

  <genericTypes>
    <L baseType="lang:NaturalLanguage" defaultType="lang:English"/>
  </genericTypes>

  <references>
    <see type="lang:NaturalLanguage" relation="Defines">
      L bound — language of free-text color names (default English).
    </see>
    <see type="lang:English" relation="Defines">
      DefaultType for L when the color-name language is omitted.
    </see>
    <see type="type:Text" relation="Extends">
      Color is a textual primitive subtype.
    </see>
    <see type="doc:ValueTypeParsing" relation="SeeAlso">
      parseValue — hex, rgb/rgba, or named color token.
    </see>
  </references>

  <capabilities>
    <parseValue
      override="true"
      abstract="false"
      type="Transformation"
      inputType="Text"
      outputType="bml:Self">
      <documentation>
        Hex #RGB / #RGBA / #RRGGBB / #RRGGBBAA, rgb()/rgba() with 0–255 channels and optional
        0–1 alpha, or a named-color token (letters only — catalogue is not checked).
      </documentation>
      <throws>
        <ex:InvalidValueException />
      </throws>
      <implementation language="TypeScript"><![CDATA[
        (raw: string): string => {
          const t = raw.trim();
          if (/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(t)) {
            return t;
          }
          const rgb = /^(rgb|RGB)\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*\)$/.exec(t);
          if (rgb) {
            const ch = [rgb[2], rgb[3], rgb[4]].map(Number);
            if (ch.every((n) => n >= 0 && n <= 255)) return t;
            throw new Error("rgb channel out of range: " + raw);
          }
          const rgba = /^(rgba|RGBA)\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(0|1|0?\.\d+)\s*\)$/.exec(t);
          if (rgba) {
            const ch = [rgba[2], rgba[3], rgba[4]].map(Number);
            const a = Number(rgba[5]);
            if (ch.every((n) => n >= 0 && n <= 255) && a >= 0 && a <= 1) return t;
            throw new Error("rgba channel out of range: " + raw);
          }
          if (/^[A-Za-z][A-Za-z -]*$/.test(t)) return t;
          throw new Error("not a color: " + raw);
        }
      ]]></implementation>
    </parseValue>
  </capabilities>
</block>
