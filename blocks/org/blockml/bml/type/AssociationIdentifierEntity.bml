<type:AssociationIdentifierEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:AssociationIdentifier)
  </baseType>
  <is>
    An Association member path as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping an AssociationIdentifier primitive. Binds T =
    AssociationIdentifier on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value
    property automatically. Use when a potential association path must appear as an identifiable
    Block instance. Existence-checked counterparts use AssociationReferenceEntity.
  </documentation>
</type:AssociationIdentifierEntity>
