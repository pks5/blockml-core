<type:PackageReferenceEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:PackageReference)
  </baseType>
  <is>
    A package name reference as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a PackageReference primitive. Binds T = PackageReference
    on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a package reference must appear as an identifiable Block instance.
  </documentation>
</type:PackageReferenceEntity>
