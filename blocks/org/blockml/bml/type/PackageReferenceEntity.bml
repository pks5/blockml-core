<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>PackageReferenceEntity</name>
  <type>type:PackageReferenceEntity</type>
  <baseType>core:PrimitiveEntity(type:PackageReference)</baseType>
  <is>A package name reference as an Entity</is>

  <documentation>Concrete Entity wrapping a PackageReference primitive. Binds T = PackageReference
    on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a package reference must appear as an identifiable Block instance.</documentation>
</block>
