<!--
  BlockML Core — member definition path reference value type

  FQN: org.blockml.bml.type.MemberReference
  See docs/16_framework_base_types.md — Definition Addressing · references
       docs/17_type_system_bml.md — TypeReference · MemberReference
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>MemberReference</name>
  <type>type:MemberReference</type>
  <baseType>type:MemberIdentifier(D)</baseType>
  <is>A path to a Block member</is>

  <documentation>Abstract ValueType for references to Block member definitions — properties,
    aggregations, associations, and capabilities. Extends MemberIdentifier(D) (syntax, including
    inherited parseValue) with existence and
    introduces the owning Block bound B: the owning type and the named member must resolve. Not a
    TypeReference — a member path is not a type FQN.

    Value forms:
    • Canonical definition path — for example com.foo.Bar.properties.width
    • Local member name when paired with a type qualifier (for example see type="com.foo.Bar"
      property="width" → com.foo.Bar.properties.width)

    Generic parameters:
    • B (baseType core:Block, default core:Block) — owning Block branch; introduced here
    • D (from MemberIdentifier) — member definition kind constraint

    Concrete Identifier specializations bind D and own the existence-checked Reference:
    • PropertyIdentifier     → PropertyReference
    • AggregationIdentifier  → AggregationReference
    • AssociationIdentifier  → AssociationReference
    • CapabilityIdentifier   → CapabilityReference

    PropertyReference and siblings are cousins of MemberReference under MemberIdentifier — they
    do not extend MemberReference. MemberReference is the existence layer for an unbound member
    kind. A member path that need not exist uses MemberIdentifier (or PropertyIdentifier, …).

    Primary use — StructuralDefinition Reference (see) member target attributes via the concrete
    Reference types. Not for Block type identity (use TypeReference), instance pointers (use
    InstanceReference), or type-reference aggregations (use TypeReferenceEntity).</documentation>

  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      Definition addressing and see targets.
    </see>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      references — separate target attributes.
    </see>
    <see type="type:MemberIdentifier" relation="SeeAlso">
      Parent ValueType — parseValue syntax without existence.
    </see>
    <see type="doc:ValueTypeParsing" relation="SeeAlso">
      Lexical parse vs member-path resolution.
    </see>
    <see type="def:MemberDefinition" relation="Defines">
      Abstract member meta-model branch bound by D.
    </see>
    <see type="def:StructuralDefinition" relation="SeeAlso">
      Reference sub-block — property / aggregation / association / capability attributes.
    </see>
    <see type="type:PropertyReference" relation="SeeAlso">
      Concrete specialization for PropertyDefinition paths — via PropertyIdentifier.
    </see>
  </references>

  <abstract>true</abstract>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — introduced on this Reference. Defaults to core:Block.
      </documentation>
    </B>
    <D baseType="def:MemberDefinition">
      <documentation>Member definition kind. Bound by concrete Identifier children
        (PropertyIdentifier, …).</documentation>
    </D>
  </genericTypes>
</block>
