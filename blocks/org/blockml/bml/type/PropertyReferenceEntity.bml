<type:PropertyReferenceEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:PropertyReference(B))
  </baseType>
  <is>
    A path to a Property member as an Entity
  </is>
  <documentation>
    Open generic Entity wrapping a PropertyReference primitive. Forwards B from
    org.blockml.bml.type.PropertyReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : PropertyReference(B). Use when a resolved
    property path must appear as an identifiable Block instance. Syntax-only paths use
    PropertyIdentifierEntity.
  </documentation>
  <genericTypes>
    <B baseType="core:Block" defaultType="org.blockml.bml.core.Block">
      <documentation>
        Owning Block branch — mirrored from PropertyReference.B. Checked after
        resolution.
      </documentation>
    </B>
  </genericTypes>
</type:PropertyReferenceEntity>
