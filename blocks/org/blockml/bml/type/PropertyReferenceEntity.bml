<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>PropertyReferenceEntity</name>
  <type>type:PropertyReferenceEntity</type>
  <baseType>core:PrimitiveEntity(type:PropertyReference(B))</baseType>
  <is>A path to a Property member as an Entity</is>

  <documentation>Open generic Entity wrapping a PropertyReference primitive. Forwards B from
    org.blockml.bml.type.PropertyReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : PropertyReference(B). Use when a resolved
    property path must appear as an identifiable Block instance. Syntax-only paths use
    PropertyIdentifierEntity.</documentation>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — mirrored from PropertyReference.B. Checked after
        resolution.</documentation>
    </B>
  </genericTypes>
</block>
