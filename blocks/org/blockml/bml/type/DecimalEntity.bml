<type:DecimalEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Decimal)
  </baseType>
  <is>
    A decimal number as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a Decimal primitive. Binds T = Decimal on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:DecimalEntity>
