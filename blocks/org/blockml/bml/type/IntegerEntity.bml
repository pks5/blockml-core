<type:IntegerEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Integer)
  </baseType>
  <is>
    A whole number as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping an Integer primitive. Binds T = Integer on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when an integer must appear as an identifiable Block instance.
  </documentation>
</type:IntegerEntity>
