<!--BlockML Core — AssociationDefinition path identifier (syntax only)

  FQN: org.blockml.bml.type.AssociationIdentifier-->
<type:AssociationIdentifier xmlns="http://blockml.org/bml"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:MemberIdentifier(def:AssociationDefinition)
  </baseType>
  <is>
    An Association member path
  </is>
  <documentation>
    Concrete MemberIdentifier binding D = AssociationDefinition. Value is a canonical
    association path (com.foo.Bar.associations.basePresets) or a local association name when paired
    with a type qualifier. Syntax only — the owning type and association need not exist.
    AssociationReference extends this type and adds existence. Use when addressing a potential
    association. see association= uses AssociationReference. AssociationReference(B) introduces
    the owning Block bound after resolution.
  </documentation>
  <references>
    <see type="type:MemberIdentifier" relation="SeeAlso">
      Abstract member path Identifier.
    </see>
    <see type="type:AssociationReference" relation="SeeAlso">
      Existence-checked specialization — association must resolve.
    </see>
    <see type="def:AssociationDefinition" relation="Defines">
      Target member meta-model type.
    </see>
  </references>
</type:AssociationIdentifier>
