<type:VersionEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Version)
  </baseType>
  <is>
    A version number as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a Version primitive. Binds T = Version on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:VersionEntity>
