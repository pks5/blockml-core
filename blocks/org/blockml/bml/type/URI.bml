<type:URI xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    type:Text
  </baseType>
  <is>
    A resource identifier string
  </is>
  <documentation>
    Textual primitive subtype for URI values. Unqualified name URI resolves to
    org.blockml.bml.type.URI.
  </documentation>
</type:URI>
