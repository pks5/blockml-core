<type:TextEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Text)
  </baseType>
  <is>
    A text string as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a Text primitive. Binds T = Text on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
  </documentation>
</type:TextEntity>
