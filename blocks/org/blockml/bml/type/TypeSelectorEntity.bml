<type:TypeSelectorEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:TypeSelector)
  </baseType>
  <is>
    A type selector as an Entity
  </is>
  <documentation>
    Concrete Entity wrapping a TypeSelector primitive. Binds T = TypeSelector
    on org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a type selector must appear as an identifiable Block instance.
    Concrete type names use TypeIdentifierEntity.
  </documentation>
</type:TypeSelectorEntity>
