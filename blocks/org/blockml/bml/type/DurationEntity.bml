<type:DurationEntity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:PrimitiveEntity(type:Duration)
  </baseType>
  <is>
    A length of time as a PrimitiveEntity
  </is>
  <documentation>
    Concrete PrimitiveEntity wrapping a Duration primitive. Binds T = Duration on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a duration must appear as an identifiable Block instance.
  </documentation>
</type:DurationEntity>
