<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>DurationEntity</name>
  <type>type:DurationEntity</type>
  <baseType>core:PrimitiveEntity(type:Duration)</baseType>
  <is>A length of time as an Entity</is>

  <documentation>Concrete Entity wrapping a Duration primitive. Binds T = Duration on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
    Use when a duration must appear as an identifiable Block instance.</documentation>
</block>
