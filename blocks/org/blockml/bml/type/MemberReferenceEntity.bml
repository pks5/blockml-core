<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>MemberReferenceEntity</name>
  <type>type:MemberReferenceEntity</type>
  <baseType>core:PrimitiveEntity(type:MemberReference(B, D))</baseType>
  <is>A path to a Block member as an Entity</is>

  <documentation>Open generic Entity wrapping a MemberReference primitive. Forwards B and D from
    org.blockml.bml.type.MemberReference onto org.blockml.bml.core.PrimitiveEntity via baseType —
    inherits the value property automatically as value : MemberReference(B, D). Use when a resolved
    member path must appear as an identifiable Block instance. Syntax-only paths use
    MemberIdentifierEntity. Concrete Reference Entities (PropertyReferenceEntity, …) bind D and
    introduce B on the scalar Reference.</documentation>

  <abstract>true</abstract>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — mirrored from MemberReference.B. Checked after
        resolution.</documentation>
    </B>
    <D baseType="def:MemberDefinition">
      <documentation>Member definition kind — mirrored from MemberReference.D.</documentation>
    </D>
  </genericTypes>
</block>
