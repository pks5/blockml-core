<!--BlockML Core — abstract documentation block base type

  FQN: org.blockml.bml.core.Documentation-->
<core:Documentation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:howto="org.blockml.bml.documentation.howto">

  <baseType>
    core:Block
  </baseType>
  <is>
    A narrative documentation Block
  </is>
  <documentation>
    Abstract base for org.blockml.bml.documentation.* blocks — curated reading material that
    explains BlockML concepts in mental learning order. Each concrete documentation block
    carries is, documentation, and references; cross-links belong in references, not in
    documentation prose. Listed via relation=ReadFirst on README and other ReadMe blocks.
    Procedural how-to blocks extend org.blockml.bml.documentation.howto.HowTo instead.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="core:ReadMe" relation="SeeAlso">
      Library reading entry — ReadFirst and HowToIndex on references.
    </see>
    <see type="howto:HowTo" relation="SeeAlso">
      Procedural how-to blocks — org.blockml.bml.documentation.howto.* blocks.
    </see>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      Block documentation model.
    </see>
  </references>
</core:Documentation>
