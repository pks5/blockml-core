<!--BlockML Core — capability exception branch

  FQN: org.blockml.bml.core.Exception-->
<core:Exception xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Block
  </baseType>
  <is>
    A thrown exceptional condition
  </is>
  <isnot>
    A validator diagnostic code
  </isnot>
  <documentation>
    <![CDATA[
    Abstract core root branch for exception types that a Capability may declare it can raise.
    Direct child of Block — not an Entity. Exceptions are signature types, not composable
    aggregation children.
    
    Corresponds to Java exception classes used in a method `throws` clause: the type is listed
    on the Capability signature; instances carry a human-readable message.
    
    Domain libraries define concrete exception types extending this branch (for example
    `com.example.bml.FileNotFound`). Capability members list those types on
    `org.blockml.bml.definition.CapabilityDefinition.throws` via
    `type:TypeReferenceEntity(core:Exception)[]` — empty-QName sugar such as `<io:FileNotFound />`.
    
    Distinct from `org.blockml.bml.core.Diagnostic`, which catalogues validator and parser codes
    rather than Capability-thrown failures. Distinct from `org.blockml.bml.core.Entity`, which
    is the branch for instances nested in composition or aggregation.
    ]]>
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      throws on Capability members — Java-style exception signatures.
    </see>
    <see type="def:CapabilityDefinition" relation="Requires">
      throws aggregation lists Exception types on a Capability member.
    </see>
    <see type="core:Diagnostic" relation="ContrastsWith">
      Validator and parser diagnostic codes — not Capability-thrown exceptions.
    </see>
    <see type="core:Entity" relation="ContrastsWith">
      Composable instance branch — Exception is not nested as an aggregation child.
    </see>
    <see type="core:Block" relation="Extends">
      Core root branch — direct child of Block.
    </see>
  </references>
  <properties>
    <message type="org.blockml.bml.type.Text">
      <documentation>
        Human-readable explanation of the exceptional condition. Corresponds to the
        message on a Java Exception instance (constructor argument / getMessage()). Owned by the
        Exception instance — not by the Exception type definition.
      </documentation>
    </message>
  </properties>
</core:Exception>
