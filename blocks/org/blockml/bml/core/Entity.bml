<!--BlockML Core — type Block branch (property / payload types)

  FQN: org.blockml.bml.core.Entity-->
<core:Entity xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A composable Block instance kind
  </is>
  <documentation>
    Abstract branch for Entities — Blocks that represent instances with identity in
    composition or aggregation. PrimitiveEntity wrappers extend Entity. Domain blocks
    and built-in expression services (org.blockml.bml.service.*) do not — services are
    ordinary Blocks (a package role), not an Entity subtype. Entity is not a ValueType;
    use Property with a ValueType for typed payloads.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="doc:TypeSystemOverview" relation="AuthoringGuide">
      Entity branch and PrimitiveEntity wrappers.
    </see>
    <see type="doc:BlockAndInstance" relation="SeeAlso">
      Entity instances in composition vs Block definitions.
    </see>
    <see type="core:PrimitiveEntity" relation="SeeAlso">
      Primitive value wrappers as Entity instances.
    </see>
    <see type="type:TypeReferenceEntity" relation="SeeAlso">
      TypeReference value as Entity — used for contracts and Library lists.
    </see>
  </references>
</core:Entity>
