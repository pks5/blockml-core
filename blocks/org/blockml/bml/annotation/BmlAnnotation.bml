<!--BlockML — language annotation (bml: directives)

  FQN: org.blockml.bml.annotation.BmlAnnotation

  Preferred authoring binding:
    xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"-->
<ann:BmlAnnotation xmlns="http://blockml.org/bml"
  xmlns:ann="org.blockml.bml.annotation"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Annotation
  </baseType>
  <is>
    The BlockML language annotation namespace
  </is>
  <documentation>
    Concrete Annotation for BlockML language directives. preferredAlias is bml. Authoring documents
    bind xmlns:bml to this FQN. Directives control composition structure, instance identity, generic
    binding, service beans, and serialization shape — they are not Block properties and not
    Definition members.
    
    Attribute directives: id, version, bean, scope, status, generics, each, if, unless, with, xml.
    Element directives: container. Dual authoring (attribute or child element) is documented on
    generics and xml.
    
    The legacy schema URI http://blockml.org/schema/bml remains an XSD/catalog identifier only —
    BML-semantic xmlns:bml must target this Annotation. XSD is not a standard feature;
    xmlns:xsi and xsi:schemaLocation are omitted by default (doc:DocumentFormat).
  </documentation>
  <references>
    <see type="core:Annotation" relation="Extends">
      Annotation branch — Package vs Annotation xmlns rule.
    </see>
    <see type="doc:AnnotationModel" relation="SeeAlso">
      Annotation branch — facets and Package vs Annotation xmlns rule.
    </see>
    <see type="doc:BmlDirectives" relation="AuthoringGuide">
      Normative placement and semantics for all bml: directives.
    </see>
    <see type="doc:CompositionModel" relation="SeeAlso">
      Composition and bml:container as directive hosts.
    </see>
    <see type="doc:GenericsModel" relation="SeeAlso">
      Open generic instances bind via bml:generics.
    </see>
  </references>
  <properties>
    <preferredAlias override="true" type="org.blockml.bml.type.Text">
      <documentation>
        Preferred xmlns prefix for BlockML language directives.
      </documentation>
      <value>bml</value>
    </preferredAlias>
  </properties>
  <aggregations>
    <directives override="true">
      <composition>
        <bml:Id />
        <bml:Version />
        <bml:Bean />
        <bml:Scope />
        <bml:Status />
        <bml:Generics />
        <bml:Each />
        <bml:If />
        <bml:Unless />
        <bml:With />
        <bml:Xml />
        <bml:Container />
      </composition>
    </directives>
  </aggregations>
  <subBlocks>
    <Id>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A composition instance identity directive
      </is>
      <documentation>
        Attribute directive bml:id — instance identity within a composition tree.
        Required when the instance is referenced or carries bml:each.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>id</value>
        </name>
      </properties>
    </Id>
    <Version>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        An external type version pin directive
      </is>
      <documentation>
        Attribute directive bml:version — optional exact-version assert when a
        composition reference targets an external block type.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>version</value>
        </name>
      </properties>
    </Version>
    <Bean>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A service bean registration directive
      </is>
      <documentation>
        Attribute directive bml:bean — registers the instance as a named service bean
        for expression access via @beanName.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>bean</value>
        </name>
      </properties>
    </Bean>
    <Scope>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A service bean visibility scope directive
      </is>
      <documentation>
        Attribute directive bml:scope — "local" or "context" for service bean
        visibility. Default local when omitted.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>scope</value>
        </name>
      </properties>
    </Scope>
    <Status>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A lifecycle status attribute directive
      </is>
      <documentation>
        Attribute directive bml:status — shorthand status reference; unqualified
        values resolve via org.blockml.bml.status.*.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>status</value>
        </name>
      </properties>
    </Status>
    <Generics>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A generic type-argument binding directive
      </is>
      <documentation>
        Attribute or child-element directive bml:generics — binds open genericTypes
        on a Block instance. Only on Block instances (composition children and instance aggregation
        fill). Value is the parenthesized argument list from a baseType generic application — the
        type name is omitted because the instance tag is the type. Parentheses are required.
        Attribute form: bml:generics="(type:Integer)". Element form:
        &lt;bml:generics>(type:String, myns:MyBlock)&lt;/bml:generics>. Arguments are
        TypeExpressions in declaration order. Authored args win; remaining parameters take
        defaultType. Open generic instance without this directive → BML_OPEN_GENERIC_INSTANCE.
        Placement elsewhere → BML_GENERICS_DIRECTIVE_NOT_ALLOWED. Argument list incompatible with
        the instance's open parameters → BML_GENERICS_ARGUMENT_MISMATCH. See doc:BmlDirectives
        and doc:GenericsModel.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>generics</value>
        </name>
      </properties>
    </Generics>
    <Each>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A composition loop directive
      </is>
      <documentation>
        Attribute directive bml:each — expands the element once per loop iteration
        (numeric or collection). See doc:BmlDirectives.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>each</value>
        </name>
      </properties>
    </Each>
    <If>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A conditional include directive
      </is>
      <documentation>
        Attribute directive bml:if — includes the element only when the expression
        evaluates to true.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>if</value>
        </name>
      </properties>
    </If>
    <Unless>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A conditional exclude directive
      </is>
      <documentation>
        Attribute directive bml:unless — includes the element only when the expression
        evaluates to false. Negation of bml:if.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>unless</value>
        </name>
      </properties>
    </Unless>
    <With>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A local variable scope directive
      </is>
      <documentation>
        Attribute directive bml:with — defines local variables visible within the
        element and its descendants. See doc:BmlDirectives.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>with</value>
        </name>
      </properties>
    </With>
    <Xml>
      <baseType>
        core:Annotation.Attribute
      </baseType>
      <is>
        A serialization shape directive
      </is>
      <documentation>
        Attribute or member-level directive bml:xml — declares how a definition or
        member maps to XML when rendering BML from the BOM. Complements flow-control directives;
        does not expand composition. See doc:BmlDirectives · 19_definition_blocks_and_bml_xml.md.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>xml</value>
        </name>
      </properties>
    </Xml>
    <Container>
      <baseType>
        core:Annotation.Element
      </baseType>
      <is>
        A virtual composition grouping element
      </is>
      <documentation>
        Element directive bml:container — virtual container that produces no Block
        output but applies directives to a group of children.
      </documentation>
      <properties>
        <name final="true" override="true" type="org.blockml.bml.type.Text">
          <value>container</value>
        </name>
      </properties>
    </Container>
  </subBlocks>
</ann:BmlAnnotation>
