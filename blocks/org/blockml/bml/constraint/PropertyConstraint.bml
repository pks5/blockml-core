<!--BlockML Constraint — property structural constraint branch

  FQN: org.blockml.bml.constraint.PropertyConstraint-->
<constraint:PropertyConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:MemberConstraint
  </baseType>
  <is>
    A rule for a Property
  </is>
  <documentation>
    Abstract branch for constraints on Property definitions (not property values —
    see ValueConstraint for value rules). Generic T binds to the effective PropertyDefinition of
    the enclosing Property. Valid only under a Property's &lt;constraints> container when the
    constraint extends PropertyConstraint (not ValueConstraint).
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="def:PropertyDefinition" />
  </genericTypes>
</constraint:PropertyConstraint>
