<!--BlockML Core — allowed child type aggregation constraint

  FQN: org.blockml.bml.constraint.AllowedChildType-->
<constraint:AllowedChildType xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:AggregationConstraint
  </baseType>
  <is>
    A rule for allowed child types
  </is>
  <documentation>
    Aggregation-level structural constraint. T binds to the effective
    AggregationDefinition. When validation is set, each composition child under the aggregation must
    resolve to the given Block type FQN. Reference implementation for AggregationConstraint branch.
  </documentation>
  <genericTypes>
    <T baseType="def:AggregationDefinition">
      <documentation>
        Bound to the effective AggregationDefinition of the enclosing Aggregation
        member.
      </documentation>
    </T>
  </genericTypes>
  <properties>
    <type type="org.blockml.bml.type.TypeReference(core:Block)">
      <documentation>
        Allowed Block type FQN for composition children.
      </documentation>
    </type>
  </properties>
</constraint:AllowedChildType>
