<!--BlockML Constraint — aggregation structural constraint branch

  FQN: org.blockml.bml.constraint.AggregationConstraint-->
<constraint:AggregationConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:MemberConstraint
  </baseType>
  <is>
    A rule for Aggregation members
  </is>
  <documentation>
    Abstract branch for constraints on Aggregation members. Generic T binds to the
    effective AggregationDefinition. Valid only under an Aggregation's &lt;constraints> container
    (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="def:AggregationDefinition">
      <documentation>
        Bound to the effective AggregationDefinition of the enclosing Aggregation
        member.
      </documentation>
    </T>
  </genericTypes>
</constraint:AggregationConstraint>
