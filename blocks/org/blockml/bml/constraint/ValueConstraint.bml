<!--BlockML Constraint — value constraint branch

  FQN: org.blockml.bml.constraint.ValueConstraint-->
<constraint:ValueConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Constraint
  </baseType>
  <is>
    A rule for a concrete value
  </is>
  <documentation>
    Abstract branch for value-level constraints. Generic parameter T binds automatically
    to the effective ValueType of the enclosing Property at validate time — authors never specify T
    in BML. Valid only under a Property member's &lt;constraints> container
    (BML_CONSTRAINT_TARGET_MISMATCH otherwise). Examples: Min, Max, Pattern, ValuePresent.
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="core:ValueType">
      <documentation>
        Bound automatically to the effective ValueType of the enclosing Property.
      </documentation>
    </T>
  </genericTypes>
</constraint:ValueConstraint>
