<!--BlockML Core — requires member block constraint

  FQN: org.blockml.bml.constraint.RequiresMember-->
<constraint:RequiresMember xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:BlockConstraint
  </baseType>
  <is>
    A rule that a member must exist
  </is>
  <documentation>
    Block-level structural constraint. T binds to the effective block definition type.
    When validation is set, the validator requires a member with the given local name in the
    effective member set of the Block. Reference implementation for BlockConstraint branch.
  </documentation>
  <genericTypes>
    <T baseType="def:BlockDefinition">
      <documentation>
        Bound to the effective block definition meta-model type (BlockDefinition and its
        subtypes).
      </documentation>
    </T>
  </genericTypes>
  <properties>
    <name type="org.blockml.bml.type.Text">
      <documentation>
        Required member local name (namespace + localName identity).
      </documentation>
    </name>
  </properties>
</constraint:RequiresMember>
