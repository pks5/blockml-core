<!--BlockML Core — requires implementation capability constraint

  FQN: org.blockml.bml.constraint.RequiresImplementation-->
<constraint:RequiresImplementation xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:CapabilityConstraint
  </baseType>
  <is>
    A rule that a Capability is implemented
  </is>
  <documentation>
    Capability-level structural constraint. T binds to the effective
    CapabilityDefinition. When validation is set, the Capability must declare an implementation
    binding on concrete Blocks. Reference implementation for CapabilityConstraint branch.
  </documentation>
  <genericTypes>
    <T baseType="def:CapabilityDefinition" />
  </genericTypes>
</constraint:RequiresImplementation>
