<!--BlockML Constraint — member structural constraint branch

  FQN: org.blockml.bml.constraint.MemberConstraint-->
<constraint:MemberConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:StructuralConstraint
  </baseType>
  <is>
    A rule for a Block member
  </is>
  <documentation>
    Abstract branch for member-level structural constraints. Generic T binds to the
    effective MemberDefinition subtype of the embedding context. Specialized by PropertyConstraint,
    AggregationConstraint, AssociationConstraint, and CapabilityConstraint.
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="def:MemberDefinition" />
  </genericTypes>
</constraint:MemberConstraint>
