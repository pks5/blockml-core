<!--BlockML Core — minimum value constraint

  FQN: org.blockml.bml.constraint.Min-->
<constraint:Min xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    constraint:ValueConstraint
  </baseType>
  <is>
    A lower bound on a number
  </is>
  <documentation>
    Scalar constraint: T binds to the property type. Compatible with Integer, Float,
    and Decimal properties. The value property must match T.
  </documentation>
  <genericTypes>
    <T baseType="type:Number">
      <documentation>
        Bound to the effective Number type of the enclosing Property (Integer, Float, or
        Decimal). The constraint value must match T.
      </documentation>
    </T>
  </genericTypes>
  <properties>
    <value type="T">
      <documentation>
        Minimum allowed value (inclusive).
      </documentation>
    </value>
  </properties>
</constraint:Min>
