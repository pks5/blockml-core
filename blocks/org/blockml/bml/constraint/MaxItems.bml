<!--BlockML Core — maximum items constraint

  FQN: org.blockml.bml.constraint.MaxItems-->
<constraint:MaxItems xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    constraint:ValueConstraint
  </baseType>
  <is>
    An upper bound on item count
  </is>
  <documentation>
    T binds to the property collection type (e.g. String[]). The value property is Integer — the maximum item count.
  </documentation>
  <genericTypes>
    <T baseType="core:ValueType" />
  </genericTypes>
  <properties>
    <value type="type:Integer">
      <documentation>
        Maximum number of items (inclusive).
      </documentation>
    </value>
  </properties>
</constraint:MaxItems>
