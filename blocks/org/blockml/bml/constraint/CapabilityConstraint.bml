<!--BlockML Constraint — capability structural constraint branch

  FQN: org.blockml.bml.constraint.CapabilityConstraint-->
<constraint:CapabilityConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:MemberConstraint
  </baseType>
  <is>
    A rule for a Capability
  </is>
  <documentation>
    Abstract branch for constraints on Capability members. Generic T binds to the
    effective CapabilityDefinition. Valid only under a Capability's &lt;constraints> container
    (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="def:CapabilityDefinition" />
  </genericTypes>
</constraint:CapabilityConstraint>
