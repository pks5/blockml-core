<!--BlockML Core — no self-reference association constraint

  FQN: org.blockml.bml.constraint.NoSelfReference-->
<constraint:NoSelfReference xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:AssociationConstraint
  </baseType>
  <is>
    A rule against self-reference
  </is>
  <documentation>
    Association-level structural constraint. T binds to the effective
    AssociationDefinition. When validation is set, association targets must not reference the
    enclosing Block's own type. Reference implementation for AssociationConstraint branch.
  </documentation>
  <genericTypes>
    <T baseType="def:AssociationDefinition" />
  </genericTypes>
</constraint:NoSelfReference>
