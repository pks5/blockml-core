<!--BlockML Core — minimum length constraint

  FQN: org.blockml.bml.constraint.MinLength-->
<constraint:MinLength xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    constraint:ValueConstraint
  </baseType>
  <is>
    A lower bound on length
  </is>
  <documentation>
    T binds to the property type for scalar String properties, or to the element type when the property is a collection (e.g. String[]). The value property is always Integer — the minimum length threshold.
  </documentation>
  <genericTypes>
    <T baseType="core:ValueType">
      <documentation>
        Bound to the property ValueType for scalar Text, or to the element type when the
        property is a collection.
      </documentation>
    </T>
  </genericTypes>
  <properties>
    <value type="type:Integer">
      <documentation>
        Minimum length (inclusive).
      </documentation>
    </value>
  </properties>
</constraint:MinLength>
