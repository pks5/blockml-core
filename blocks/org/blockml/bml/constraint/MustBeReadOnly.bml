<!--BlockML Core — must be read-only property constraint

  FQN: org.blockml.bml.constraint.MustBeReadOnly-->
<constraint:MustBeReadOnly xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:PropertyConstraint
  </baseType>
  <is>
    A rule that a Property is read-only
  </is>
  <documentation>
    Property-level structural constraint. T binds to the effective PropertyDefinition.
    When validation is set, the validator requires readOnly=true on the Property (authored or
    derived). Reference implementation for PropertyConstraint branch.
  </documentation>
  <genericTypes>
    <T baseType="def:PropertyDefinition">
      <documentation>
        Bound to the effective PropertyDefinition of the enclosing Property member.
      </documentation>
    </T>
  </genericTypes>
</constraint:MustBeReadOnly>
