<!--BlockML Constraint — association structural constraint branch

  FQN: org.blockml.bml.constraint.AssociationConstraint-->
<constraint:AssociationConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    constraint:MemberConstraint
  </baseType>
  <is>
    A rule for Association members
  </is>
  <documentation>
    Abstract branch for constraints on Association members. Generic T binds to the
    effective AssociationDefinition. Valid only under an Association's &lt;constraints> container
    (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
  </documentation>
  <abstract>
    true
  </abstract>
  <genericTypes>
    <T baseType="def:AssociationDefinition">
      <documentation>
        Bound to the effective AssociationDefinition of the enclosing Association
        member.
      </documentation>
    </T>
  </genericTypes>
</constraint:AssociationConstraint>
