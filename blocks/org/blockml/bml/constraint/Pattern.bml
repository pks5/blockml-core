<!--BlockML Core — pattern constraint

  FQN: org.blockml.bml.constraint.Pattern-->
<constraint:Pattern xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    constraint:ValueConstraint
  </baseType>
  <is>
    A text pattern rule
  </is>
  <documentation>
    T binds to org.blockml.bml.type.Text. The value property holds the regex pattern.
  </documentation>
  <genericTypes>
    <T baseType="type:Text" />
  </genericTypes>
  <properties>
    <value type="type:Text">
      <documentation>
        Regular expression the property value must match.
      </documentation>
    </value>
  </properties>
</constraint:Pattern>
