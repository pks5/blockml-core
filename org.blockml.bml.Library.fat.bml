      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_FINAL_MEMBER_OVERRIDE" />
      </keywords>
      <references>
        <see type="blockml:documentation.PartialMemberOverrides" relation="AuthoringGuide">
          final and private cannot be overridden.
        </see>
        <see type="blockml:documentation.MemberVisibility" relation="SeeAlso">
          Private override prohibition.
        </see>
        <see type="blockml:task.FixMemberOverride" relation="Resolves">
          Stop overriding sealed or private members.
        </see>
      </references>
    </block>
