    <!--BlockML Core — semantic version primitive type

  FQN: org.blockml.bml.type.Version-->
    <block>
      <name>
        Version
      </name>
      <type>
        blockml:type.Version
      </type>
      <baseType>
        blockml:type.Text
      </baseType>
      <is>
        A version number
      </is>
      <documentation>
        Textual primitive subtype for semantic version numbers (semver). Values use
            MAJOR.MINOR.PATCH form (for example 1.0.0, 1.3.2). Unqualified name Version resolves to
            org.blockml.bml.type.Version.
        
            Used wherever BlockML tracks or compares definition and reference versions: &lt;version> on
            Block and Library definitions, &lt;since> on members, changelog entries, and bml:version on
            composition instances. Concrete version strings are stored in Properties — not on the Version
            type itself.
      </documentation>
      <references>
        <see type="blockml:documentation.LibrarySystem" relation="AuthoringGuide">
          Version on Block and Library definitions.
        </see>
      </references>
    </block>
    <block>
      <name>
        VersionEntity
      </name>
      <type>
        blockml:type.VersionEntity
      </type>
      <baseType>
        blockml:core.PrimitiveEntity(blockml:type.Version)
      </baseType>
      <is>
        A version number as an Entity
      </is>
      <documentation>
        Concrete Entity wrapping a Version primitive. Binds T = Version on
            org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.
      </documentation>
    </block>
