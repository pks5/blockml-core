  <embeddedBlocks>
    <!--BlockML Core — README / library reading entry point

  FQN: org.blockml.bml.README-->
    <block>
      <name>
        README
      </name>
      <type>
        blockml:README
      </type>
      <baseType>
        blockml:core.ReadMe
      </baseType>
      <is>
        A library reading entry point
      </is>
      <documentation>
        README block for the BlockML core library. Start with references marked relation=ReadFirst —
        thirty-five documentation blocks in mental learning order. The early entries form the BlockML
        conceptual core — the core use cases, the type system, and the expression language
        (${ } and &lt;$ $>).
        Later entries cover conventions, authoring rules (visibility, overrides, member authoring,
        composition, annotations, directives, type identity, Sub-Blocks, contracts, constraints),
        organisation, and background knowledge.
        
        Library.bml points here via the required readMe aggregation (&lt;blockml:README />).
        Tooling filters references where relation=ReadFirst to build a curated learning context bundle;
        relation=TaskIndex lists accomplishable procedural tasks for humans, agents, and CI. Automated
        process SPOE uses Library.bootstrap (core:Bootstrap) — not this ReadMe.
      </documentation>
      <references>
        <see type="blockml:documentation.Introduction" relation="ReadFirst">
          Start here — BlockML goals and overview.
        </see>
        <see type="blockml:documentation.CoreUseCases" relation="ReadFirst">
          Why BlockML exists — structured documentation, domain modeling, AI workspaces.
        </see>
        <see type="blockml:documentation.EverythingIsABlock" relation="ReadFirst">
          Core principle — one root, one registry, one parser; everything is a Block.
        </see>
        <see type="blockml:documentation.BlockAndInstance" relation="ReadFirst">
          Definition, Block, Block instance, and composition — the core mental model.
        </see>
        <see type="blockml:documentation.DefinitionModel" relation="ReadFirst">
          Definition meta-model — is, members, documentation extensions on block definitions.
        </see>
        <see type="blockml:documentation.TypeSystemOverview" relation="ReadFirst">
          ValueTypes — four kinds; overview of type expressions.
        </see>
        <see type="blockml:documentation.TypeExpressions" relation="ReadFirst">
          Multiplicity, unions, obsolete wrappers, match order.
        </see>
        <see type="blockml:documentation.GenericsModel" relation="ReadFirst">
          Generics — declarations, inheritance binding, defaultType, constraints.
        </see>
        <see type="blockml:documentation.ValueTypeConfiguration" relation="ReadFirst">
          ValueType instance configuration on Property type references.
        </see>
        <see type="blockml:documentation.ConstantValueType" relation="ReadFirst">
          Constant(T){value: …} singleton domains for unions.
        </see>
        <see type="blockml:documentation.FunctionMappingModel" relation="ReadFirst">
          FunctionMapping — positional/named Capability call arguments.
        </see>
        <see type="blockml:documentation.CapabilitySemantics" relation="ReadFirst">
          Inbound, Outbound, Transformation — all behaviour as Capabilities.
        </see>
        <see type="blockml:documentation.Expressions" relation="ReadFirst">
          Expression language — ${ }, scope, V1 builtins, FunctionMapping.
        </see>
        <see type="blockml:documentation.EmbeddedExpressions" relation="ReadFirst">
          &lt;$ $> embeds inside Capability implementations.
        </see>
        <see type="blockml:documentation.CompilerArchitecture" relation="ReadFirst">
          Parser, validator, renderer pipeline — stages and responsibilities.
        </see>
        <see type="blockml:documentation.RendererFreedom" relation="ReadFirst">
          Manifestation is target-defined — BlockML prescribes grammar, not output.
        </see>
        <see type="blockml:documentation.LibrarySystem" relation="ReadFirst">
          Libraries, packages, namespaces, versioning, and blocks membership.
        </see>
        <see type="blockml:documentation.BmlNamespace" relation="ReadFirst">
          org.blockml.bml.* namespace layout and domain package conventions.
        </see>
        <see type="blockml:documentation.ImplicitNamespaceResolution" relation="ReadFirst">
          Context-bound implicit namespaces for unqualified references.
        </see>
        <see type="blockml:documentation.DocumentationModel" relation="ReadFirst">
          is, isNot, documentation, references, examples — the block documentation model.
        </see>
        <see type="blockml:documentation.BootstrapModel" relation="ReadFirst">
          README / ReadMe, Bootstrap SPOE, TypeRegistry bootstrap, and interpretation context.
        </see>
        <see type="blockml:documentation.ModelingGuidelines" relation="ReadFirst">
          Recommended patterns — baseType, contracts, capabilities, constraints.
        </see>
        <see type="blockml:documentation.ConstraintsModel" relation="ReadFirst">
          Constraints and suggestions — binding, validation severity, Enum rules.
        </see>
        <see type="blockml:documentation.MemberVisibility" relation="ReadFirst">
          Member and Sub-Block visibility — naming convention, access rules, aggregation IDs.
        </see>
        <see type="blockml:documentation.PartialMemberOverrides" relation="ReadFirst">
          Partial member overrides — merge semantics, abstract/final/override, readOnly.
        </see>
        <see type="blockml:documentation.MemberAuthoring" relation="ReadFirst">
          Property and Aggregation syntax — definition fields vs instance payloads; never wrap
          instances in &lt;value> or &lt;composition>.
        </see>
        <see type="blockml:documentation.CompositionModel" relation="ReadFirst">
          Composition — aggregation fill, placement, recursion, sibling sharing.
        </see>
        <see type="blockml:documentation.AnnotationModel" relation="ReadFirst">
          Annotation namespaces — Package vs Annotation, facets, directive taxonomy.
        </see>
        <see type="blockml:documentation.BmlDirectives" relation="ReadFirst">
          BML directives — bml:each, bml:if, bml:container, bml:with, bml:xml.
        </see>
        <see type="blockml:documentation.TypeIdentityDerivation" relation="ReadFirst">
          Type references and Block identity — FQN forms, root vs Sub-Block derivation.
        </see>
        <see type="blockml:documentation.SubBlockModel" relation="ReadFirst">
          Sub-Blocks, visibility, embedded Blocks, composition reference scope.
        </see>
        <see type="blockml:documentation.ContractsModel" relation="ReadFirst">
          Contracts — member merge, type bounds, baseType vs implements.
        </see>
        <see type="blockml:documentation.BlockNameConvention" relation="ReadFirst">
          Block &lt;name> PascalCase rules and relation to type identity.
        </see>
        <see type="blockml:documentation.PseudoCode" relation="ReadFirst">
          PseudoCode as semantic capability implementation dialect.
        </see>
        <see type="blockml:documentation.WOTFoundation" relation="ReadFirst">
          Optional background — Idea, Manifestation, Grammar, World (Web of Things).
        </see>
        <see type="blockml:task.AuthorNewBlock" relation="TaskIndex">
          Author a new Block definition from scratch.
        </see>
        <see type="blockml:task.AddConstraint" relation="TaskIndex">
          Attach a Constraint to a Block or member definition.
        </see>
        <see type="blockml:task.DebugUnknownType" relation="TaskIndex">
          Fix BML_UNKNOWN_TYPE — unresolved type reference.
        </see>
        <see type="blockml:task.FixVisibilityAccess" relation="TaskIndex">
          Fix visibility — private/protected access, narrowing, mismatches.
        </see>
        <see type="blockml:task.FixMemberOverride" relation="TaskIndex">
          Fix member overrides — override/abstract/final/readOnly.
        </see>
        <see type="blockml:task.FixCompositionPlacement" relation="TaskIndex">
          Fix composition placement — nest under aggregation members.
        </see>
        <see type="blockml:task.FixTypeIdentity" relation="TaskIndex">
          Fix type identity — root/Sub-Block/embedded and unqualified refs.
        </see>
        <see type="blockml:task.FixExpressionErrors" relation="TaskIndex">
          Fix expression errors — ${ }, embeds, beans, builtins, linking.
        </see>
        <see type="blockml:documentation.TaskGuideModel" relation="SeeAlso">
          TaskGuide blocks, task relations, and error-driven fix paths.
        </see>
        <see type="blockml:core.ReadMe" relation="Defines">
          Abstract ReadMe role marker — README is the core-library reading entry.
        </see>
        <see type="blockml:core.Bootstrap" relation="ContrastsWith">
          Automation SPOE branch — Library.bootstrap, not readMe.
        </see>
        <see type="blockml:Library" relation="SeeAlso">
          Published catalog of exported framework blocks, types, and services.
        </see>
      </references>
    </block>
    <!--BlockML — language annotation (bml: directives)

  FQN: org.blockml.bml.annotation.BmlAnnotation

  Preferred authoring binding:
    xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"-->
    <block>
      <name>
        BmlAnnotation
      </name>
      <type>
        blockml:annotation.BmlAnnotation
      </type>
      <baseType>
        blockml:core.Annotation
      </baseType>
      <is>
        The BlockML language annotation namespace
      </is>
      <documentation>
        Concrete Annotation for BlockML language directives. preferredAlias is bml. Authoring documents
        bind xmlns:bml to this FQN. Directives control composition structure, instance identity, service
        beans, and serialization shape — they are not Block properties and not Definition members.
        
        Attribute directives: id, version, bean, scope, status, each, if, unless, with, xml.
        Element directives: container.
        
        The legacy schema URI http://blockml.org/schema/bml remains an XSD/catalog identifier only —
        BML-semantic xmlns:bml must target this Annotation.
      </documentation>
      <references>
        <see type="blockml:core.Annotation" relation="Extends">
          Annotation branch — Package vs Annotation xmlns rule.
        </see>
        <see type="blockml:documentation.AnnotationModel" relation="SeeAlso">
          Annotation branch — facets and Package vs Annotation xmlns rule.
        </see>
        <see type="blockml:documentation.BmlDirectives" relation="AuthoringGuide">
          Normative placement and semantics for all bml: directives.
        </see>
        <see type="blockml:documentation.CompositionModel" relation="SeeAlso">
          Composition and bml:container as directive hosts.
        </see>
      </references>
      <properties>
        <preferredAlias override="true" type="blockml:type.Text">
          <documentation>
            Preferred xmlns prefix for BlockML language directives.
          </documentation>
          <value>bml</value>
        </preferredAlias>
      </properties>
      <aggregations>
        <directives override="true">
          <composition>
            <blockml:annotation.BmlAnnotation.Id />
            <blockml:annotation.BmlAnnotation.Version />
            <blockml:annotation.BmlAnnotation.Bean />
            <blockml:annotation.BmlAnnotation.Scope />
            <blockml:annotation.BmlAnnotation.Status />
            <blockml:annotation.BmlAnnotation.Each />
            <blockml:annotation.BmlAnnotation.If />
            <blockml:annotation.BmlAnnotation.Unless />
            <blockml:annotation.BmlAnnotation.With />
            <blockml:annotation.BmlAnnotation.Xml />
            <blockml:annotation.BmlAnnotation.Container />
          </composition>
        </directives>
      </aggregations>
      <subBlocks>
        <block>
          <name>
            Id
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Id
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A composition instance identity directive
          </is>
          <documentation>
            Attribute directive bml:id — instance identity within a composition tree.
                    Required when the instance is referenced or carries bml:each.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>id</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Version
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Version
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            An external type version pin directive
          </is>
          <documentation>
            Attribute directive bml:version — optional exact-version assert when a
                    composition reference targets an external block type.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>version</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Bean
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Bean
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A service bean registration directive
          </is>
          <documentation>
            Attribute directive bml:bean — registers the instance as a named service bean
                    for expression access via @beanName.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>bean</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Scope
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Scope
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A service bean visibility scope directive
          </is>
          <documentation>
            Attribute directive bml:scope — "local" or "context" for service bean
                    visibility. Default local when omitted.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>scope</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Status
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Status
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A lifecycle status attribute directive
          </is>
          <documentation>
            Attribute directive bml:status — shorthand status reference; unqualified
                    values resolve via org.blockml.bml.status.*.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>status</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Each
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Each
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A composition loop directive
          </is>
          <documentation>
            Attribute directive bml:each — expands the element once per loop iteration
                    (numeric or collection). See doc:BmlDirectives.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>each</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            If
          </name>
          <type>
            blockml:annotation.BmlAnnotation.If
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A conditional include directive
          </is>
          <documentation>
            Attribute directive bml:if — includes the element only when the expression
                    evaluates to true.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>if</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Unless
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Unless
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A conditional exclude directive
          </is>
          <documentation>
            Attribute directive bml:unless — includes the element only when the expression
                    evaluates to false. Negation of bml:if.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>unless</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            With
          </name>
          <type>
            blockml:annotation.BmlAnnotation.With
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A local variable scope directive
          </is>
          <documentation>
            Attribute directive bml:with — defines local variables visible within the
                    element and its descendants. See doc:BmlDirectives.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>with</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Xml
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Xml
          </type>
          <baseType>
            blockml:core.Annotation.Attribute
          </baseType>
          <is>
            A serialization shape directive
          </is>
          <documentation>
            Attribute or member-level directive bml:xml — declares how a definition or
                    member maps to XML when rendering BML from the BOM. Complements flow-control directives;
                    does not expand composition. See doc:BmlDirectives · 19_definition_blocks_and_bml_xml.md.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>xml</value>
            </name>
          </properties>
        </block>
        <block>
          <name>
            Container
          </name>
          <type>
            blockml:annotation.BmlAnnotation.Container
          </type>
          <baseType>
            blockml:core.Annotation.Element
          </baseType>
          <is>
            A virtual composition grouping element
          </is>
          <documentation>
            Element directive bml:container — virtual container that produces no Block
                    output but applies directives to a group of children.
          </documentation>
          <properties>
            <name final="true" override="true" type="blockml:type.Text">
              <value>container</value>
            </name>
          </properties>
        </block>
      </subBlocks>
    </block>
