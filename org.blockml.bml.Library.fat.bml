    <!--BlockML Core — BML_UNKNOWN_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_TYPE-->
    <block>
      <name>
        BML_UNKNOWN_TYPE
      </name>
      <type>
        blockml:diagnostic.BML_UNKNOWN_TYPE
      </type>
      <baseType>
        blockml:core.Diagnostic
      </baseType>
      <is>
        An unresolved-type diagnostic
      </is>
      <summary>
        Emitted when type, baseType, contract, language, or member type references an unknown or
            misspelled FQN — or when bootstrap order has not yet loaded the library that defines the type.
      </summary>
      <documentation>
        The validator expands the authored type reference to a canonical FQN and looks up the
        BlockDefinition in TypeRegistry. Failure means the type is not registered at validation time.
        Common causes: typo in FQN or xmlns prefix, missing Library blocks entry, unloaded dependency
        library, or reference to a Sub-Block type without the full parent-qualified path where required.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_UNKNOWN_TYPE" />
        <blockml:meta.FreeTextKeyword term="unknown type" />
        <blockml:meta.FreeTextKeyword term="unresolved FQN" />
        <blockml:meta.FreeTextKeyword term="TypeRegistry" />
      </keywords>
      <references>
        <see type="blockml:task.DebugUnknownType" relation="Resolves">
          Step-by-step fix — namespace, Library blocks, bootstrap order.
        </see>
        <see type="blockml:documentation.LibrarySystem" relation="Prerequisite">
          How libraries register blocks in TypeRegistry.
        </see>
        <see type="blockml:documentation.TypeIdentityDerivation" relation="SeeAlso">
          Type resolution and unknown-type diagnostics.
        </see>
      </references>
    </block>
