      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_OVERRIDE_WITHOUT_PARENT" />
      </keywords>
      <references>
        <see type="blockml:documentation.PartialMemberOverrides" relation="AuthoringGuide">
          new vs override modes.
        </see>
        <see type="blockml:task.FixMemberOverride" relation="Resolves">
          Remove override or fix inherited member identity.
        </see>
      </references>
    </block>
