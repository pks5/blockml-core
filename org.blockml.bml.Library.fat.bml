      </baseType>
      <is>
        A version-below-library diagnostic
      </is>
      <summary>
        Emitted when a Block version is below its exporting library.version policy.
      </summary>
      <documentation>
        Emitted when a Block version is below its exporting library.version policy. Remedy: Raise
        the Block version or align with library versioning conventions.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_VERSION_BELOW_LIBRARY" />
      </keywords>
      <references>
        <see type="blockml:documentation.LibrarySystem" relation="AuthoringGuide">
          Version resolution.
        </see>
      </references>
    </block>
