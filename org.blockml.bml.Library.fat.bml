      </name>
      <type>
        blockml:diagnostic.BML_OVERRIDE_REQUIRED
      </type>
      <baseType>
        blockml:core.Diagnostic
      </baseType>
      <is>
        An override-required diagnostic
      </is>
      <summary>
        Emitted when a local member redeclaration merges with a baseType or contracts member without override="true".
      </summary>
      <documentation>
        Every redeclaration layer that merges with an inherited or contract member must set override="true" again — including contract completion. Override is not inherited.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_OVERRIDE_REQUIRED" />
      </keywords>
      <references>
        <see type="blockml:documentation.PartialMemberOverrides" relation="AuthoringGuide">
          override="true" required on merge.
        </see>
        <see type="blockml:documentation.ContractsModel" relation="SeeAlso">
          Contract member completion.
        </see>
        <see type="blockml:task.FixMemberOverride" relation="Resolves">
          Add override="true" or rename as a new member.
        </see>
      </references>
    </block>
