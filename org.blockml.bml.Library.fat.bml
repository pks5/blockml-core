    <!--BlockML Core — BML_CARDINALITY_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CARDINALITY_VIOLATION-->
    <block>
      <name>
        BML_CARDINALITY_VIOLATION
      </name>
      <type>
        blockml:diagnostic.BML_CARDINALITY_VIOLATION
      </type>
      <baseType>
        blockml:core.Diagnostic
      </baseType>
      <is>
        A cardinality-violation diagnostic
      </is>
      <summary>
        Emitted when an aggregation child count or association InstanceReference token count violates the type multiplicity.
      </summary>
      <documentation>
        Emitted when an aggregation child count or association InstanceReference token count violates
        the type multiplicity. Remedy: Adjust the number of aggregation children or association pointer
        tokens, or the member multiplicity. Association cardinality is limited to 0..1 and 0..n —
        required-single notations (1..1, 1..n) are invalid on associations.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_CARDINALITY_VIOLATION" />
      </keywords>
      <references>
        <see type="blockml:documentation.TypeExpressions" relation="AuthoringGuide">
          Multiplicity.
        </see>
        <see type="blockml:documentation.CompositionModel" relation="SeeAlso">
          Aggregation fill.
        </see>
        <see type="blockml:type.InstanceReference" relation="SeeAlso">
          Association payload — pointer tokens, not composition children.
        </see>
      </references>
    </block>
