        <see type="blockml:core.TaskGuide" relation="SeeAlso">
          Procedural task guides — org.blockml.bml.task.* blocks.
        </see>
        <see type="blockml:documentation.DocumentationModel" relation="AuthoringGuide">
          Block documentation model.
        </see>
      </references>
    </block>
