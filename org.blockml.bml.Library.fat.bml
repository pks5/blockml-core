    <!--BlockML Core — function parameter mapping

  FQN: org.blockml.bml.mapping.FunctionMapping-->
    <block>
      <name>
        FunctionMapping
      </name>
      <type>
        blockml:mapping.FunctionMapping
      </type>
      <baseType>
        blockml:core.Mapping
      </baseType>
      <is>
        A function-call to Capability Mapping
      </is>
      <documentation>
        Concrete Mapping for function-like call syntax. Describes translation between a
        function-parameter list and a Capability inputType or outputType.
        
        Two application sites (opposite directions):
        1. Expression calls — function syntax → FunctionMapping → Capability inputType
        2. Capability implementation — Capability inputType → FunctionMapping → target-language
           function parameters (and reverse for return values)
        
        Canonical call form passes a value matching inputType directly, using JSON-like syntax:
        • Primitive → primitive literal
        • StructType → object literal
        • Collection → array literal
        
        Helper syntax (when supported by this mapping):
        • Named parameters — mapped by StructType property names; order irrelevant
        • Positional parameters — mapped by property declaration order (mapping config only;
          does not create general StructType index semantics)
        
        Default FunctionMapping (used when no explicit mapping is declared on an implementation):
        • Primitive inputType — exactly one positional or named parameter
        • StructType inputType — object literal (canonical), named parameters, or positional
          parameters by declaration order
        • Primitive collection — positional parameters → array literal
        • StructType collection — one outer parameter per struct instance → array literal
        • Mixed positional and named arguments — not supported (BML_MIXED_FUNCTION_ARGUMENTS)
        
        Capability implementations that require a target-language function signature must declare an
        explicit FunctionMapping child when the default rules are insufficient.
        
        Validation errors: BML_UNKNOWN_FUNCTION_PARAMETER, BML_DUPLICATE_FUNCTION_PARAMETER,
        BML_MISSING_FUNCTION_PARAMETER, BML_TOO_MANY_FUNCTION_PARAMETERS,
        BML_MIXED_FUNCTION_ARGUMENTS, BML_MISSING_FUNCTION_MAPPING,     BML_AMBIGUOUS_FUNCTION_MAPPING.
      </documentation>
      <references>
        <see type="blockml:documentation.FunctionMappingModel" relation="AuthoringGuide">
          Normative FunctionMapping rules and call forms.
        </see>
        <see type="blockml:documentation.ValueTypeConfiguration" relation="SeeAlso">
          Shared declaration-order principle for positional {…}.
        </see>
        <see type="blockml:documentation.Expressions" relation="SeeAlso">
          Expression call sites.
        </see>
      </references>
      <properties>
        <supportsPositional type="blockml:type.Boolean">
          <documentation>
            Allow positional function parameters mapped by property declaration order.
          </documentation>
          <value>true</value>
        </supportsPositional>
        <supportsNamed type="blockml:type.Boolean">
          <documentation>
            Allow named function parameters mapped by StructType property names.
          </documentation>
          <value>true</value>
        </supportsNamed>
        <supportsMixed type="blockml:type.Boolean">
          <documentation>
            Allow mixing positional and named parameters in one call. Default false.
          </documentation>
          <value>false</value>
        </supportsMixed>
      </properties>
    </block>
    <!--BlockML Core — fixed catalogue alias entity

  FQN: org.blockml.bml.meta.FixedAlias-->
    <block>
      <name>
        FixedAlias
      </name>
      <type>
        blockml:meta.FixedAlias
      </type>
      <baseType>
        blockml:core.Alias
      </baseType>
      <is>
        A catalogue-fixed alternative name
      </is>
      <documentation>
        Protected base for domain catalogue Alias blocks. Extends org.blockml.bml.core.Alias
            for controlled alternative names whose payload is authored once on the alias Block definition —
            not at each &lt;aliases> reference site. Domain libraries declare concrete alias blocks
            extending FixedAlias and set protected members in &lt;properties> (for example
            &lt;_name>Sub-Block&lt;/_name>). References in &lt;aliases> are empty fixed blocks
            (for example &lt;vocab:SubBlockAlias />) — type FQN is the catalogue identity; name,
            language, and legacy resolve from the alias definition.
        
            org.blockml.bml.meta.FreeTextAlias extends FixedAlias and widens the same members to public
            attributes (`_name` → `name`, …) for ad-hoc names configured per &lt;aliases> reference —
            visibility widening on override; see doc:MemberVisibility.
            FixedAlias members use the protected naming convention (_*) and are set only on derived alias
            block definitions — not on composition instances in &lt;aliases>. Comma-separated shorthand on
            &lt;aliases> does not expand to FixedAlias instances.
      </documentation>
      <abstract>
        true
      </abstract>
      <properties>
        <_name abstract="true" bml:xml="element" type="blockml:type.Text">
          <documentation>
            Required alternative name text — set on each concrete alias block definition.
                    Stored in BOM AliasEntry.name when resolved from a FixedAlias descendant. Protected member
                    (_ prefix) — configurable only on derived alias block definitions, not at &lt;aliases>
                    reference sites.
          </documentation>
          <constraints>
            <blockml:constraint.ValuePresent validation="Error" />
          </constraints>
        </_name>
        <_language bml:xml="element" type="blockml:type.TypeReference(blockml:language.NaturalLanguage)">
          <documentation>
            Optional NaturalLanguage when this alias is written in a language other than the
                    effective language of blocks that reference it. Set on the alias block definition. Unqualified
                    names resolve via org.blockml.bml.language.*. Omitted = inherit effective language at
                    resolution time.
          </documentation>
        </_language>
        <_legacy bml:xml="element" type="blockml:type.Boolean">
          <documentation>
            When true, marks a deprecated or legacy catalogue name — prefer the canonical
                    Block name and &lt;is> in new prose. Set on the alias block definition. Default false when
                    omitted.
          </documentation>
          <value>false</value>
        </_legacy>
      </properties>
    </block>
    <!--BlockML Core — fixed catalogue keyword entity

  FQN: org.blockml.bml.meta.FixedKeyword-->
    <block>
      <name>
        FixedKeyword
      </name>
      <type>
        blockml:meta.FixedKeyword
      </type>
      <baseType>
        blockml:core.Keyword
      </baseType>
      <is>
        A catalogue-fixed search tag
      </is>
      <documentation>
        Protected base for domain catalogue Keyword blocks. Extends org.blockml.bml.core.Keyword
            for controlled vocabulary tags whose payload is authored once on the keyword Block definition —
            not at each &lt;keywords> reference site. Domain libraries declare concrete keyword blocks
            extending FixedKeyword and set protected members in &lt;properties> (for example
            &lt;_term>inheritance&lt;/_term>). References in &lt;keywords> are empty fixed blocks
            (for example &lt;vocab:Inheritance />) — type FQN is the catalogue identity; term, language,
            and weight resolve from the keyword definition.
        
            org.blockml.bml.meta.FreeTextKeyword extends FixedKeyword and widens the same members to public
            attributes (`_term` → `term`, …) for ad-hoc tags configured per &lt;keywords> reference —
            visibility widening on override; see doc:MemberVisibility.
            FixedKeyword members use the protected naming convention (_*) and are set only on derived keyword
            block definitions — not on composition instances in &lt;keywords>. Comma-separated shorthand on
            &lt;keywords> does not expand to FixedKeyword instances.
      </documentation>
      <abstract>
        true
      </abstract>
      <properties>
        <_term abstract="true" bml:xml="element" type="blockml:type.Text">
          <documentation>
            Required search tag text — set on each concrete keyword block definition. Stored
                    in BOM KeywordEntry.term when resolved from a FixedKeyword descendant. Protected member (_
                    prefix) — configurable only on derived keyword block definitions, not at &lt;keywords>
                    reference sites.
          </documentation>
          <constraints>
            <blockml:constraint.ValuePresent validation="Error" />
          </constraints>
        </_term>
        <_language bml:xml="element" type="blockml:type.TypeReference(blockml:language.NaturalLanguage)">
          <documentation>
            Optional NaturalLanguage when this tag is written in a language other than the
                    effective language of blocks that reference it. Set on the keyword block definition.
                    Unqualified names resolve via org.blockml.bml.language.*. Omitted = inherit effective
                    language at resolution time.
          </documentation>
        </_language>
        <_weight bml:xml="element" type="blockml:type.Integer">
          <documentation>
            Optional RAG ranking hint — higher values rank stronger in discovery indexes.
                    Set on the keyword block definition. Omitted = default weight.
          </documentation>
        </_weight>
      </properties>
    </block>
    <!--BlockML Core — free-text alias entity

  FQN: org.blockml.bml.meta.FreeTextAlias-->
    <block>
      <name>
        FreeTextAlias
      </name>
      <type>
        blockml:meta.FreeTextAlias
      </type>
      <baseType>
        blockml:meta.FixedAlias
      </baseType>
      <is>
        An ad-hoc alternative type name
      </is>
      <documentation>
        Standard free-text specialization of org.blockml.bml.meta.FixedAlias for colloquial or
            legacy alternative names on Block definitions. Extends FixedAlias and widens protected catalogue
            members to public attributes via visibility widening (`_name` → `name`, same for language and
            legacy) — see doc:MemberVisibility. Types are inherited from
            FixedAlias and omitted on these overrides. Rendered as a direct child inside &lt;aliases> (for
            example &lt;meta:FreeTextAlias name="Sub-Block" />). Comma-separated plain text on
            &lt;aliases> is shorthand that expands to FreeTextAlias instances only. For catalogue-controlled
            alternative names, domain libraries define concrete Alias blocks extending FixedAlias (members
            stay protected on the definition) or org.blockml.bml.core.Alias directly for empty identity-only
            aliases.
        
            Instance configuration: FreeTextAlias{name: "Sub-Block"}. Block-level only — members do not carry
            aliases. Not XML namespace prefix aliases.
      </documentation>
      <properties>
        <name override="true" bml:xml="attribute">
          <documentation>
            Required alternative name text — public override of FixedAlias._name. Stored in
                    BOM AliasEntry.name when typeFqn is org.blockml.bml.meta.FreeTextAlias — Entity property name,
                    not Block definition &lt;name>. Authored as attribute on &lt;aliases> reference sites.
          </documentation>
        </name>
        <language override="true" bml:xml="attribute">
          <documentation>
            Optional NaturalLanguage — public override of FixedAlias._language. When this
                    alias is written in a language other than the effective language of the enclosing block
                    definition. Unqualified names resolve via org.blockml.bml.language.*. Omitted = inherit
                    effective language.
          </documentation>
        </language>
        <legacy override="true" bml:xml="attribute">
          <documentation>
            When true, marks a deprecated or legacy name — public override of
                    FixedAlias._legacy. Prefer the canonical Block name and &lt;is> in new prose. Default false when
                    omitted.
          </documentation>
        </legacy>
      </properties>
    </block>
    <!--BlockML Core — free-text keyword entity

  FQN: org.blockml.bml.meta.FreeTextKeyword-->
    <block>
      <name>
        FreeTextKeyword
      </name>
      <type>
        blockml:meta.FreeTextKeyword
      </type>
      <baseType>
        blockml:meta.FixedKeyword
      </baseType>
      <is>
        An ad-hoc free-text search tag
      </is>
      <documentation>
        Standard free-text specialization of org.blockml.bml.meta.FixedKeyword for ad-hoc RAG
            and discovery tags. Extends FixedKeyword and widens protected catalogue members to public
            attributes via visibility widening (`_term` → `term`, same for language and weight) — see
            doc:MemberVisibility. Types are inherited from FixedKeyword
            and omitted on these overrides. Rendered as a direct child inside &lt;keywords> (for example
            &lt;meta:FreeTextKeyword term="inheritance" />). Comma-separated plain text on &lt;keywords>
            is shorthand that expands to FreeTextKeyword instances — one term per trimmed token. For
            controlled vocabulary tags, domain libraries define concrete Keyword blocks extending
            FixedKeyword (members stay protected on the definition) or org.blockml.bml.core.Keyword directly
            for empty identity-only tags.
        
            Instance configuration at type reference sites: FreeTextKeyword{term: "inheritance"}. Not to be
            confused with XML namespace prefix aliases.
      </documentation>
      <properties>
        <term override="true" bml:xml="attribute">
          <documentation>
            Required search tag text — public override of FixedKeyword._term. Stored in BOM
                    KeywordEntry.term when typeFqn is org.blockml.bml.meta.FreeTextKeyword. Authored as attribute
                    on &lt;keywords> reference sites.
          </documentation>
        </term>
        <language override="true" bml:xml="attribute">
          <documentation>
            Optional NaturalLanguage — public override of FixedKeyword._language. When this
                    tag is written in a language other than the effective language of the enclosing definition
                    element. Unqualified names resolve via org.blockml.bml.language.*. Omitted = inherit effective
                    language from Block or Library.
          </documentation>
        </language>
        <weight override="true" bml:xml="attribute">
          <documentation>
            Optional RAG ranking hint — public override of FixedKeyword._weight. Higher
                    values rank stronger in discovery indexes. Omitted = default weight.
          </documentation>
        </weight>
      </properties>
    </block>
    <!--BlockML Core — authoring-guide relation

  FQN: org.blockml.bml.relation.AuthoringGuide-->
    <block>
      <name>
        AuthoringGuide
      </name>
      <type>
        blockml:relation.AuthoringGuide
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A how-to-author Relation
      </is>
      <documentation>
        Typical file= targets — repository markdown with authoring rules, examples, or
            migration notes. Use when the link is procedural ("how to write…") rather than structural
            (Extends) or optional background (SeeAlso).
      </documentation>
    </block>
    <!--BlockML Core — contrasts-with relation

  FQN: org.blockml.bml.relation.ContrastsWith-->
    <block>
      <name>
        ContrastsWith
      </name>
      <type>
        blockml:relation.ContrastsWith
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A do-not-confuse Relation
      </is>
      <documentation>
        Use to disambiguate easily confused concepts — for example Sub-Block vs embedded Block,
            contract vs baseType, Inbound vs Outbound capability. The context text body must explain the
            difference explicitly.
      </documentation>
    </block>
    <!--BlockML Core — deep-dive relation

  FQN: org.blockml.bml.relation.DeepDive-->
    <block>
      <name>
        DeepDive
      </name>
      <type>
        blockml:relation.DeepDive
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        An extended-background Relation
      </is>
      <documentation>
        Use for file= or url= targets with long-form prose the reader may skip on first
            pass. Distinct from Requires (mandatory) and AuthoringGuide (procedural). Typical for architecture
            documents, WOT foundation, or specification deep-dives.
      </documentation>
    </block>
    <!--BlockML Core — defines relation

  FQN: org.blockml.bml.relation.Defines-->
    <block>
      <name>
        Defines
      </name>
      <type>
        blockml:relation.Defines
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A defines-the-shape Relation
      </is>
      <documentation>
        Use when the referenced Block or Definition element is the formal specification
            the current type conforms to — for example def:PropertyDefinition on a property member, or
            core:Bootstrap on a README block.
      </documentation>
    </block>
    <!--BlockML Core — extends relation

  FQN: org.blockml.bml.relation.Extends-->
    <block>
      <name>
        Extends
      </name>
      <type>
        blockml:relation.Extends
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        An inheritance Relation
      </is>
      <documentation>
        Use when the referenced Block is in the baseType chain or represents a branch the
            current type belongs to. Typical type= targets only — not for file or url references.
      </documentation>
    </block>
    <!--BlockML Core — prerequisite relation

  FQN: org.blockml.bml.relation.Prerequisite-->
    <block>
      <name>
        Prerequisite
      </name>
      <type>
        blockml:relation.Prerequisite
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A do-this-first Relation
      </is>
      <documentation>
        Use on &lt;see> entries at the start of a TaskGuide &lt;references> container
            — before TaskStep entries. Distinct from Requires (dependency of the current definition) and
            ReadFirst (library-wide learning path). Prerequisite scopes to one task procedure.
      </documentation>
    </block>
    <!--BlockML Core — read-first relation

  FQN: org.blockml.bml.relation.ReadFirst-->
    <block>
      <name>
        ReadFirst
      </name>
      <type>
        blockml:relation.ReadFirst
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A read-this-first Relation
      </is>
      <documentation>
        Two uses:
            1. Concrete Library.bml — required single ReadFirst &lt;see> targeting the ReadMe named in
               the readMe aggregation (catalog entry point). May be followed by ThenContinueWith → Bootstrap
               when bootstrap is present; no other &lt;see> relations on concrete Libraries.
            2. README / ReadMe blocks — curated mental learning order. ReadFirst entries should appear
               first in &lt;references>, in reading order.
        
            Distinct from Library.readMe (aggregation that names the ReadMe block) and from ReadNext
            (forward edge between documentation blocks outside the README catalog).
      </documentation>
    </block>
    <!--BlockML Core — read-next relation

  FQN: org.blockml.bml.relation.ReadNext-->
    <block>
      <name>
        ReadNext
      </name>
      <type>
        blockml:relation.ReadNext
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A continue-reading Relation
      </is>
      <documentation>
        Use on &lt;see> entries in documentation blocks (org.blockml.bml.documentation.*)
            to point to the next topic in a learning chain — typically body text starting with
            "Next reading step". Distinct from ReadFirst (README curated entry points), Prerequisite
            (task-scoped do-this-first), and SeeAlso (optional peer link). ReadNext is a single forward
            edge between narrative documentation blocks, not a library-wide ordered catalog.
      </documentation>
    </block>
    <!--BlockML Core — requires relation

  FQN: org.blockml.bml.relation.Requires-->
    <block>
      <name>
        Requires
      </name>
      <type>
        blockml:relation.Requires
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A must-understand Relation
      </is>
      <documentation>
        Use for hard dependencies — types, documentation, or external resources the reader
            or runtime must know first. Distinct from ReadFirst (curated path) and SeeAlso (optional peer link).
      </documentation>
    </block>
    <!--BlockML Core — resolves relation

  FQN: org.blockml.bml.relation.Resolves-->
    <block>
      <name>
        Resolves
      </name>
      <type>
        blockml:relation.Resolves
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A fixes-this-diagnostic Relation
      </is>
      <documentation>
        Use on &lt;see> entries in org.blockml.bml.diagnostic.* blocks to link a
            validator code to a procedural fix guide. Target should reference an org.blockml.bml.task.*
            TaskGuide block. Enables error-driven navigation: reported BML_* code → Diagnostic block →
            Resolves → TaskGuide with TaskStep entries.
      </documentation>
    </block>
    <!--BlockML Core — see-also relation

  FQN: org.blockml.bml.relation.SeeAlso-->
    <block>
      <name>
        SeeAlso
      </name>
      <type>
        blockml:relation.SeeAlso
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A related-peer Relation
      </is>
      <documentation>
        Default relation when relation is omitted on &lt;see>. Use for related Blocks,
            documentation files, or URLs that help understand the current definition but do not extend,
            require, or define it. Omitted relation= on &lt;see> resolves to this block.
      </documentation>
    </block>
    <!--BlockML Core — task index relation

  FQN: org.blockml.bml.relation.TaskIndex-->
    <block>
      <name>
        TaskIndex
      </name>
      <type>
        blockml:relation.TaskIndex
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A listed-task Relation
      </is>
      <documentation>
        Use on &lt;see> entries in README / ReadMe blocks to list accomplishable tasks.
            Distinct from ReadFirst (mental learning order) and SeeAlso (optional peer link). Tooling
            filters relation=TaskIndex to build a task menu for humans, agents, or CI. Target should
            reference an org.blockml.bml.task.* TaskGuide block.
      </documentation>
    </block>
    <!--BlockML Core — task step relation

  FQN: org.blockml.bml.relation.TaskStep-->
    <block>
      <name>
        TaskStep
      </name>
      <type>
        blockml:relation.TaskStep
      </type>
      <baseType>
        blockml:core.Relation
      </baseType>
      <is>
        A next-step Relation
      </is>
      <documentation>
        Use on &lt;see> entries inside org.blockml.bml.task.* TaskGuide blocks.
            Document order in &lt;references> is step order — same convention as ReadFirst on README.
            Target may be a Block, repository markdown file, or external URL. Distinct from Prerequisite
            (before starting the task) and Requires (hard dependency on the current definition).
      </documentation>
    </block>
    <!--BlockML Core — then-continue-with relation

  FQN: org.blockml.bml.relation.ThenContinueWith-->
    <block>
      <name>
        ThenContinueWith
      </name>
      <type>
        blockml:relation.ThenContinueWith
      </type>
      <baseType>
        blockml:core.TypeRelation(blockml:core.Bootstrap)
      </baseType>
      <is>
        A after-reading-continue Relation
      </is>
      <documentation>
        TypeRelation(core:Bootstrap) — use on concrete Library &lt;see type="…"> entries
            to point at the library's Bootstrap SPOE after the human/LLM reading entry. Target must be a
            type reference whose resolved type satisfies satisfiesTypeBound(…, core:Bootstrap); file/url/
            instance/member targets are forbidden (TypeRelation rule).
        
            Sequence on Library.bml: ReadFirst → ReadMe (required), then ThenContinueWith → Bootstrap when
            the library declares a bootstrap aggregation. Distinct from ReadNext (narrative learning chain)
            and from TaskIndex / TaskStep (task catalog). Signals: after reading, continue with the
            automation entry.
      </documentation>
      <references>
        <see type="blockml:core.TypeRelation" relation="Extends">
          Type-target Relation — ThenContinueWith binds T = core:Bootstrap.
        </see>
        <see type="blockml:relation.ReadFirst" relation="SeeAlso">
          Required Library reading-entry edge — precedes ThenContinueWith.
        </see>
        <see type="blockml:core.Bootstrap" relation="Requires">
          Required see type= target branch (T).
        </see>
        <see type="blockml:core.BlockLibrary" relation="SeeAlso">
          Concrete Library references rule — at most ReadFirst + ThenContinueWith.
        </see>
      </references>
    </block>
    <!--BlockML Core Services

  Name: Bools Service
  Filename: Bools.bml
  FQN: org.blockml.bml.service.Bools
  Expression prefix: #bools.*-->
    <block>
      <name>
        Bools
      </name>
      <type>
        blockml:service.Bools
      </type>
      <baseType>
        blockml:core.Entity
      </baseType>
      <is>
        A boolean expression service
      </is>
      <documentation>
        Built-in booleans service. Expression prefix #bools.* — logical and boolean
            conversion utilities.
      </documentation>
      <capabilities>
        <!--#bools.isTrue(x)-->
        <isTrue type="blockml:capability.Transformation" inputType="blockml:type.Boolean" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if x is strictly true.
            Examples:
            #bools.isTrue(true) → true
            #bools.isTrue(1) → false
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: boolean): boolean => x === true]]>
          </implementation>
        </isTrue>
        <!--#bools.isFalse(x)-->
        <isFalse type="blockml:capability.Transformation" inputType="blockml:type.Boolean" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if x is strictly false.
            Examples:
            #bools.isFalse(false) → true
            #bools.isFalse(0) → false
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: boolean): boolean => x === false]]>
          </implementation>
        </isFalse>
      </capabilities>
    </block>
    <!--BlockML Core Services

  Name: Lists Service
  Filename: Lists.bml
  FQN: org.blockml.bml.service.Lists
  Expression prefix: #lists.*-->
    <block>
      <name>
        Lists
      </name>
      <type>
        blockml:service.Lists
      </type>
      <baseType>
        blockml:core.Entity
      </baseType>
      <is>
        A list expression service
      </is>
      <documentation>
        Built-in lists service. Expression prefix #lists.* — list construction,
            indexing, and aggregation utilities.
        
            Inputs typed core:ValueType[] are compatible with a collection of any element type, because
            collections are compared per element type and every ValueType is assignable to ValueType:
            Integer[] &lt;: Number[] &lt;: PrimitiveType[] &lt;: ValueType[], Text[] &lt;: ValueType[]. Elements are
            validated independently, so heterogeneous collections such as [1, "text", true] are accepted
            here. Capabilities declaring a narrower element type are homogeneous by that element type —
            sequence returns Integer[], where [1, "text", 3] would be invalid. Element access (first, last,
            get) declares core:ValueType as output — the element type of its core:ValueType[] input; the
            concrete ValueType of the returned element follows the list element at runtime.
        
            Multi-argument capabilities use an anonymous StructType whose field types are full
            TypeExpressions — { list: core:ValueType[], index: Integer } on get is one anonymous StructType
            with a qualified, multiplicity-carrying list field and an unqualified index field. concat takes a
            nested multiplicity instead — (core:ValueType[])[], a collection of lists, where every call
            argument becomes one element of the outer collection.
            See doc:TypeExpressions — Collection compatibility · Heterogeneous collections ·
            Nested multiplicities · Anonymous StructTypes.
      </documentation>
      <capabilities>
        <!--#lists.size(list)-->
        <size type="blockml:capability.Transformation" inputType="blockml:core.ValueType[]" outputType="blockml:type.Integer">
          <documentation>
            Returns the number of elements in list.
            core:ValueType[] accepts Integer[], Text[], … and heterogeneous element types alike.
            Examples:
            #lists.size([1, 2, 3]) → 3
            #lists.size([1, "text", true]) → 3
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[]): number => list.length]]>
          </implementation>
        </size>
        <!--#lists.isEmpty(list)-->
        <isEmpty type="blockml:capability.Transformation" inputType="blockml:core.ValueType[]" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if list has no elements.
            Examples:
            #lists.isEmpty([]) → true
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[]): boolean => list.length === 0]]>
          </implementation>
        </isEmpty>
        <!--#lists.contains(list, element)-->
        <contains type="blockml:capability.Transformation" inputType="{ list: blockml:core.ValueType[], element: blockml:core.ValueType }" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if list contains element.
            Examples:
            #lists.contains([1, 2, 3], 2) → true
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[], element: unknown): boolean => list.includes(element)]]>
          </implementation>
        </contains>
        <!--#lists.first(list)-->
        <first type="blockml:capability.Transformation" inputType="blockml:core.ValueType[]" outputType="blockml:core.ValueType">
          <documentation>
            Returns the first element of list.
            The declared output type is the input's element type — the concrete ValueType of the
            returned element follows the list element at runtime.
            Examples:
            #lists.first([10, 20, 30]) → 10
            #lists.first(["a", "b"]) → "a"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[]): unknown => list[0]]]>
          </implementation>
        </first>
        <!--#lists.last(list)-->
        <last type="blockml:capability.Transformation" inputType="blockml:core.ValueType[]" outputType="blockml:core.ValueType">
          <documentation>
            Returns the last element of list.
            The declared output type is the input's element type — the concrete ValueType of the
            returned element follows the list element at runtime.
            Examples:
            #lists.last([10, 20, 30]) → 30
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[]): unknown => list[list.length - 1]]]>
          </implementation>
        </last>
        <!--#lists.get(list, index)-->
        <get type="blockml:capability.Transformation" inputType="{ list: blockml:core.ValueType[], index: blockml:type.Integer }" outputType="blockml:core.ValueType">
          <documentation>
            Returns the element at index in list.
            The declared output type is the list's element type — the concrete ValueType of the
            returned element follows the list element at runtime.
            Examples:
            #lists.get([10, 20, 30], 1) → 20
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(list: unknown[], index: number): unknown => list[index]]]>
          </implementation>
        </get>
        <!--#lists.concat(a, b, ...)-->
        <concat type="blockml:capability.Transformation" inputType="(blockml:core.ValueType[])[]" outputType="blockml:core.ValueType[]">
          <documentation>
            Concatenates all list arguments into a single list.
            The input is a nested multiplicity — (core:ValueType[])[] is a collection of
            core:ValueType[] collections, written with explicit grouping because multiplicity is a
            postfix operation on a TypeExpression (Integer[][] is not valid notation). The collection
            FunctionMapping rule applies to the outer collection, so each argument of the call is one
            outer element and the inner lists are validated recursively against core:ValueType[]:
            #lists.concat([1, 2], [3, 4], ["a"]) → input value [[1, 2], [3, 4], ["a"]]
            Argument element types need not match — the result element type is core:ValueType.
            Examples:
            #lists.concat([1, 2], [3, 4]) → [1, 2, 3, 4]
            #lists.concat([1, 2], ["a"]) → [1, 2, "a"]
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(...lists: unknown[][]): unknown[] => lists.flat()]]>
          </implementation>
        </concat>
        <!--#lists.sequence(start, end)  or  #lists.sequence(start, end, step)
      Generates a numeric sequence from start to end (inclusive) with optional step.
      When step is omitted, defaults to 1 (or -1 when start &gt; end).-->
        <sequence type="blockml:capability.Transformation" inputType="{ start: blockml:type.Integer, end: blockml:type.Integer, step: blockml:type.Integer }" outputType="blockml:type.Integer[]">
          <documentation>
            Generates a sequence of integers from start to end (inclusive).
            step defaults to 1 when start &lt;= end, -1 when start > end.
            The Integer[] result is assignable to Number[] and core:ValueType[] — collections are
            compatible per element type.
            Examples:
            #lists.sequence(1, 5) → [1, 2, 3, 4, 5]
            #lists.sequence(0, 10, 2) → [0, 2, 4, 6, 8, 10]
            #lists.sequence(5, 1) → [5, 4, 3, 2, 1]
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (start: number, end: number, step?: number): number[] => {
              const s = step ?? (start <= end ? 1 : -1);
              const result: number[] = [];
              if (s > 0) {
                for (let i = start; i <= end; i += s) result.push(i);
              } else if (s < 0) {
                for (let i = start; i >= end; i += s) result.push(i);
              }
              return result;
            }
            ]]>
          </implementation>
        </sequence>
      </capabilities>
    </block>
    <!--BlockML Core Services

  Name: Math Service
  Filename: Math.bml
  FQN: org.blockml.bml.service.Math
  Expression prefix: #math.*-->
    <block>
      <name>
        Math
      </name>
      <type>
        blockml:service.Math
      </type>
      <baseType>
        blockml:core.Entity
      </baseType>
      <is>
        A numeric expression service
      </is>
      <documentation>
        Built-in math service. Expression prefix #math.* — min, max, abs, floor,
            round, and related numeric utilities.
      </documentation>
      <capabilities>
        <!--#math.min(a, b) — SCAD: native min(a, b)-->
        <min type="blockml:capability.Transformation" inputType="{ a: blockml:type.Float, b: blockml:type.Float }" outputType="blockml:type.Float">
          <documentation>
            Returns the smaller of two numbers.
            Examples:
            #math.min(3, 5) → 3
            #math.min(size.x, 10) → min(size.x, 10)
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(a: number, b: number): number => Math.min(a, b)]]>
          </implementation>
        </min>
        <!--#math.max(a, b) — SCAD: native max(a, b)-->
        <max type="blockml:capability.Transformation" inputType="{ a: blockml:type.Float, b: blockml:type.Float }" outputType="blockml:type.Float">
          <documentation>
            Returns the larger of two numbers.
            Examples:
            #math.max(3, 5) → 5
            #math.max(size.x, 10) → max(size.x, 10)
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(a: number, b: number): number => Math.max(a, b)]]>
          </implementation>
        </max>
        <!--#math.abs(x) — SCAD: native abs(x)-->
        <abs type="blockml:capability.Transformation" inputType="blockml:type.Float" outputType="blockml:type.Float">
          <documentation>
            Returns the absolute value of x.
            Examples:
            #math.abs(-3) → 3
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: number): number => Math.abs(x)]]>
          </implementation>
        </abs>
        <!--#math.floor(x) — SCAD: native floor(x)-->
        <floor type="blockml:capability.Transformation" inputType="blockml:type.Float" outputType="blockml:type.Integer">
          <documentation>
            Rounds x down to the nearest integer.
            Examples:
            #math.floor(3.7) → 3
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: number): number => Math.floor(x)]]>
          </implementation>
        </floor>
        <!--#math.ceil(x) — SCAD: native ceil(x)-->
        <ceil type="blockml:capability.Transformation" inputType="blockml:type.Float" outputType="blockml:type.Integer">
          <documentation>
            Rounds x up to the nearest integer.
            Examples:
            #math.ceil(3.2) → 4
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: number): number => Math.ceil(x)]]>
          </implementation>
        </ceil>
        <!--#math.round(x) — SCAD: native round(x)-->
        <round type="blockml:capability.Transformation" inputType="blockml:type.Float" outputType="blockml:type.Integer">
          <documentation>
            Rounds x to the nearest integer.
            Examples:
            #math.round(3.4) → 3
            #math.round(3.6) → 4
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: number): number => Math.round(x)]]>
          </implementation>
        </round>
        <!--#math.round_n(x, n) — SCAD: round(x * pow(10, n)) / pow(10, n)-->
        <round_n type="blockml:capability.Transformation" inputType="{ x: blockml:type.Float, n: blockml:type.Integer }" outputType="blockml:type.Float">
          <documentation>
            Rounds x to n decimal places.
            Examples:
            #math.round_n(3.14159, 2) → 3.14
            #math.round_n(0.1 + 0.2, 1) → 0.3
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (x: number, n: number): number =>
                Math.round(x * Math.pow(10, n)) / Math.pow(10, n)
            ]]>
          </implementation>
        </round_n>
        <!--#math.pow(base, exp) — SCAD: native pow(base, exp)-->
        <pow type="blockml:capability.Transformation" inputType="{ base: blockml:type.Float, exp: blockml:type.Float }" outputType="blockml:type.Float">
          <documentation>
            Returns base raised to the power of exp.
            Examples:
            #math.pow(2, 10) → 1024
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(base: number, exp: number): number => Math.pow(base, exp)]]>
          </implementation>
        </pow>
        <!--#math.sqrt(x) — SCAD: native sqrt(x)-->
        <sqrt type="blockml:capability.Transformation" inputType="blockml:type.Float" outputType="blockml:type.Float">
          <documentation>
            Returns the square root of x.
            Examples:
            #math.sqrt(9) → 3
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(x: number): number => Math.sqrt(x)]]>
          </implementation>
        </sqrt>
        <!--#math.clamp(x, lo, hi) — SCAD: min(max(x, lo), hi)-->
        <clamp type="blockml:capability.Transformation" inputType="{ x: blockml:type.Float, lo: blockml:type.Float, hi: blockml:type.Float }" outputType="blockml:type.Float">
          <documentation>
            Clamps x to the range [lo, hi].
            Examples:
            #math.clamp(5, 0, 3) → 3
            #math.clamp(-1, 0, 1) → 0
            #math.clamp(0.5, 0, 1) → 0.5
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (x: number, lo: number, hi: number): number =>
                Math.min(Math.max(x, lo), hi)
            ]]>
          </implementation>
        </clamp>
      </capabilities>
    </block>
    <!--BlockML Core Services

  Name: Numbers Service
  Filename: Numbers.bml
  FQN: org.blockml.bml.service.Numbers
  Expression prefix: #numbers.*-->
    <block>
      <name>
        Numbers
      </name>
      <type>
        blockml:service.Numbers
      </type>
      <baseType>
        blockml:core.Entity
      </baseType>
      <is>
        A number-format expression service
      </is>
      <documentation>
        Built-in numbers service. Expression prefix #numbers.* — sequence,
            formatting, and numeric conversion utilities.
      </documentation>
      <capabilities>
        <!--#numbers.formatDecimal(x, minInt, decPoint, minFrac)
      Formats a number as a decimal string with locale-style rules.
      SCAD: no native — Processor emits custom formatting logic.-->
        <formatDecimal type="blockml:capability.Transformation" inputType="{ x: blockml:type.Float, minInt: blockml:type.Integer, decPoint: blockml:type.Text, minFrac: blockml:type.Integer }" outputType="blockml:type.Text">
          <documentation>
            Formats x as a decimal string.
            minInt: minimum integer digits (0 omits leading zero before decimal point).
            decPoint: decimal separator character (e.g. "." or ",").
            minFrac: minimum fractional digits (also controls rounding).
            Examples:
            #numbers.formatDecimal(0.1, 0, '.', 1) → ".1"
            #numbers.formatDecimal(3.14159, 1, '.', 2) → "3.14"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (x: number, minInt: number, decPoint: string, minFrac: number): string => {
              const rounded = Math.round(x * Math.pow(10, minFrac)) / Math.pow(10, minFrac);
              let s = rounded.toFixed(minFrac);
              if (minInt === 0 && s.startsWith('0.')) s = s.slice(1);
              if (minInt === 0 && s.startsWith('-0.')) s = '-' + s.slice(2);
              return decPoint === '.' ? s : s.replace('.', decPoint);
            }
            ]]>
          </implementation>
        </formatDecimal>
      </capabilities>
    </block>
    <!--BlockML Core Services

  Name: Strings Service
  Filename: Strings.bml
  FQN: org.blockml.bml.service.Strings
  Expression prefix: #strings.*-->
    <block>
      <name>
        Strings
      </name>
      <type>
        blockml:service.Strings
      </type>
      <baseType>
        blockml:core.Entity
      </baseType>
      <is>
        A text expression service
      </is>
      <documentation>
        Built-in strings service. Expression prefix #strings.* — concat, length,
            substring, and related text utilities.
      </documentation>
      <capabilities>
        <!--#strings.trim(s)-->
        <trim type="blockml:capability.Transformation" inputType="blockml:type.Text" outputType="blockml:type.Text">
          <documentation>
            Removes leading and trailing whitespace from s.
            Examples:
            #strings.trim(' hello ') → "hello"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string): string => s.trim()]]>
          </implementation>
        </trim>
        <!--#strings.toUpperCase(s)-->
        <toUpperCase type="blockml:capability.Transformation" inputType="blockml:type.Text" outputType="blockml:type.Text">
          <documentation>
            Converts s to uppercase.
            Examples:
            #strings.toUpperCase('abc') → "ABC"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string): string => s.toUpperCase()]]>
          </implementation>
        </toUpperCase>
        <!--#strings.toLowerCase(s)-->
        <toLowerCase type="blockml:capability.Transformation" inputType="blockml:type.Text" outputType="blockml:type.Text">
          <documentation>
            Converts s to lowercase.
            Examples:
            #strings.toLowerCase('ABC') → "abc"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string): string => s.toLowerCase()]]>
          </implementation>
        </toLowerCase>
        <!--#strings.concat(a, b, ...)-->
        <concat type="blockml:capability.Transformation" inputType="blockml:type.Text[]" outputType="blockml:type.Text">
          <documentation>
            Concatenates all string arguments.
            Examples:
            #strings.concat('a', 'b', 'c') → "abc"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(...parts: string[]): string => parts.join('')]]>
          </implementation>
        </concat>
        <!--#strings.length(s)-->
        <length type="blockml:capability.Transformation" inputType="blockml:type.Text" outputType="blockml:type.Integer">
          <documentation>
            Returns the length of s.
            Examples:
            #strings.length('hello') → 5
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string): number => s.length]]>
          </implementation>
        </length>
        <!--#strings.contains(s, fragment)-->
        <contains type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, fragment: blockml:type.Text }" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if s contains fragment.
            Examples:
            #strings.contains('hello', 'ell') → true
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string, fragment: string): boolean => s.includes(fragment)]]>
          </implementation>
        </contains>
        <!--#strings.startsWith(s, prefix)-->
        <startsWith type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, prefix: blockml:type.Text }" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if s starts with prefix.
            Examples:
            #strings.startsWith('hello', 'he') → true
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string, prefix: string): boolean => s.startsWith(prefix)]]>
          </implementation>
        </startsWith>
        <!--#strings.endsWith(s, suffix)-->
        <endsWith type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, suffix: blockml:type.Text }" outputType="blockml:type.Boolean">
          <documentation>
            Returns true if s ends with suffix.
            Examples:
            #strings.endsWith('hello', 'lo') → true
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string, suffix: string): boolean => s.endsWith(suffix)]]>
          </implementation>
        </endsWith>
        <!--#strings.indexOf(s, fragment)-->
        <indexOf type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, fragment: blockml:type.Text }" outputType="blockml:type.Integer">
          <documentation>
            Returns the index of fragment in s, or -1 if not found.
            Examples:
            #strings.indexOf('hello', 'll') → 2
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string, fragment: string): number => s.indexOf(fragment)]]>
          </implementation>
        </indexOf>
        <!--#strings.substring(s, start, end)-->
        <substring type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, start: blockml:type.Integer, end: blockml:type.Integer }" outputType="blockml:type.Text">
          <documentation>
            Returns the substring of s from start (inclusive) to end (exclusive).
            Examples:
            #strings.substring('hello', 1, 4) → "ell"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[(s: string, start: number, end: number): string => s.substring(start, end)]]>
          </implementation>
        </substring>
        <!--#strings.replace(s, target, replacement)-->
        <replace type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, target: blockml:type.Text, replacement: blockml:type.Text }" outputType="blockml:type.Text">
          <documentation>
            Replaces the first occurrence of target in s with replacement.
            Examples:
            #strings.replace('a-b-c', '-', '_') → "a_b-c"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (s: string, target: string, replacement: string): string =>
                s.replace(target, replacement)
            ]]>
          </implementation>
        </replace>
        <!--#strings.replaceAll(s, target, replacement)-->
        <replaceAll type="blockml:capability.Transformation" inputType="{ s: blockml:type.Text, target: blockml:type.Text, replacement: blockml:type.Text }" outputType="blockml:type.Text">
          <documentation>
            Replaces all occurrences of target in s with replacement.
            Examples:
            #strings.replaceAll('a-b-c', '-', '_') → "a_b_c"
          </documentation>
          <implementation language="blockml:language.TypeScript">
            <![CDATA[
            (s: string, target: string, replacement: string): string =>
                s.split(target).join(replacement)
            ]]>
          </implementation>
        </replaceAll>
      </capabilities>
    </block>
