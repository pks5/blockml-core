    <!--BlockML Constraint — aggregation structural constraint branch

  FQN: org.blockml.bml.constraint.AggregationConstraint-->
    <block>
      <name>
        AggregationConstraint
      </name>
      <type>
        blockml:constraint.AggregationConstraint
      </type>
      <baseType>
        blockml:constraint.MemberConstraint
      </baseType>
      <is>
        A rule for Aggregation members
      </is>
      <documentation>
        Abstract branch for constraints on Aggregation members. Generic T binds to the
            effective AggregationDefinition. Valid only under an Aggregation's &lt;constraints> container
            (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
      </documentation>
      <abstract>
        true
      </abstract>
      <genericTypes>
        <T baseType="blockml:definition.AggregationDefinition" />
      </genericTypes>
    </block>
    <!--BlockML Core — allowed child type aggregation constraint

  FQN: org.blockml.bml.constraint.AllowedChildType-->
    <block>
      <name>
        AllowedChildType
      </name>
      <type>
        blockml:constraint.AllowedChildType
      </type>
      <baseType>
        blockml:constraint.AggregationConstraint
      </baseType>
      <is>
        A rule for allowed child types
      </is>
      <documentation>
        Aggregation-level structural constraint. T binds to the effective
            AggregationDefinition. When validation is set, each composition child under the aggregation must
            resolve to the given Block type FQN. Reference implementation for AggregationConstraint branch.
      </documentation>
      <genericTypes>
        <T baseType="blockml:definition.AggregationDefinition" />
      </genericTypes>
      <properties>
        <type type="blockml:type.TypeReference(blockml:core.Block)">
          <documentation>
            Allowed Block type FQN for composition children.
          </documentation>
        </type>
      </properties>
    </block>
    <!--BlockML Constraint — association structural constraint branch

  FQN: org.blockml.bml.constraint.AssociationConstraint-->
    <block>
      <name>
        AssociationConstraint
      </name>
      <type>
        blockml:constraint.AssociationConstraint
      </type>
      <baseType>
        blockml:constraint.MemberConstraint
      </baseType>
      <is>
        A rule for Association members
      </is>
      <documentation>
        Abstract branch for constraints on Association members. Generic T binds to the
            effective AssociationDefinition. Valid only under an Association's &lt;constraints> container
            (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
      </documentation>
      <abstract>
        true
      </abstract>
      <genericTypes>
        <T baseType="blockml:definition.AssociationDefinition" />
      </genericTypes>
    </block>
    <!--BlockML Constraint — block-level structural constraint branch

  FQN: org.blockml.bml.constraint.BlockConstraint-->
    <block>
      <name>
        BlockConstraint
      </name>
      <type>
        blockml:constraint.BlockConstraint
      </type>
      <baseType>
        blockml:constraint.StructuralConstraint
      </baseType>
      <is>
        A rule for a whole Block
      </is>
      <documentation>
        Abstract branch for Block-level structural constraints. May express cross-member
            rules (RequiresMember, MutuallyExclusive, …). Generic T binds to the effective
            org.blockml.bml.definition.BlockDefinition type of the enclosing Block (including
            SubBlockDefinition, RootBlockDefinition, and EmbeddedBlockDefinition subtypes). Valid only under a Block's
            &lt;constraints> container (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
      </documentation>
      <abstract>
        true
      </abstract>
      <genericTypes>
        <T baseType="blockml:definition.BlockDefinition" />
      </genericTypes>
    </block>
    <!--BlockML Constraint — capability structural constraint branch

  FQN: org.blockml.bml.constraint.CapabilityConstraint-->
    <block>
      <name>
        CapabilityConstraint
      </name>
      <type>
        blockml:constraint.CapabilityConstraint
      </type>
      <baseType>
        blockml:constraint.MemberConstraint
      </baseType>
      <is>
        A rule for a Capability
      </is>
      <documentation>
        Abstract branch for constraints on Capability members. Generic T binds to the
            effective CapabilityDefinition. Valid only under a Capability's &lt;constraints> container
            (BML_CONSTRAINT_TARGET_MISMATCH otherwise).
      </documentation>
      <abstract>
        true
      </abstract>
      <genericTypes>
        <T baseType="blockml:definition.CapabilityDefinition" />
      </genericTypes>
    </block>
    <!--BlockML Core — maximum value constraint

  FQN: org.blockml.bml.constraint.Max-->
    <block>
      <name>
        Max
      </name>
      <type>
        blockml:constraint.Max
      </type>
      <baseType>
        blockml:constraint.ValueConstraint
      </baseType>
      <is>
        An upper bound on a number
      </is>
      <documentation>
        Scalar constraint: T binds to the property type. Compatible with Integer, Float,
            and Decimal properties. The value property must match T.
      </documentation>
      <genericTypes>
        <T baseType="blockml:type.Number" />
      </genericTypes>
      <properties>
        <value type="T">
          <documentation>
            Maximum allowed value (inclusive).
          </documentation>
        </value>
      </properties>
    </block>
    <!--BlockML Core — maximum items constraint

  FQN: org.blockml.bml.constraint.MaxItems-->
    <block>
      <name>
        MaxItems
      </name>
      <type>
        blockml:constraint.MaxItems
      </type>
      <baseType>
        blockml:constraint.ValueConstraint
      </baseType>
      <is>
        An upper bound on item count
      </is>
      <documentation>
        T binds to the property collection type (e.g. String[]). The value property is Integer — the maximum item count.
      </documentation>
      <genericTypes>
        <T baseType="blockml:core.ValueType" />
      </genericTypes>
      <properties>
        <value type="blockml:type.Integer">
          <documentation>
            Maximum number of items (inclusive).
          </documentation>
        </value>
      </properties>
    </block>
    <!--BlockML Core — maximum length constraint

  FQN: org.blockml.bml.constraint.MaxLength-->
    <block>
      <name>
        MaxLength
      </name>
      <type>
        blockml:constraint.MaxLength
      </type>
      <baseType>
        blockml:constraint.ValueConstraint
      </baseType>
      <is>
        An upper bound on length
      </is>
      <documentation>
        T binds to the property type for scalar String properties, or to the element type when the property is a collection (e.g. String[]). The value property is always Integer — the maximum length threshold.
      </documentation>
      <genericTypes>
        <T baseType="blockml:core.ValueType" />
      </genericTypes>
      <properties>
        <value type="blockml:type.Integer">
          <documentation>
            Maximum length (inclusive).
          </documentation>
        </value>
      </properties>
    </block>
    <!--BlockML Constraint — member structural constraint branch

  FQN: org.blockml.bml.constraint.MemberConstraint-->
    <block>
      <name>
        MemberConstraint
      </name>
      <type>
        blockml:constraint.MemberConstraint
      </type>
      <baseType>
        blockml:constraint.StructuralConstraint
      </baseType>
      <is>
        A rule for a Block member
      </is>
      <documentation>
        Abstract branch for member-level structural constraints. Generic T binds to the
            effective MemberDefinition subtype of the embedding context. Specialized by PropertyConstraint,
            AggregationConstraint, AssociationConstraint, and CapabilityConstraint.
      </documentation>
      <abstract>
        true
      </abstract>
      <genericTypes>
        <T baseType="blockml:definition.MemberDefinition" />
      </genericTypes>
    </block>
