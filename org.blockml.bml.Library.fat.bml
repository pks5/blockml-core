    <!--BlockML Core — stub status

  FQN: org.blockml.bml.status.Stub-->
    <block>
      <name>
        Stub
      </name>
      <type>
        blockml:status.Stub
      </type>
      <baseType>
        blockml:core.Status
      </baseType>
      <is>
        A placeholder-only Status
      </is>
      <documentation>
        Structural placeholder only. Documents intent or reserves a member slot without
            committing to behaviour, types, or mapping. Stronger signal than Draft for incomplete ideas.
            Toolchain: Stage 2 validation accepts Stub; each Render Target may emit stubs (e.g. empty
            methods with logs), omit, or abort — policy is target-specific.
      </documentation>
    </block>
    <!--BlockML Core — add constraint task

  FQN: org.blockml.bml.task.AddConstraint-->
    <block>
      <name>
        AddConstraint
      </name>
      <type>
        blockml:task.AddConstraint
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for attaching Constraints
      </is>
      <summary>
        Declare a constraints container on a ConstrainableDefinition element and add a Constraint
            reference as a direct child. The embedding context binds the constraint target automatically —
            no target property in BML.
      </summary>
      <documentation>
        Procedure for adding a constraint:
        1. Confirm the definition element extends ConstrainableDefinition (Block or member).
        2. Add a constraints container if absent.
        3. Insert a Constraint Block reference (element name = FQN via xmlns prefix).
        4. Optionally attach a validation reference on the constraint instance for rule enforcement.
        5. Run the validator — BML_CONSTRAINT_TARGET_MISMATCH when branch compatibility fails.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="constraint" />
        <blockml:meta.FreeTextKeyword term="validation" />
        <blockml:meta.FreeTextKeyword term="Min" />
        <blockml:meta.FreeTextKeyword term="Max" />
        <blockml:meta.FreeTextKeyword term="Pattern" />
        <blockml:meta.FreeTextKeyword term="member constraint" />
      </keywords>
      <references>
        <see type="blockml:documentation.DefinitionModel" relation="Prerequisite">
          Understand member containers and definition metadata first.
        </see>
        <see type="blockml:definition.ConstrainableDefinition" relation="TaskStep">
          Step 1 — confirm the target element supports a constraints container.
        </see>
        <see type="blockml:documentation.ConstraintsModel" relation="TaskStep">
          Step 2 — choose constraint branch and target binding rules.
        </see>
        <see type="blockml:constraint.Min" relation="TaskStep">
          Step 3 — pick a concrete constraint block (Min, Max, Pattern, RequiresMember, …).
        </see>
        <see type="blockml:core.Validation" relation="TaskStep">
          Step 4 — optionally wire validation for enforced rules.
        </see>
      </references>
    </block>
    <!--BlockML Core — author new block task

  FQN: org.blockml.bml.task.AuthorNewBlock-->
    <block>
      <name>
        AuthorNewBlock
      </name>
      <type>
        blockml:task.AuthorNewBlock
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for authoring a new Block
      </is>
      <summary>
        Create a root .bml file with is, documentation, type, baseType, version, and member
            containers as needed. Register the block FQN in Library blocks when publishing a library
            catalogue.
      </summary>
      <documentation>
        Procedure for a new domain Block type:
        1. Choose baseType from the framework or domain branch.
        2. Declare identity and documentation metadata (is, documentation, optional summary).
        3. Add properties, aggregations, associations, or capabilities.
        4. Add constraints, capabilities, and examples as needed.
        5. Export via Library.bml blocks when the type belongs to a published catalogue.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="author" />
        <blockml:meta.FreeTextKeyword term="new block" />
        <blockml:meta.FreeTextKeyword term="create type" />
        <blockml:meta.FreeTextKeyword term="scaffold" />
        <blockml:meta.FreeTextKeyword term="root block" />
      </keywords>
      <references>
        <see type="blockml:documentation.DefinitionModel" relation="Prerequisite">
          Understand is, members, and documentation extensions before authoring.
        </see>
        <see type="blockml:definition.RootBlockDefinition" relation="TaskStep">
          Step 1 — inspect the root block definition meta-model shape.
        </see>
        <see type="blockml:documentation.DocumentationModel" relation="TaskStep">
          Step 2 — identity order, is, documentation, type references.
        </see>
        <see type="blockml:core.Block" relation="TaskStep">
          Step 3 — pick baseType and declare member containers.
        </see>
        <see type="blockml:documentation.ModelingGuidelines" relation="TaskStep">
          Step 4 — choose baseType vs contracts and model members consistently.
        </see>
        <see type="blockml:Library" relation="TaskStep">
          Step 5 — add the block FQN to Library blocks for export.
        </see>
      </references>
    </block>
    <!--BlockML Core — debug unknown type task

  FQN: org.blockml.bml.task.DebugUnknownType-->
    <block>
      <name>
        DebugUnknownType
      </name>
      <type>
        blockml:task.DebugUnknownType
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing unknown types
      </is>
      <summary>
        Verify FQN spelling, xmlns prefix resolution, Library blocks membership, and bootstrap
            load order so the referenced type is registered in TypeRegistry before validation.
      </summary>
      <documentation>
        Procedure when the validator reports BML_UNKNOWN_TYPE:
        1. Locate the failing type reference site (type, baseType, member type, contract, language).
        2. Confirm the expanded FQN matches a registered BlockDefinition.
        3. Check xmlns prefix maps to the intended namespace on this document.
        4. Confirm the defining block is listed in Library blocks when loaded via a library.
        5. Verify dependency libraries and bootstrap order load the defining catalogue first.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="BML_UNKNOWN_TYPE" />
        <blockml:meta.FreeTextKeyword term="unknown type" />
        <blockml:meta.FreeTextKeyword term="unresolved FQN" />
        <blockml:meta.FreeTextKeyword term="TypeRegistry" />
        <blockml:meta.FreeTextKeyword term="bootstrap" />
      </keywords>
      <references>
        <see type="blockml:diagnostic.BML_UNKNOWN_TYPE" relation="SeeAlso">
          Diagnostic block for this error code — entry point from validator output.
        </see>
        <see type="blockml:documentation.ImplicitNamespaceResolution" relation="TaskStep">
          Step 1 — verify xmlns prefix and implicit namespace resolution at the reference site.
        </see>
        <see type="blockml:documentation.LibrarySystem" relation="TaskStep">
          Step 2 — confirm Library blocks exports the defining type.
        </see>
        <see type="blockml:documentation.TypeIdentityDerivation" relation="TaskStep">
          Step 3 — check type reference forms (FQN, QName, Sub-Block-relative, nested resolution).
        </see>
        <see type="blockml:documentation.BootstrapModel" relation="TaskStep">
          Step 4 — confirm TypeRegistry bootstrap loaded dependencies before this document.
        </see>
        <see type="blockml:task.FixTypeIdentity" relation="SeeAlso">
          Related — identity mismatches when the type exists but the form is wrong.
        </see>
      </references>
    </block>
    <!--BlockML Core — fix composition placement task

  FQN: org.blockml.bml.task.FixCompositionPlacement-->
    <block>
      <name>
        FixCompositionPlacement
      </name>
      <type>
        blockml:task.FixCompositionPlacement
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing composition placement
      </is>
      <summary>
        Resolve standalone composition errors and clarify definition vs instance aggregation
            fill, including bml:container and bml:with usage.
      </summary>
      <documentation>
        Procedure when composition placement fails validation:
        1. On Block definitions — nest &lt;composition> inside an aggregation member element; never
           leave it standalone (BML_STANDALONE_COMPOSITION).
        2. On Block instances — open aggregations by member name directly; no composition wrapper.
           Same rule as Properties: do not wrap instance values in &lt;value> (doc:MemberAuthoring).
        3. Inherited aggregation fill — use override="true"; omit unchanged type.
        4. Shared sibling values — bml:with on composition or bml:container (see doc:BmlDirectives).
        5. Instance ID reachability — follows aggregation member visibility (doc:MemberVisibility).
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="composition" />
        <blockml:meta.FreeTextKeyword term="aggregation" />
        <blockml:meta.FreeTextKeyword term="BML_STANDALONE_COMPOSITION" />
        <blockml:meta.FreeTextKeyword term="bml:container" />
      </keywords>
      <references>
        <see type="blockml:documentation.MemberAuthoring" relation="TaskStep">
          Step 0 — definition fields vs instance payloads for Properties and Aggregations.
        </see>
        <see type="blockml:documentation.CompositionModel" relation="TaskStep">
          Step 1 — unified container concept and placement rules.
        </see>
        <see type="blockml:documentation.BmlDirectives" relation="TaskStep">
          Step 2 — bml:container, bml:with, bml:each on composition.
        </see>
        <see type="blockml:documentation.PartialMemberOverrides" relation="TaskStep">
          Step 3 — inherited aggregation overrides.
        </see>
        <see type="blockml:diagnostic.BML_STANDALONE_COMPOSITION" relation="SeeAlso">
          Diagnostic for composition outside an aggregation member.
        </see>
      </references>
    </block>
    <!--BlockML Core — fix expression errors task

  FQN: org.blockml.bml.task.FixExpressionErrors-->
    <block>
      <name>
        FixExpressionErrors
      </name>
      <type>
        blockml:task.FixExpressionErrors
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing expression errors
      </is>
      <summary>
        Resolve ${ } and &lt;$ $> expression diagnostics — syntax, unknown refs, type/payload
            mismatches, linking, and model context.
      </summary>
      <documentation>
        Procedure when an expression-related BML_EXPR_* (or embed) diagnostic is reported:
        1. Confirm host context — member ${ } vs implementation &lt;$ $> (doc:EmbeddedExpressions).
        2. Syntax errors — check delimiters, quotes, operators; embeds must not nest &lt;$ $>.
        3. Unknown property — verify member exists in scope; StructType fields by name only (not [0]).
        4. Unknown bean / builtin — declare bml:bean Aggregation or use a V1 #built-in.
        5. Type / payload mismatch — align expression result with member type; map call args via
           FunctionMapping (doc:FunctionMappingModel).
        6. Linking (@bean.capa without parens) — source Outbound, target Inbound, compatible payloads.
        7. Relative @model: — ensure a parent Aggregation established binding context.
        8. V1 — avoid deferred @bean execution / model / linking features until implemented.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="expression" />
        <blockml:meta.FreeTextKeyword term="BML_EXPR_SYNTAX_ERROR" />
        <blockml:meta.FreeTextKeyword term="bean" />
        <blockml:meta.FreeTextKeyword term="built-in" />
        <blockml:meta.FreeTextKeyword term="embedded" />
      </keywords>
      <references>
        <see type="blockml:documentation.Expressions" relation="TaskStep">
          Step 1 — ${ } language, scope, V1 support.
        </see>
        <see type="blockml:documentation.EmbeddedExpressions" relation="TaskStep">
          Step 2 — implementation embeds and delimiter rules.
        </see>
        <see type="blockml:documentation.FunctionMappingModel" relation="TaskStep">
          Step 3 — call argument mapping diagnostics.
        </see>
        <see type="blockml:documentation.BmlDirectives" relation="TaskStep">
          Step 4 — each/with variable scopes.
        </see>
        <see type="blockml:diagnostic.BML_EXPR_SYNTAX_ERROR" relation="SeeAlso">
          Parse failure diagnostic.
        </see>
        <see type="blockml:diagnostic.BML_EXPR_UNKNOWN_PROPERTY" relation="SeeAlso">
          Unknown property / invalid struct index access.
        </see>
      </references>
    </block>
    <!--BlockML Core — fix member override task

  FQN: org.blockml.bml.task.FixMemberOverride-->
    <block>
      <name>
        FixMemberOverride
      </name>
      <type>
        blockml:task.FixMemberOverride
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing member override errors
      </is>
      <summary>
        Resolve override-required / without-parent, abstract-not-implemented, final override,
            readOnly instance writes, and redundant aggregation type warnings.
      </summary>
      <documentation>
        Procedure when the validator reports an override/merge-related BML_* code:
        1. Determine whether the local member is new or merges with baseType/contracts identity
           (resolvedNamespace + normalizedLogicalName).
        2. Merging redeclaration → set override="true" on every layer (including contract completion).
        3. New member → do not set override="true".
        4. Abstract obligation on a concrete Block → complete locally (type/value/implementation) with
           override="true", or keep abstract="true" on the redeclaration.
        5. final or private parent → do not override; change modeling approach.
        6. readOnly → set values on definitions/overrides only, not on Block instances.
        7. Aggregation fill-only override → omit unchanged type (BML_REDUNDANT_AGGREGATION_TYPE).
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="override" />
        <blockml:meta.FreeTextKeyword term="abstract" />
        <blockml:meta.FreeTextKeyword term="final" />
        <blockml:meta.FreeTextKeyword term="readOnly" />
        <blockml:meta.FreeTextKeyword term="BML_OVERRIDE_REQUIRED" />
      </keywords>
      <references>
        <see type="blockml:documentation.PartialMemberOverrides" relation="TaskStep">
          Step 1 — merge semantics and abstract/final/override.
        </see>
        <see type="blockml:documentation.ContractsModel" relation="TaskStep">
          Step 2 — contract member completion requires override.
        </see>
        <see type="blockml:documentation.MemberVisibility" relation="TaskStep">
          Step 3 — private/final interaction with overrides.
        </see>
        <see type="blockml:diagnostic.BML_OVERRIDE_REQUIRED" relation="SeeAlso">
          Example diagnostic resolved by this task.
        </see>
        <see type="blockml:diagnostic.BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED" relation="SeeAlso">
          Abstract obligation on concrete Block.
        </see>
      </references>
    </block>
    <!--BlockML Core — fix type identity task

  FQN: org.blockml.bml.task.FixTypeIdentity-->
    <block>
      <name>
        FixTypeIdentity
      </name>
      <type>
        blockml:task.FixTypeIdentity
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing type identity errors
      </is>
      <summary>
        Resolve root/Sub-Block/embedded identity mismatches, ambiguous or unqualified references,
            and definition-role errors.
      </summary>
      <documentation>
        Procedure when type identity or reference resolution fails:
        1. Classify the Block role — root, Sub-Block, or embedded virtual file.
        2. Root — require type; optional name must equal lastSegment(resolve(type)).
        3. Sub-Block — require name; omit type or match parentType + "." + name from the immediate
           enclosing block; never declare embeddedBlocks.
        4. Embedded — require fully qualified type; FQN is not nested under the root; no nested embeds.
        5. Unqualified names — use nested resolution (innermost first) or context-bound implicit
           namespace; grandchildren need a relative path; otherwise qualify with xmlns/FQN.
        6. Ambiguous short Sub-Block names that match the root — rename or use qualified references.
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="type identity" />
        <blockml:meta.FreeTextKeyword term="Sub-Block" />
        <blockml:meta.FreeTextKeyword term="embedded" />
        <blockml:meta.FreeTextKeyword term="BML_SUBBLOCK_TYPE_MISMATCH" />
        <blockml:meta.FreeTextKeyword term="BML_AMBIGUOUS_TYPE" />
      </keywords>
      <references>
        <see type="blockml:documentation.TypeIdentityDerivation" relation="TaskStep">
          Step 1 — four reference forms and canonical derivation summary.
        </see>
        <see type="blockml:documentation.SubBlockModel" relation="TaskStep">
          Step 2 — Sub-Block vs Embedded vs Root rules.
        </see>
        <see type="blockml:documentation.ImplicitNamespaceResolution" relation="TaskStep">
          Step 3 — context-bound unqualified sites.
        </see>
        <see type="blockml:documentation.BlockNameConvention" relation="TaskStep">
          Step 4 — PascalCase name format.
        </see>
        <see type="blockml:diagnostic.BML_SUBBLOCK_TYPE_MISMATCH" relation="SeeAlso">
          Example Sub-Block identity diagnostic.
        </see>
        <see type="blockml:diagnostic.BML_AMBIGUOUS_TYPE" relation="SeeAlso">
          Ambiguous unqualified type name.
        </see>
        <see type="blockml:task.DebugUnknownType" relation="SeeAlso">
          Related task when the type is simply not registered.
        </see>
      </references>
    </block>
    <!--BlockML Core — fix visibility access task

  FQN: org.blockml.bml.task.FixVisibilityAccess-->
    <block>
      <name>
        FixVisibilityAccess
      </name>
      <type>
        blockml:task.FixVisibilityAccess
      </type>
      <baseType>
        blockml:core.TaskGuide
      </baseType>
      <is>
        A how-to for fixing visibility errors
      </is>
      <summary>
        Resolve private/protected member or Sub-Block access errors, visibility mismatches,
            narrowing on override, and duplicate visibility-prefix variants.
      </summary>
      <documentation>
        Procedure when the validator reports a visibility-related BML_* code:
        1. Identify whether the site is a member or a Sub-Block (same naming convention).
        2. Confirm the intended visibility via name prefix: public / _protected / __private.
        3. For access errors — move the use into an allowed context (declaring Block, inheritance,
           immediate composition owner for protected) or widen the declaration if appropriate.
        4. For override narrowing — keep or widen visibility; never narrow; private cannot be overridden.
        5. For duplicate variants — keep exactly one normalizedLogicalName with one visibility.
        6. For root-level &lt;visibility> on a root Block — remove it (Sub-Blocks only).
      </documentation>
      <keywords>
        <blockml:meta.FreeTextKeyword term="visibility" />
        <blockml:meta.FreeTextKeyword term="private" />
        <blockml:meta.FreeTextKeyword term="protected" />
        <blockml:meta.FreeTextKeyword term="BML_PRIVATE_MEMBER_ACCESS" />
        <blockml:meta.FreeTextKeyword term="BML_VISIBILITY_NARROWING" />
      </keywords>
      <references>
        <see type="blockml:documentation.MemberVisibility" relation="TaskStep">
          Step 1 — member access rules and formal D/C/I/O table.
        </see>
        <see type="blockml:documentation.SubBlockModel" relation="TaskStep">
          Step 2 — Sub-Block visibility and reference scope.
        </see>
        <see type="blockml:documentation.PartialMemberOverrides" relation="TaskStep">
          Step 3 — visibility widening on override.
        </see>
        <see type="blockml:diagnostic.BML_PRIVATE_MEMBER_ACCESS" relation="SeeAlso">
          Example diagnostic resolved by this task.
        </see>
        <see type="blockml:diagnostic.BML_VISIBILITY_NARROWING" relation="SeeAlso">
          Narrowing on override.
        </see>
      </references>
    </block>
